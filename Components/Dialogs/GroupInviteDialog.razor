@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject GroupNotificationService GroupNotifSvc

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Mitglied einladen</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Style="color:#A3A3A3; margin-bottom:16px; line-height:1.6;">
            Gib die E-Mail-Adresse der Person ein. Es können nur Personen eingeladen werden, die bereits ein Konto haben.
        </MudText>

        <div style="position:relative;">
            <MudTextField T="string" Label="E-Mail-Adresse *" @bind-Value="_email"
                          Variant="Variant.Outlined" InputType="InputType.Email"
                          Placeholder="name@beispiel.de"
                          Immediate="true"
                          DebounceInterval="400"
                          OnDebounceIntervalElapsed="OnEmailDebounceAsync"
                          Adornment="@(_emailChecked ? (_emailValid ? Adornment.End : Adornment.End) : Adornment.None)"
                          AdornmentIcon="@(_emailValid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                          AdornmentColor="@(_emailValid ? Color.Success : Color.Error)"
                          Style="@(_emailChecked ? $"--mud-palette-outlined-border:{ (_emailValid ? "#69bb6a" : "#ef5350")};" : "")" />
        </div>

        @if (_emailChecked && !string.IsNullOrWhiteSpace(_email))
        {
            @if (_emailValid)
            {
                <div style="display:flex;align-items:center;gap:6px;margin-top:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#66BB6A;font-size:15px;" />
                    <MudText Typo="Typo.caption" Class="bt-text-success">
                        E-Mail-Adresse gültig – @_validUserName ist einladbar.
                    </MudText>
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center;gap:6px;margin-top:6px;">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Style="color:#EF5350;font-size:15px;" />
                    <MudText Typo="Typo.caption" Class="bt-text-error">@_emailHint</MudText>
                </div>
            }
        }
        else if (_checking)
        {
            <div style="display:flex;align-items:center;gap:6px;margin-top:6px;">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px;" />
                <MudText Typo="Typo.caption" Class="bt-text-muted">Prüfe E-Mail-Adresse...</MudText>
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <MudAlert Severity="@_messageSeverity" Class="mt-3">@_message</MudAlert>
        }

        @if (_existingInvitations.Count > 0)
        {
            <div style="margin-top:16px;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.1em; font-weight:800;">
                    Offene Einladungen
                </MudText>
                @foreach (var inv in _existingInvitations)
                {
                    var invLocal = inv;
                    <div style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid #404040;">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="bt-text-muted" />
                        <MudText Typo="Typo.body2" Style="flex:1; color:#F5F5F5;">@inv.InviteeEmail</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Ausstehend</MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Error" Title="Einladung zurückziehen"
                                       OnClick="() => WithdrawInvitationAsync(invLocal)" />
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SendInviteAsync"
                   Disabled="_saving || !_emailValid"
                   StartIcon="@Icons.Material.Filled.Send">
            @(_saving ? "Senden..." : "Einladung senden")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int GroupId { get; set; }
    [Parameter] public int CurrentUserId { get; set; }

    private string _email = "";
    private bool _saving;
    private bool _checking;
    private bool _emailChecked;
    private bool _emailValid;
    private string _emailHint = "";
    private string _validUserName = "";
    private int? _validUserId;
    private string _message = "";
    private Severity _messageSeverity = Severity.Info;
    private List<GroupInvitation> _existingInvitations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingAsync();
    }

    private async Task LoadExistingAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _existingInvitations = await db.GroupInvitations
            .Where(i => i.GroupId == GroupId && i.Status == InvitationStatus.Pending)
            .OrderByDescending(i => i.CreatedAt)
            .ToListAsync();
    }

    private async Task OnEmailDebounceAsync(string value)
    {
        _email = value;
        _emailChecked = false;
        _emailValid = false;
        _emailHint = "";
        _validUserName = "";
        _validUserId = null;

        if (string.IsNullOrWhiteSpace(value)) { StateHasChanged(); return; }

        _checking = true;
        StateHasChanged();

        var norm = value.Trim().ToLowerInvariant();
        await using var db = await DbFactory.CreateDbContextAsync();

        // Is the user registered?
        var user = await db.Users.FirstOrDefaultAsync(u => u.Username == norm);
        if (user == null)
        {
            _emailHint = "Kein Konto mit dieser E-Mail gefunden.";
            _emailChecked = true; _checking = false; StateHasChanged(); return;
        }

        // Already a member?
        var isMember = await db.GroupMembers
            .Include(m => m.User)
            .AnyAsync(m => m.GroupId == GroupId && m.User.Username == norm);
        if (isMember)
        {
            _emailHint = "Diese Person ist bereits Mitglied der Gruppe.";
            _emailChecked = true; _checking = false; StateHasChanged(); return;
        }

        // Already invited (pending)?
        var hasPending = await db.GroupInvitations
            .AnyAsync(i => i.GroupId == GroupId && i.InviteeEmail == norm && i.Status == InvitationStatus.Pending);
        if (hasPending)
        {
            _emailHint = "Es wurde bereits eine Einladung an diese E-Mail gesendet.";
            _emailChecked = true; _checking = false; StateHasChanged(); return;
        }

        _emailValid = true;
        _validUserName = $"{user.FirstName} {user.LastName}".Trim();
        if (string.IsNullOrEmpty(_validUserName)) _validUserName = user.Username;
        _validUserId = user.Id;
        _emailChecked = true;
        _checking = false;
        StateHasChanged();
    }

    private async Task SendInviteAsync()
    {
        if (!_emailValid || string.IsNullOrWhiteSpace(_email)) return;

        _saving = true;
        _message = "";

        var emailNorm = _email.Trim().ToLowerInvariant();
        await using var db = await DbFactory.CreateDbContextAsync();

        var invitation = new GroupInvitation
        {
            GroupId = GroupId,
            InvitedByUserId = CurrentUserId,
            InviteeEmail = emailNorm,
            InviteeUserId = _validUserId,
            Status = InvitationStatus.Pending,
            CreatedAt = DateTime.UtcNow
        };

        db.GroupInvitations.Add(invitation);
        await db.SaveChangesAsync();

        if (_validUserId.HasValue)
            await GroupNotifSvc.NotifyUserAsync(_validUserId.Value);

        _message = $"Einladung wurde an {_validUserName} gesendet.";
        _messageSeverity = Severity.Success;
        _email = "";
        _emailChecked = false;
        _emailValid = false;
        _validUserName = "";
        _validUserId = null;
        _saving = false;
        await LoadExistingAsync();
        Snackbar.Add("Einladung gesendet!", Severity.Success);
    }

    private void Cancel() => MudDialog.Close(DialogResult.Ok(false));

    private async Task WithdrawInvitationAsync(GroupInvitation inv)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.GroupInvitations.FindAsync(inv.Id);
        if (entity == null || entity.Status != InvitationStatus.Pending) return;

        entity.Status = InvitationStatus.Declined;
        entity.RespondedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();

        // Remove it from the invitee's bell notification in real-time
        if (inv.InviteeUserId.HasValue)
            await GroupNotifSvc.NotifyUserAsync(inv.InviteeUserId.Value);

        await LoadExistingAsync();
        Snackbar.Add("Einladung zurückgezogen.", Severity.Info);
    }
}
