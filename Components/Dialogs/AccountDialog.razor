@inject IDbContextFactory<AppDbContext> DbFactory

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(ExistingAccount == null ? "Konto hinzufügen" : "Konto bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string" Label="Name *" @bind-Value="_name" Variant="Variant.Outlined"
                              Required="true" MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Kontotyp" @bind-Value="_accountType" Variant="Variant.Outlined">
                    @foreach (var t in _accountTypes) { <MudSelectItem Value="t">@t</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal" Label="Anfangssaldo" @bind-Value="_initialBalance"
                                 Variant="Variant.Outlined" Format="F2" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Währung" @bind-Value="_currency" Variant="Variant.Outlined">
                    @foreach (var c in _commonCurrencies) { <MudSelectItem Value="c">@c</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Farbe" @bind-Value="_colorHex" Variant="Variant.Outlined">
                    @foreach (var (hex, name) in _colorOptions)
                    {
                        <MudSelectItem T="string" Value="@hex">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span style="width:14px;height:14px;border-radius:50%;background:@hex;display:inline-block;flex-shrink:0;"></span>
                                @name
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="_saving">@(_saving ? "Speichern..." : "Speichern")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Account? ExistingAccount { get; set; }

    private static readonly (string Hex, string Name)[] _colorOptions =
    [
        ("#EF5350", "Rot"), ("#EC407A", "Pink"), ("#AB47BC", "Lila"), ("#7E57C2", "Dunkelviolett"),
        ("#14B8A6", "Teal"), ("#26C6DA", "Cyan"), ("#26A69A", "Türkis"), ("#66BB6A", "Grün"),
        ("#D4E157", "Hellgrün"), ("#FFCA28", "Gelb"), ("#FFA726", "Orange"), ("#FF7043", "Dunkelorange"),
        ("#78909C", "Blaugräu"), ("#BDBDBD", "Grau"), ("#A3A3A3", "Schieferblau")
    ];

    private static readonly string[] _commonCurrencies = { "EUR", "USD", "GBP", "CHF", "JPY", "CAD", "AUD", "SEK", "NOK", "DKK" };
    private static readonly string[] _accountTypes = { "Girokonto", "Sparkonto", "Tagesgeldkonto", "Festgeldkonto", "Depot", "Kreditkarte", "Bargeld", "Sonstiges" };

    private string _name = "";
    private string _accountType = "Girokonto";
    private decimal _initialBalance;
    private string _currency = "EUR";
    private string _colorHex = "#14B8A6";
    private bool _saving;

    protected override void OnInitialized()
    {
        if (ExistingAccount != null)
        {
            _name = ExistingAccount.Name;
            _accountType = ExistingAccount.AccountType;
            _initialBalance = ExistingAccount.InitialBalance;
            _currency = ExistingAccount.Currency;
            _colorHex = ExistingAccount.ColorHex;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (ExistingAccount != null)
        {
            var entity = await db.Accounts.FindAsync(ExistingAccount.Id);
            if (entity != null)
            {
                entity.Name = _name.Trim();
                entity.AccountType = _accountType;
                entity.InitialBalance = _initialBalance;
                entity.Currency = _currency;
                entity.ColorHex = _colorHex;
            }
        }
        else
        {
            db.Accounts.Add(new Account
            {
                Name = _name.Trim(),
                AccountType = _accountType,
                InitialBalance = _initialBalance,
                Currency = _currency,
                ColorHex = _colorHex,
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            });
        }

        await db.SaveChangesAsync();
        _saving = false;
        MudDialog.Close(DialogResult.Ok(true));
    }
}
