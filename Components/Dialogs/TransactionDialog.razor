@inject IDbContextFactory<AppDbContext> DbFactory
@inject CurrencyService CurrencyService
@inject AppStateService AppState

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(ExistingTransaction == null ? (IsExpense ? "Ausgabe" : "Einnahme") + " hinzufügen" : "Transaktion bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                @if (AccountId.HasValue)
                {
                    <MudTextField Label="Konto" Value="@(_accounts.FirstOrDefault(a => a.Id == _accountId)?.Name ?? "–")" ReadOnly="true"
                                  Variant="Variant.Outlined" Disabled="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                }
                else
                {
                    <MudSelect T="int" Label="Konto *" @bind-Value="_accountId" Variant="Variant.Outlined" Required="true">
                        @foreach (var a in _accounts) { <MudSelectItem Value="a.Id">@a.Name</MudSelectItem> }
                    </MudSelect>
                }
            </MudItem>
            <MudItem xs="12">
                @if (!HasTypePreset || ExistingTransaction != null)
                {
                    <MudSelect T="TransactionType" Label="Typ *" @bind-Value="_type" Variant="Variant.Outlined">
                        <MudSelectItem Value="TransactionType.Income">Einnahme</MudSelectItem>
                        <MudSelectItem Value="TransactionType.Expense">Ausgabe</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    <MudTextField Label="Typ" Value="@(_type == TransactionType.Income ? "Einnahme" : "Ausgabe")"
                                  ReadOnly="true" Variant="Variant.Outlined" Disabled="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                }
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal" Label="Betrag (EUR) *" @bind-Value="_amount" Variant="Variant.Outlined"
                                 Min="0.01m" Format="F2" Required="true" />
            </MudItem>
            <MudItem xs="8">
                <MudNumericField T="decimal?" Label="Originalbetrag (optional)"
                                 Value="_originalAmount" ValueChanged="OnOriginalAmountChangedAsync"
                                 Variant="Variant.Outlined" Min="0" Format="F2" Immediate="true" />
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="string" Label="Währung" Value="_originalCurrency"
                           ValueChanged="OnOriginalCurrencyChangedAsync" Variant="Variant.Outlined">
                    @foreach (var c in _currencies) { <MudSelectItem Value="c">@c</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int?" Label="Kategorie" @bind-Value="_categoryId" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in FilteredCategories) { <MudSelectItem Value="@((int?)c.Id)">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudDatePicker Label="Datum *" @bind-Date="_date" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Notiz" @bind-Value="_note" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="_saving">@(_saving ? "Speichern..." : "Speichern")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Transaction? ExistingTransaction { get; set; }
    [Parameter] public bool IsExpense { get; set; }
    [Parameter] public bool HasTypePreset { get; set; }
    [Parameter] public int? AccountId { get; set; }

    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private List<string> _currencies = new();

    private IEnumerable<Category> FilteredCategories => _categories.Where(c =>
        c.Type == CategoryType.Both ||
        (c.Type == CategoryType.Income && _type == TransactionType.Income) ||
        (c.Type == CategoryType.Expense && _type == TransactionType.Expense));

    private int _accountId;
    private TransactionType _type;
    private decimal _amount = 0;
    private decimal? _originalAmount;
    private string _originalCurrency = "EUR";
    private int? _categoryId;
    private DateTime? _date = DateTime.Today;
    private string _note = "";
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts.Where(a => a.IsActive).ToListAsync();
        _categories = await db.Categories.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        _currencies = CurrencyService.GetCommonCurrencies();

        if (ExistingTransaction != null)
        {
            _accountId = ExistingTransaction.AccountId;
            _type = ExistingTransaction.Type;
            _amount = ExistingTransaction.Amount;
            _originalAmount = ExistingTransaction.OriginalAmount;
            _originalCurrency = ExistingTransaction.OriginalCurrency ?? "EUR";
            _categoryId = ExistingTransaction.CategoryId;
            _date = ExistingTransaction.Date;
            _note = ExistingTransaction.Note ?? "";
        }
        else
        {
            _type = IsExpense ? TransactionType.Expense : TransactionType.Income;
            _accountId = AccountId ?? (_accounts.FirstOrDefault()?.Id ?? 0);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task OnOriginalAmountChangedAsync(decimal? value)
    {
        _originalAmount = value;
        await AutoFillEurAmountAsync();
    }

    private async Task OnOriginalCurrencyChangedAsync(string value)
    {
        _originalCurrency = value;
        await AutoFillEurAmountAsync();
    }

    private async Task AutoFillEurAmountAsync()
    {
        if (_originalAmount.HasValue && _originalAmount.Value > 0 && !string.IsNullOrEmpty(_originalCurrency))
            _amount = await CurrencyService.ConvertAsync(_originalAmount.Value, _originalCurrency, "EUR");
    }

    private async Task SubmitAsync()
    {
        if (_accountId == 0 || _amount <= 0 || _date == null) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (ExistingTransaction != null)
        {
            var entity = await db.Transactions.FindAsync(ExistingTransaction.Id);
            if (entity != null)
            {
                entity.AccountId = _accountId;
                entity.Type = _type;
                entity.Amount = _amount;
                entity.OriginalAmount = _originalAmount;
                entity.OriginalCurrency = _originalCurrency != "EUR" ? _originalCurrency : null;
                entity.CategoryId = _categoryId;
                entity.Date = _date!.Value;
                entity.Note = string.IsNullOrWhiteSpace(_note) ? null : _note;
            }
        }
        else
        {
            db.Transactions.Add(new Transaction
            {
                AccountId = _accountId,
                Type = _type,
                Amount = _amount,
                OriginalAmount = _originalAmount,
                OriginalCurrency = _originalCurrency != "EUR" ? _originalCurrency : null,
                CategoryId = _categoryId,
                Date = _date!.Value,
                Note = string.IsNullOrWhiteSpace(_note) ? null : _note,
                CreatedAt = DateTime.UtcNow
            });
        }

        await db.SaveChangesAsync();
        _saving = false;
        AppState.NotifyTransactionChanged();
        MudDialog.Close(DialogResult.Ok(true));
    }
}
