@inject IDbContextFactory<AppDbContext> DbFactory
@inject CamtCsvImportService ImportService
@inject AppStateService AppState

<MudDialog Style="max-width:900px; width:100%;">
    <TitleContent>
        <div style="display:flex; align-items:center; gap:10px;">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="bt-text-brand" />
            <MudText Typo="Typo.h6">Kontoauszug importieren</MudText>
            @if (_step == 2 && _importResult != null)
            {
                <MudChip T="string" Size="Size.Small"
                         Style="background:rgba(20,184,166,.15); color:#14B8A6; margin-left:8px; border:1px solid rgba(20,184,166,.35);">
                    @_importResult.DetectedBank
                </MudChip>
            }
        </div>
    </TitleContent>

    <DialogContent>

        @if (_step == 0)
        {
            <div style="padding:8px 0 16px;">
                <div style="text-align:center; padding:16px 0 20px;">
                    <MudIcon Icon="@Icons.Material.Filled.Description"
                             Style="@($"color:{(_selectedFile != null ? "#66BB6A" : "#14B8A6")}; font-size:3.5rem; margin-bottom:10px;")" />
                    <MudText Typo="Typo.body1" Style="color:#F5F5F5; margin-bottom:4px;">
                        CSV-Datei des Kontoauszugs hochladen
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:#A3A3A3; margin-bottom:20px;">
                        Unterstützt: <strong style="color:#99F6E4;">Sparkasse</strong>,
                        <strong style="color:#99F6E4;">DKB</strong>,
                        <strong style="color:#99F6E4;">ING</strong>,
                        <strong style="color:#99F6E4;">Commerzbank</strong>,
                        <strong style="color:#99F6E4;">Volksbank</strong> (CAMT v8 CSV)
                    </MudText>
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelectedAsync" Accept=".csv,.txt">
                        <ButtonTemplate>
                            <MudButton HtmlTag="label" for="@context.Id"
                                       Variant="@(_selectedFile != null ? Variant.Outlined : Variant.Filled)"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.UploadFile">
                                @(_selectedFile != null ? "Andere Datei wählen" : "CSV-Datei auswählen")
                            </MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>
                </div>

                @if (_selectedFile != null)
                {
                    <div style="background:#262626; border:1px solid #404040; border-radius:12px; overflow:hidden; margin-bottom:16px;">
                        <div style="padding:10px 14px; border-bottom:1px solid #404040; display:flex; align-items:center; gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#66BB6A; font-size:1.1rem;" />
                            <span style="color:#66BB6A; font-weight:600; font-size:0.88rem;">Datei ausgewählt</span>
                        </div>
                        <table class="camt-file-table">
                            <tbody>
                                <tr><td>Dateiname</td><td><strong>@_selectedFile.Name</strong></td></tr>
                                <tr><td>Größe</td><td>@FormatFileSize(_selectedFile.Size)</td></tr>
                                <tr><td>Dateityp</td><td>@(_selectedFile.ContentType is { Length: > 0 } ct ? ct : "text/csv")</td></tr>
                                <tr><td>Geändert</td><td>@_selectedFile.LastModified.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="background:rgba(20,184,166,0.08); border:1px solid rgba(20,184,166,0.3); border-radius:12px; padding:12px 16px; display:flex; align-items:flex-start; gap:10px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color:#14B8A6; font-size:1.2rem; flex-shrink:0; margin-top:2px;" />
                        <span style="color:#A3A3A3; font-size:0.82rem; line-height:1.5;">
                            Klicke auf <strong style="color:#99F6E4;">Analysieren</strong>, um die Datei auszuwerten.<br />
                            Die KI ordnet Buchungen automatisch den passenden Kategorien zu.
                        </span>
                    </div>
                }
                else
                {
                    <div style="background:#262626; border:1px solid #404040; border-radius:12px; padding:14px 18px;">
                        <div style="color:#A3A3A3; font-size:0.72rem; font-weight:800; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.1em;">
                            Export aus dem Online-Banking
                        </div>
                        <div style="font-size:0.82rem; color:#A3A3A3; line-height:1.6;">
                            Lade deinen Kontoauszug im <strong style="color:#F5F5F5;">CSV-Format (CAMT)</strong> herunter.
                            Bei der Sparkasse: <em>Umsätze -> Exportieren -> CSV/CAMT</em>.<br />
                            Bei DKB: <em>Konto -> Umsätze -> CSV-Export</em>.<br />
                            Bei ING: <em>Umsätze -> Download -> CSV</em>.
                        </div>
                    </div>
                }
                @if (_parseError != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_parseError</MudAlert>
                }
            </div>
        }

        else if (_step == 1)
        {
            <div style="text-align:center; padding:48px 0 40px;">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.subtitle1" Style="color:#F5F5F5; margin-top:20px; font-weight:700;">
                    Datei wird analysiert...
                </MudText>
                <MudText Style="color:#A3A3A3; font-size:0.84rem; margin-top:6px;">
                    Buchungen werden erkannt und Kategorien zugeordnet
                </MudText>
            </div>
        }

        else if (_step == 2 && _importResult != null)
        {
            <div style="margin-bottom:14px;">
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                    <span class="camt-ai-badge">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size:0.85rem;" />
                        KI-Kategorisierung
                    </span>
                    @if (!string.IsNullOrEmpty(_importResult.SourceIban))
                    {
                        <MudChip T="string" Size="Size.Small" Style="background:#1f1f1f; color:#A3A3A3; border:1px solid #404040;">
                            @_importResult.SourceIban
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                        @_importResult.Rows.Count Buchungen gesamt
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">
                        @_importResult.Rows.Count(r => r.IsSelected) ausgewählt
                    </MudChip>
                    <span style="color:@(_netSelected >= 0 ? "#66BB6A" : "#EF5350"); font-weight:700; font-size:0.9rem; margin-left:auto;">
                        Netto: @_netSelected.ToString("C2", _de)
                    </span>
                </div>
                @foreach (var w in _importResult.Warnings)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">@w</MudAlert>
                }
                @{
                    var assignedCount = _importResult.Rows.Count(r => r.SuggestedCategoryId.HasValue);
                    var assignedPct   = _importResult.Rows.Count > 0 ? assignedCount * 100 / _importResult.Rows.Count : 0;
                }
                @if (assignedCount > 0)
                {
                    <div style="background:rgba(102,187,106,0.07); border:1px solid rgba(102,187,106,0.2); border-radius:10px; padding:8px 12px; display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#66BB6A; font-size:1rem;" />
                        <span style="color:#A3A3A3; font-size:0.82rem;">
                            <strong style="color:#66BB6A;">@assignedCount von @_importResult.Rows.Count Buchungen</strong>
                            automatisch kategorisiert (@assignedPct%). Nicht zugeordnete kannst du manuell anpassen.
                        </span>
                    </div>
                }
            </div>

            <MudSelect T="int" Label="Zielkonto *" Value="_targetAccountId"
                       ValueChanged="OnAccountChangedAsync"
                       Variant="Variant.Outlined" Dense="true" Class="mb-3">
                @foreach (var a in _accounts)
                {
                    <MudSelectItem Value="a.Id">@a.Name</MudSelectItem>
                }
            </MudSelect>

            <div style="max-height:360px; overflow-y:auto; border:1px solid #404040; border-radius:10px;">
                <table class="camt-preview-table">
                    <thead>
                        <tr>
                            <th style="width:38px;">
                                <MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAll"
                                             Size="Size.Small" Color="Color.Secondary" />
                            </th>
                            <th>Datum</th>
                            <th>Auftraggeber / Empfänger</th>
                            <th>Buchungstext</th>
                            <th style="min-width:140px;">Kategorie</th>
                            <th style="text-align:right;">Betrag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _importResult.Rows)
                        {
                            var isIncome = row.Amount > 0;
                            var amtColor = isIncome ? "#66BB6A" : "#EF5350";
                            var hasCat   = row.SuggestedCategoryId.HasValue;
                            <tr class="@(row.IsDuplicate ? "dup-row" : "")">
                                <td>
                                    <MudCheckBox T="bool" @bind-Value="row.IsSelected"
                                                 Size="Size.Small" Color="Color.Secondary"
                                                 Disabled="row.IsDuplicate" />
                                </td>
                                <td style="color:#A3A3A3; white-space:nowrap;">@row.BookingDate.ToString("dd.MM.yy")</td>
                                <td style="color:#F5F5F5; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@row.Counterparty">
                                    @(string.IsNullOrWhiteSpace(row.Counterparty) ? row.BookingText : row.Counterparty)
                                </td>
                                <td style="color:#A3A3A3; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@row.Purpose">
                                    @(row.Purpose.Length > 70 ? row.Purpose[..67] + "..." : row.Purpose)
                                </td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:4px;">
                                        @if (hasCat)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                                                     Style="color:#14B8A6; font-size:0.8rem; flex-shrink:0;" Title="KI-Vorschlag" />
                                        }
                                        <MudSelect T="int?" Value="row.SuggestedCategoryId"
                                                   ValueChanged="v => row.SuggestedCategoryId = v"
                                                   Dense="true" Variant="Variant.Text" Clearable="true" Margin="Margin.Dense"
                                                   Style="font-size:0.8rem; min-width:120px;">
                                            @foreach (var c in _categories)
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                </td>
                                <td style="text-align:right; font-weight:600; color:@amtColor; white-space:nowrap;">
                                    @(isIncome ? "+" : "")@row.Amount.ToString("C2", _de)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top:8px; display:flex; justify-content:space-between; font-size:0.8rem; color:#A3A3A3;">
                <span>@_importResult.Rows.Count(r => r.IsSelected && r.Amount > 0) Einnahmen · @_importResult.Rows.Count(r => r.IsSelected && r.Amount < 0) Ausgaben</span>
                <span>Doppelte/Deaktiviert: @_importResult.Rows.Count(r => !r.IsSelected)</span>
            </div>
        }

        else if (_step == 3)
        {
            <div style="text-align:center; padding:40px 0 24px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#66BB6A; font-size:4.5rem; margin-bottom:16px;" />
                <MudText Typo="Typo.h6" Style="color:#F5F5F5; margin-bottom:8px;">Import erfolgreich!</MudText>
                <MudText Typo="Typo.body2" Class="bt-text-muted">
                    <strong style="color:#66BB6A;">@_importedCount Transaktionen</strong> wurden importiert und sind jetzt in deinen Transaktionen sichtbar.
                </MudText>
                <div style="margin-top:16px; font-size:0.85rem; color:#A3A3A3;">
                    Öffne <strong style="color:#99F6E4;">Auswertungen -> Kontoauszug-Analyse</strong>, um Muster und Ausgaben zu analysieren.
                </div>
            </div>
        }

    </DialogContent>

    <DialogActions>
        @if (_step == 0)
        {
            <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
            @if (_selectedFile != null)
            {
                <MudSpacer />
                <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="AnalyseAsync">Analysieren</MudButton>
            }
        }
        else if (_step == 1)
        {
            <!-- spinner step: no buttons -->
        }
        else if (_step == 2)
        {
            <MudButton OnClick="ResetToUpload" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack">Zurück</MudButton>
            <MudSpacer />
            <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ImportAsync"
                       Disabled="@(_importing || _targetAccountId == 0 || _importResult!.Rows.All(r => !r.IsSelected))">
                @(_importing ? "Importiere..." : $"{_importResult!.Rows.Count(r => r.IsSelected)} Buchungen importieren")
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Close">Schliessen</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    private static readonly System.Globalization.CultureInfo _de =
        System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private int _step = 0;
    private string? _parseError;
    private CamtImportResult? _importResult;
    private IBrowserFile? _selectedFile;
    private byte[]? _fileBytes;

    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private int _targetAccountId;
    private bool _importing;
    private int _importedCount;

    private bool _allSelected =>
        _importResult?.Rows.All(r => r.IsSelected || r.IsDuplicate) ?? false;

    private decimal _netSelected =>
        _importResult?.Rows.Where(r => r.IsSelected).Sum(r => r.Amount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts
            .Where(a => a.IsActive)
            .OrderByDescending(a => a.IsDefault)
            .ThenBy(a => a.Name)
            .ToListAsync();
        _categories = await db.Categories
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();

        _targetAccountId = AppState.SelectedAccountId
            ?? _accounts.FirstOrDefault(a => a.IsDefault)?.Id
            ?? _accounts.FirstOrDefault()?.Id
            ?? 0;
    }

    private async Task OnFileSelectedAsync(IBrowserFile? file)
    {
        _parseError = null;
        if (file == null) return;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _fileBytes    = ms.ToArray();
            _selectedFile = file;
            _importResult = null;
        }
        catch (Exception ex)
        {
            _parseError = $"Fehler beim Lesen: {ex.Message}";
        }
    }

    private async Task AnalyseAsync()
    {
        if (_fileBytes == null) return;
        _parseError = null;
        _step = 1;
        StateHasChanged();
        await Task.Yield();

        try
        {
            string content;
            if (_fileBytes.Length >= 3 && _fileBytes[0] == 0xEF && _fileBytes[1] == 0xBB && _fileBytes[2] == 0xBF)
                content = System.Text.Encoding.UTF8.GetString(_fileBytes, 3, _fileBytes.Length - 3);
            else
                content = System.Text.Encoding.GetEncoding("ISO-8859-1").GetString(_fileBytes);

            _importResult = ImportService.ParseCsv(content);

            if (_importResult.Rows.Count == 0)
            {
                _parseError = "Keine Buchungen erkannt. Bitte prüfe das Format der Datei.";
                _step = 0;
                return;
            }

            ImportService.AssignCategoriesEnhanced(_importResult, _categories);

            await using var db = await DbFactory.CreateDbContextAsync();
            int dbDupCount = 0;
            foreach (var row in _importResult.Rows)
            {
                var absAmt = Math.Abs(row.Amount);
                bool exists = await db.Transactions.AnyAsync(t =>
                    t.AccountId == _targetAccountId &&
                    t.Date == row.BookingDate &&
                    t.Amount == absAmt &&
                    t.Note == row.Purpose);
                if (exists && !row.IsDuplicate)
                {
                    row.IsDuplicate = true;
                    row.IsSelected  = false;
                    dbDupCount++;
                }
            }
            if (dbDupCount > 0)
                _importResult.Warnings.Add($"{dbDupCount} Buchung(en) bereits in der Datenbank - automatisch abgewählt.");

            _step = 2;
        }
        catch (Exception ex)
        {
            _parseError = $"Fehler beim Analysieren: {ex.Message}";
            _step = 0;
        }
    }

    private void ResetToUpload()
    {
        _step = 0;
        _importResult = null;
        _parseError = null;
    }

    private void ToggleAll(bool val)
    {
        if (_importResult == null) return;
        foreach (var r in _importResult.Rows.Where(r => !r.IsDuplicate))
            r.IsSelected = val;
    }

    private async Task OnAccountChangedAsync(int newAccountId)
    {
        _targetAccountId = newAccountId;
        if (_importResult == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        foreach (var row in _importResult.Rows)
        {
            var absAmt = Math.Abs(row.Amount);
            bool dbExists = await db.Transactions.AnyAsync(t =>
                t.AccountId == newAccountId &&
                t.Date == row.BookingDate &&
                t.Amount == absAmt &&
                t.Note == row.Purpose);
            row.IsDuplicate = dbExists;
            if (dbExists) row.IsSelected = false;
            else if (!row.IsSelected) row.IsSelected = true;
        }
        var seen = new HashSet<string>();
        foreach (var row in _importResult.Rows)
        {
            var key = $"{row.BookingDate:yyyyMMdd}|{row.Amount:F2}|{row.Counterparty}|{row.BookingText}";
            if (!seen.Add(key)) { row.IsDuplicate = true; row.IsSelected = false; }
        }
    }

    private async Task ImportAsync()
    {
        if (_importResult == null || _targetAccountId == 0) return;
        _importing = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var toImport = _importResult.Rows.Where(r => r.IsSelected).ToList();
            int skipped = 0;

            foreach (var row in toImport)
            {
                var absAmt = Math.Abs(row.Amount);
                var note   = row.Purpose;
                bool exists = await db.Transactions.AnyAsync(t =>
                    t.AccountId == _targetAccountId &&
                    t.Date == row.BookingDate &&
                    t.Amount == absAmt &&
                    t.Note == note);
                if (exists) { skipped++; continue; }

                db.Transactions.Add(new Transaction
                {
                    AccountId  = _targetAccountId,
                    Amount     = absAmt,
                    Type       = row.Amount >= 0 ? TransactionType.Income : TransactionType.Expense,
                    Date       = row.BookingDate,
                    Note       = note,
                    CategoryId = row.SuggestedCategoryId,
                    CreatedAt  = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
            _importedCount = toImport.Count - skipped;
            AppState.NotifyTransactionChanged();
            _step = 3;
        }
        finally
        {
            _importing = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F2} MB";
    }

    private void Cancel() => MudDialog.Cancel();
    private void Close()  => MudDialog.Close(DialogResult.Ok(true));
}
