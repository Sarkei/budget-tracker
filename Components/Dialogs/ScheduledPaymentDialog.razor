@inject IDbContextFactory<AppDbContext> DbFactory
@inject CurrencyService CurrencyService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(ExistingPayment == null ? "Geplante Zahlung hinzufügen" : "Zahlung bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string" Label="Name *" @bind-Value="_name" Variant="Variant.Outlined"
                              Required="true" MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int" Label="Konto *" @bind-Value="_accountId" Variant="Variant.Outlined" Required="true">
                    @foreach (var a in _accounts) { <MudSelectItem Value="a.Id">@a.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="TransactionType" Label="Typ *" @bind-Value="_type" Variant="Variant.Outlined">
                    <MudSelectItem Value="TransactionType.Income">Einnahme</MudSelectItem>
                    <MudSelectItem Value="TransactionType.Expense">Ausgabe</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal" Label="Betrag (EUR) *" @bind-Value="_amount"
                                 Variant="Variant.Outlined" Min="0.01m" Format="F2" Required="true" />
            </MudItem>
            <MudItem xs="8">
                <MudNumericField T="decimal?" Label="Originalbetrag (optional)"
                                 Value="_originalAmount" ValueChanged="OnOriginalAmountChangedAsync"
                                 Variant="Variant.Outlined" Min="0" Format="F2" />
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="string" Label="Währung" Value="_originalCurrency"
                           ValueChanged="OnOriginalCurrencyChangedAsync" Variant="Variant.Outlined">
                    @foreach (var c in _currencies) { <MudSelectItem Value="c">@c</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int?" Label="Kategorie" @bind-Value="_categoryId" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in _categories) { <MudSelectItem Value="@((int?)c.Id)">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudDatePicker Label="Fälligkeitsdatum *" @bind-Date="_dueDate"
                               Variant="Variant.Outlined" DateFormat="dd.MM.yyyy" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="_saving">@(_saving ? "Speichern..." : "Speichern")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ScheduledPayment? ExistingPayment { get; set; }
    [Parameter] public int? AccountId { get; set; }

    private List<Account> _accounts = new();
    private List<Category> _categories = new();
    private List<string> _currencies = new();

    private string _name = "";
    private int _accountId;
    private TransactionType _type = TransactionType.Expense;
    private decimal _amount;
    private decimal? _originalAmount;
    private string _originalCurrency = "EUR";
    private int? _categoryId;
    private DateTime? _dueDate = DateTime.Today.AddDays(7);
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts.Where(a => a.IsActive).ToListAsync();
        _categories = await db.Categories.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        _currencies = CurrencyService.GetCommonCurrencies();

        if (ExistingPayment != null)
        {
            _name = ExistingPayment.Name;
            _accountId = ExistingPayment.AccountId;
            _type = ExistingPayment.Type;
            _amount = ExistingPayment.Amount;
            _originalAmount = ExistingPayment.OriginalAmount;
            _originalCurrency = ExistingPayment.OriginalCurrency ?? "EUR";
            _categoryId = ExistingPayment.CategoryId;
            _dueDate = ExistingPayment.DueDate;
        }
        else
        {
            _accountId = AccountId ?? (_accounts.FirstOrDefault()?.Id ?? 0);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task OnOriginalAmountChangedAsync(decimal? value)
    {
        _originalAmount = value;
        await AutoFillEurAmountAsync();
    }

    private async Task OnOriginalCurrencyChangedAsync(string value)
    {
        _originalCurrency = value;
        await AutoFillEurAmountAsync();
    }

    private async Task AutoFillEurAmountAsync()
    {
        if (_originalAmount.HasValue && _originalAmount.Value > 0 && !string.IsNullOrEmpty(_originalCurrency))
            _amount = await CurrencyService.ConvertAsync(_originalAmount.Value, _originalCurrency, "EUR");
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _accountId == 0 || _amount <= 0 || _dueDate == null) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (ExistingPayment != null)
        {
            var entity = await db.ScheduledPayments.FindAsync(ExistingPayment.Id);
            if (entity != null)
            {
                entity.Name = _name.Trim();
                entity.AccountId = _accountId;
                entity.Type = _type;
                entity.Amount = _amount;
                entity.OriginalAmount = _originalAmount;
                entity.OriginalCurrency = _originalCurrency != "EUR" ? _originalCurrency : null;
                entity.CategoryId = _categoryId;
                entity.DueDate = _dueDate!.Value;
            }
        }
        else
        {
            db.ScheduledPayments.Add(new ScheduledPayment
            {
                Name = _name.Trim(),
                AccountId = _accountId,
                Type = _type,
                Amount = _amount,
                OriginalAmount = _originalAmount,
                OriginalCurrency = _originalCurrency != "EUR" ? _originalCurrency : null,
                CategoryId = _categoryId,
                DueDate = _dueDate!.Value,
                IsPaid = false
            });
        }

        await db.SaveChangesAsync();
        _saving = false;
        MudDialog.Close(DialogResult.Ok(true));
    }
}
