@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject GroupNotificationService GroupNotifSvc

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Group == null ? "Gruppe erstellen" : "Gruppe bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string" Label="Gruppenname *" @bind-Value="_name" Variant="Variant.Outlined" Required="true" MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Beschreibung" @bind-Value="_description" Variant="Variant.Outlined" Lines="2" MaxLength="500" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Farbe" @bind-Value="_colorHex" Variant="Variant.Outlined">
                    @foreach (var (hex, name) in _colorOptions)
                    {
                        <MudSelectItem T="string" Value="@hex">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span style="width:14px;height:14px;border-radius:50%;background:@hex;display:inline-block;flex-shrink:0;"></span>
                                @name
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (Group != null && _members.Count > 0)
        {
            <div style="margin-top:20px;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.1em; font-weight:800; display:block; margin-bottom:10px;">Mitglieder</MudText>
                @foreach (var m in _members)
                {
                    var isAdmin = m.Role == GroupMemberRole.Admin;
                    var name = GetMemberName(m);
                    var isMe = m.UserId == CurrentUserId;
                    var personColor = isAdmin ? "#FFB300" : "#A3A3A3";
                    <div style="display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid #404040;">
                        <MudIcon Icon="@Icons.Material.Filled.Person"
                                 Style="@($"color:{personColor};font-size:16px;")" />
                        <MudText Typo="Typo.body2" Style="flex:1; color:#F5F5F5;">@name@(isMe ? " (Du)" : "")</MudText>
                        @if (!isMe && !isAdmin)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                           Size="Size.Small" Color="Color.Error"
                                           Disabled="_saving"
                                           OnClick="() => KickMemberAsync(m)"
                                           Title="Mitglied entfernen" />
                        }
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (CanDelete && Group != null)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="DeleteGroupAsync"
                       Disabled="_saving" Style="margin-right:auto;">Gruppe löschen</MudButton>
        }
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="_saving">@(_saving ? "Speichern..." : "Speichern")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SharedGroup? Group { get; set; }
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    private List<GroupMember> _members = new();

    private static readonly (string Hex, string Name)[] _colorOptions =
    [
        ("#EF5350", "Rot"), ("#EC407A", "Pink"), ("#AB47BC", "Lila"), ("#7E57C2", "Dunkelviolett"),
        ("#14B8A6", "Teal"), ("#26C6DA", "Cyan"), ("#26A69A", "Türkis"), ("#66BB6A", "Grün"),
        ("#D4E157", "Hellgrün"), ("#FFCA28", "Gelb"), ("#FFA726", "Orange"), ("#FF7043", "Dunkelorange"),
        ("#78909C", "Blaugräu"), ("#BDBDBD", "Grau"), ("#A3A3A3", "Schieferblau")
    ];

    private string _name = "";
    private string _description = "";
    private string _colorHex = "#14B8A6";
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (Group != null)
        {
            _name = Group.Name;
            _description = Group.Description ?? "";
            _colorHex = Group.ColorHex;
            await LoadMembersAsync();
        }
    }

    private async Task LoadMembersAsync()
    {
        if (Group == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        _members = await db.GroupMembers
            .Include(m => m.User)
            .Where(m => m.GroupId == Group.Id)
            .OrderBy(m => m.Role)
            .ThenBy(m => m.User.FirstName)
            .ToListAsync();
    }

    private static string GetMemberName(GroupMember m)
    {
        if (m.User == null) return $"User {m.UserId}";
        if (!string.IsNullOrEmpty(m.User.DisplayName)) return m.User.DisplayName;
        var full = $"{m.User.FirstName} {m.User.LastName}".Trim();
        return string.IsNullOrEmpty(full) ? m.User.Username : full;
    }

    private async Task KickMemberAsync(GroupMember member)
    {
        var name = GetMemberName(member);
        var confirm = await DialogService.ShowMessageBox(
            "Mitglied entfernen?",
            $"{name} wirklich aus der Gruppe entfernen?",
            yesText: "Entfernen", cancelText: "Abbrechen");
        if (confirm != true) return;

        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.GroupMembers.FindAsync(member.Id);
        if (entity != null) db.GroupMembers.Remove(entity);
        await db.SaveChangesAsync();
        _saving = false;

        await GroupNotifSvc.NotifyGroupAsync(member.GroupId, excludeKicked: member.UserId);
        await GroupNotifSvc.NotifyKickedUserAsync(member.UserId, member.GroupId);

        Snackbar.Add($"{name} wurde entfernt.", Severity.Success);
        await LoadMembersAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task DeleteGroupAsync()
    {
        if (Group == null) return;
        var confirm = await DialogService.ShowMessageBox(
            "Gruppe löschen?",
            $"\"{ Group.Name}\" und alle dazugehörigen Ausgaben unwiderruflich löschen?",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (confirm != true) return;
        _saving = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.SharedGroups.FindAsync(Group.Id);
        if (entity != null)
        {
            db.SharedGroups.Remove(entity);
            await db.SaveChangesAsync();
        }
        _saving = false;
        await GroupNotifSvc.NotifyGroupAsync(Group.Id);
        MudDialog.Close(DialogResult.Ok("deleted"));
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (Group != null)
        {
            var entity = await db.SharedGroups.FindAsync(Group.Id);
            if (entity != null)
            {
                entity.Name = _name.Trim();
                entity.Description = string.IsNullOrWhiteSpace(_description) ? "" : _description.Trim();
                entity.ColorHex = _colorHex;
            }
        }
        else
        {
            var group = new SharedGroup
            {
                Name = _name.Trim(),
                Slug = await BuildUniqueSlugAsync(db, _name.Trim()),
                Description = string.IsNullOrWhiteSpace(_description) ? "" : _description.Trim(),
                ColorHex = _colorHex,
                CreatedByUserId = CurrentUserId,
                IsActive = true
            };
            db.SharedGroups.Add(group);
            await db.SaveChangesAsync();

            // Add creator as admin member
            db.GroupMembers.Add(new GroupMember
            {
                GroupId = group.Id,
                UserId = CurrentUserId,
                Role = GroupMemberRole.Admin
            });
        }

        await db.SaveChangesAsync();
        _saving = false;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task<string> BuildUniqueSlugAsync(AppDbContext db, string name)
    {
        var baseSlug = DatabaseInitializer.Slugify(name);
        var slug = baseSlug;
        var suffix = 1;
        while (await db.SharedGroups.AnyAsync(g => g.Slug == slug))
        {
            suffix++;
            slug = $"{baseSlug}-{suffix}";
        }
        return slug;
    }
}
