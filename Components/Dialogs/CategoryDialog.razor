@inject IDbContextFactory<AppDbContext> DbFactory

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(ExistingCategory == null ? "Kategorie hinzufügen" : "Kategorie bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string" Label="Name *" @bind-Value="_name" Variant="Variant.Outlined"
                              Required="true" MaxLength="100" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="CategoryType" Label="Typ *" @bind-Value="_type" Variant="Variant.Outlined">
                    <MudSelectItem Value="CategoryType.Income">Einnahme</MudSelectItem>
                    <MudSelectItem Value="CategoryType.Expense">Ausgabe</MudSelectItem>
                    <MudSelectItem Value="CategoryType.Both">Beides</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Farbe" @bind-Value="_colorHex" Variant="Variant.Outlined">
                    @foreach (var (hex, name) in _colorOptions)
                    {
                        <MudSelectItem T="string" Value="@hex">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span style="width:14px;height:14px;border-radius:50%;background:@hex;display:inline-block;flex-shrink:0;"></span>
                                @name
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="_saving">@(_saving ? "Speichern..." : "Speichern")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Category? ExistingCategory { get; set; }

    private static readonly (string Hex, string Name)[] _colorOptions =
    [
        ("#EF5350", "Rot"), ("#EC407A", "Pink"), ("#AB47BC", "Lila"), ("#7E57C2", "Dunkelviolett"),
        ("#14B8A6", "Teal"), ("#26C6DA", "Cyan"), ("#26A69A", "Türkis"), ("#66BB6A", "Grün"),
        ("#D4E157", "Hellgrün"), ("#FFCA28", "Gelb"), ("#FFA726", "Orange"), ("#FF7043", "Dunkelorange"),
        ("#78909C", "Blaugräu"), ("#BDBDBD", "Grau"), ("#A3A3A3", "Schieferblau")
    ];

    private string _name = "";
    private CategoryType _type = CategoryType.Expense;
    private string _colorHex = "#14B8A6";
    private bool _saving;

    protected override void OnInitialized()
    {
        if (ExistingCategory != null)
        {
            _name = ExistingCategory.Name;
            _type = ExistingCategory.Type;
            _colorHex = ExistingCategory.ColorHex;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (ExistingCategory != null)
        {
            var entity = await db.Categories.FindAsync(ExistingCategory.Id);
            if (entity != null)
            {
                entity.Name = _name.Trim();
                entity.Type = _type;
                entity.ColorHex = _colorHex;
            }
        }
        else
        {
            db.Categories.Add(new Category
            {
                Name = _name.Trim(),
                Type = _type,
                ColorHex = _colorHex,
                IsActive = true
            });
        }

        await db.SaveChangesAsync();
        _saving = false;
        MudDialog.Close(DialogResult.Ok(true));
    }
}
