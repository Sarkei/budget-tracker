@inject IDbContextFactory<AppDbContext> DbFactory

<MudDialog>
    <TitleContent>
        <div style="display:flex; align-items:center; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Group" Class="bt-text-brand" />
            <MudText Typo="Typo.h6">Mitglieder (@Members.Count)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudPaper Style="background:#262626; border:1px solid #404040; border-radius:14px; overflow:hidden;">
            @foreach (var m in Members)
            {
                var name = GetMemberName(m);
                var isAdminMember = m.Role == GroupMemberRole.Admin;
                var personColor = isAdminMember ? "#FFB300" : "#A3A3A3";
                var bal = Balances.TryGetValue(m.UserId, out var b) ? b : 0m;
                var bCol = bal > 0.005m ? "#66BB6A" : bal < -0.005m ? "#EF5350" : "#A3A3A3";
                var balLabel = bal > 0.005m ? "bekommt zurück" : bal < -0.005m ? "schuldet" : "ausgeglichen";
                <div style="display:flex; align-items:center; padding:12px 16px; border-bottom:1px solid #404040; gap:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.Person"
                             Style="@($"color:{personColor};")"
                             Size="Size.Small" />
                    <div style="flex:1; min-width:0;">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <MudText Typo="Typo.body2" Style="font-weight:600;">@name</MudText>
                            @if (isAdminMember)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Style="height:18px; font-size:10px;">Admin</MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Style="@($"color:{bCol}")">@balLabel</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="@($"color:{bCol}; font-weight:700; font-size:0.85rem;")">
                        @(bal >= 0 ? "+" : "")@bal.ToString("C2", _de)
                    </MudText>
                </div>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        @if (IsAdmin)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="Invite">Einladen</MudButton>
        }
        <MudButton OnClick="Close" Variant="Variant.Text">Schließen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<GroupMember> Members { get; set; } = new();
    [Parameter] public Dictionary<int, decimal> Balances { get; set; } = new();
    [Parameter] public bool IsAdmin { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(false));
    private void Invite() => MudDialog.Close(DialogResult.Ok(true));

    private static string GetMemberName(GroupMember? m)
    {
        if (m?.User == null) return "User";
        if (!string.IsNullOrEmpty(m.User.DisplayName)) return m.User.DisplayName;
        var full = $"{m.User.FirstName} {m.User.LastName}".Trim();
        return string.IsNullOrEmpty(full) ? m.User.Username : full;
    }
}
