@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Schulden begleichen</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Style="color:#A3A3A3; margin-bottom:16px; line-height:1.6;">
            Du zahlst an <strong style="color:#F5F5F5;">@PayeeName</strong>.
            Offener Betrag: <strong style="color:#EF5350;">@OutstandingAmount.ToString("C2", _de)</strong>
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudNumericField T="decimal" Label="Betrag *" @bind-Value="_amount"
                                 Variant="Variant.Outlined" Min="0.01m" Max="@_maxAmount"
                                 Format="F2" />
                <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               OnClick="@(() => _amount = Math.Round(OutstandingAmount / 2, 2))">
                        Hälfte (@(Math.Round(OutstandingAmount / 2, 2).ToString("C2", _de)))
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                               OnClick="@(() => _amount = OutstandingAmount)">
                        Alles (@OutstandingAmount.ToString("C2", _de))
                    </MudButton>
                </div>
            </MudItem>
            <MudItem xs="12">
                <MudDatePicker Label="Datum" @bind-Date="_date" Variant="Variant.Outlined"
                               DateFormat="dd.MM.yyyy" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Notiz (optional)" @bind-Value="_note"
                              Variant="Variant.Outlined" Placeholder="z.B. Überweisung, Bar bezahlt…" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="SettleAsync"
                   Disabled="_saving || _amount <= 0"
                   StartIcon="@Icons.Material.Filled.CheckCircle">
            @(_saving ? "Speichern..." : "Zahlung erfassen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int GroupId { get; set; }
    [Parameter] public int PayerUserId { get; set; }
    [Parameter] public int PayeeUserId { get; set; }
    [Parameter] public string PayeeName { get; set; } = "";
    [Parameter] public decimal OutstandingAmount { get; set; }

    private decimal _amount;
    private decimal _maxAmount;
    private DateTime? _date = DateTime.Today;
    private string _note = "";
    private bool _saving;

    protected override void OnInitialized()
    {
        _amount = OutstandingAmount;
        _maxAmount = OutstandingAmount;
    }

    private async Task SettleAsync()
    {
        if (_amount <= 0) return;
        _saving = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        var settlement = new GroupSettlement
        {
            GroupId = GroupId,
            PayerUserId = PayerUserId,
            PayeeUserId = PayeeUserId,
            Amount = Math.Round(_amount, 2),
            Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(),
            Date = _date?.Date ?? DateTime.Today,
            CreatedAt = DateTime.UtcNow
        };

        db.GroupSettlements.Add(settlement);
        await db.SaveChangesAsync();

        Snackbar.Add($"{_amount.ToString("C2", _de)} an {PayeeName} erfasst.", Severity.Success);
        _saving = false;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
