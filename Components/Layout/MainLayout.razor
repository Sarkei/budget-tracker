@inherits LayoutComponentBase
@implements IDisposable
@inject AppStateService AppState
@inject GroupNotificationService GroupNotifSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject UserPreferencesService PrefsService
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<div class="app">
    <header class="app-header">
        <div class="app-container app-header__inner">
            <a class="app-brand" href="/" aria-label="Budget Tracker – zur Übersicht">
                <span class="app-brand__mark" aria-hidden="true">B</span>
                <span class="app-brand__text">
                    Budget Tracker
                    <span class="app-brand__sub">Finanzen</span>
                </span>
            </a>

            <nav class="app-nav" aria-label="Hauptnavigation">
                @foreach (var item in PrimaryNav)
                {
                    var active = IsActive(item.Href);
                    <a class="app-nav-item @(active ? "is-active" : "")" href="@item.Href"
                       aria-current="@(active ? "page" : null)">@item.Label</a>
                }
                @if (MoreNav.Any())
                {
                    <details class="app-more">
                        <summary class="app-nav-item">Mehr</summary>
                        <div class="app-more__panel">
                            @foreach (var item in MoreNav)
                            {
                                <a class="app-more__item @(IsActive(item.Href) ? "is-active" : "")"
                                   href="@item.Href">@item.Label</a>
                            }
                        </div>
                    </details>
                }
            </nav>

            <div class="app-actions">
                <label class="app-account">
                    <span class="sr-only">Konto auswählen</span>
                    <select class="app-select" @onchange="OnAccountSelected">
                        <option value="" selected="@AppState.ShowingAllAccounts">Alle Konten</option>
                        @foreach (var acc in _accounts)
                        {
                            <option value="@acc.Id" selected="@(AppState.SelectedAccountId == acc.Id)">@acc.Name</option>
                        }
                    </select>
                </label>

                <button type="button" class="app-iconbtn" @onclick="ToggleThemeAsync"
                        title="@(_isDark ? "Helles Design" : "Dunkles Design")"
                        aria-label="Farbschema wechseln">
                    @if (_isDark)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z"></path>
                        </svg>
                    }
                </button>

                <AuthorizeView>
                    <Authorized>
                        <button type="button" class="app-iconbtn" @onclick="ToggleNotifications"
                                title="Einladungen" aria-label="Einladungen">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"></path>
                                <path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
                            </svg>
                            @if (_pendingCount > 0)
                            {
                                <span class="app-count">@_pendingCount</span>
                            }
                        </button>
                        <button type="button" class="app-iconbtn app-iconbtn--logout" @onclick="LogoutAsync"
                                title="Abmelden" aria-label="Abmelden">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <path d="M16 17l5-5-5-5M21 12H9"></path>
                            </svg>
                        </button>
                    </Authorized>
                </AuthorizeView>

                <button type="button" class="app-iconbtn app-mobile-toggle" @onclick="() => _mobileOpen = !_mobileOpen"
                        title="Menü" aria-label="Menü" aria-expanded="@_mobileOpen.ToString().ToLowerInvariant()">
                    @if (_mobileOpen)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                            <path d="M6 6l12 12M18 6L6 18"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                            <path d="M4 7h16M4 12h16M4 17h16"></path>
                        </svg>
                    }
                </button>
            </div>
        </div>

        @if (_mobileOpen)
        {
            <div class="app-mobile-nav">
                @foreach (var item in BuildNav())
                {
                    <a class="@(IsActive(item.Href) ? "is-active" : "")" href="@item.Href"
                       @onclick="() => _mobileOpen = false">@item.Label</a>
                }
                <div class="app-mobile-nav__row">
                    <label class="app-account" style="flex:1;">
                        <span class="sr-only">Konto auswählen</span>
                        <select class="app-select" @onchange="OnAccountSelected">
                            <option value="" selected="@AppState.ShowingAllAccounts">Alle Konten</option>
                            @foreach (var acc in _accounts)
                            {
                                <option value="@acc.Id" selected="@(AppState.SelectedAccountId == acc.Id)">@acc.Name</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="app-iconbtn" @onclick="ToggleThemeAsync"
                            aria-label="Farbschema wechseln" title="Farbschema wechseln">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                        </svg>
                    </button>
                    <AuthorizeView>
                        <Authorized>
                            <button type="button" class="app-iconbtn" @onclick="LogoutAsync"
                                    title="Abmelden" aria-label="Abmelden">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <path d="M16 17l5-5-5-5M21 12H9"></path>
                                </svg>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </header>

    <main>
        @Body
    </main>

    <footer class="app-footer">
        <div class="app-container app-footer__inner">
            <span>Budget Tracker · Privates Budget</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </footer>
</div>

<!-- ── Einladungen ── -->
@if (_showNotifPanel)
{
    <div class="bt-notif-panel">
        <div class="bt-notif-head">
            <span class="app-label">Gruppen-Einladungen</span>
            <button type="button" class="app-iconbtn" @onclick="() => _showNotifPanel = false"
                    aria-label="Schließen" title="Schließen">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>
        @if (!_pendingInvitations.Any())
        {
            <div class="app-empty" style="padding:16px;">Keine ausstehenden Einladungen</div>
        }
        else
        {
            @foreach (var inv in _pendingInvitations)
            {
                var invId = inv.Id;
                <div class="bt-notif-item">
                    <div class="app-row__title">@(inv.Group?.Name ?? "Gruppe")</div>
                    <div class="app-row__meta">von @(inv.InvitedByUser?.DisplayName ?? inv.InvitedByUser?.Username ?? "?")</div>
                    <div style="display:flex; gap:8px; margin-top:10px;">
                        <button type="button" class="ui-btn ui-btn-primary" style="height:34px;"
                                @onclick="() => AcceptInvitationAsync(invId)">Annehmen</button>
                        <button type="button" class="ui-btn" style="height:34px;"
                                @onclick="() => DeclineInvitationAsync(invId)">Ablehnen</button>
                    </div>
                </div>
            }
        }
    </div>
    <div style="position:fixed; inset:0; z-index:1999;" @onclick="() => _showNotifPanel = false"></div>
}

@code {
    private bool _mobileOpen;
    private List<Account> _accounts = new();
    private bool _defaultSelected;
    private UserPreferences _prefs = new();
    private bool _isDark;

    // Einladungen
    private bool _showNotifPanel;
    private int _pendingCount;
    private List<GroupInvitation> _pendingInvitations = new();
    private int _currentUserId;
    private string _currentUserEmail = "";

    private record NavItem(string Label, string Href);

    private static readonly string[] PrimaryHrefs = { "/", "/transactions", "/statistics", "/reports" };

    private List<NavItem> BuildNav()
    {
        var items = new List<NavItem>
        {
            new("Übersicht", "/"),
            new("Buchungen", "/transactions"),
            new("Auswertung", "/statistics"),
            new("Berichte", "/reports"),
        };
        if (_prefs.ShowRecurring) items.Add(new("Wiederkehrend", "/recurring"));
        if (_prefs.ShowScheduledPayments) items.Add(new("Geplante Zahlungen", "/scheduled"));
        if (_prefs.ShowSavingsPots) items.Add(new("Spartöpfe", "/savings"));
        if (_prefs.ShowGroups) items.Add(new("Gemeinsame Ausgaben", "/groups"));
        items.Add(new("Finanzübersicht", "/finance-overview"));
        items.Add(new("Kontoauszug", "/bank-analysis"));
        items.Add(new("Einstellungen", "/settings"));
        return items;
    }

    private List<NavItem> PrimaryNav => BuildNav().Where(i => PrimaryHrefs.Contains(i.Href)).ToList();
    private List<NavItem> MoreNav => BuildNav().Where(i => !PrimaryHrefs.Contains(i.Href)).ToList();

    private readonly MudTheme _theme = new()
    {
        Palette = new PaletteLight
        {
            Primary = "#2f7d5a",
            Secondary = "#2f7d5a",
            Background = "#f3f5f4",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#ffffff",
            TextPrimary = "#121a16",
            TextSecondary = "#55635c",
            ActionDefault = "#2f7d5a",
            Divider = "#dde3df",
            TableLines = "#dde3df",
            TableHover = "#eaeeec",
            TableStriped = "#f3f5f4",
            Success = "#2f7d5a",
            Info = "#2f7d5a",
            Warning = "#a8701c",
            Error = "#b4453a",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#4fbf8b",
            Secondary = "#4fbf8b",
            Background = "#101312",
            Surface = "#16211c",
            DrawerBackground = "#16211c",
            AppbarBackground = "#101312",
            TextPrimary = "#e9edeb",
            TextSecondary = "#a4aaa7",
            ActionDefault = "#4fbf8b",
            Divider = "#2b2f2d",
            TableLines = "#2b2f2d",
            TableHover = "#1b1e1d",
            TableStriped = "#16211c",
            Success = "#4fbf8b",
            Info = "#4fbf8b",
            Warning = "#e8b25f",
            Error = "#f08a7a",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += async () => await InvokeAsync(StateHasChanged);
        AppState.OnTransactionChanged += OnTransactionChangedHandler;
        Nav.LocationChanged += (_, _) => InvokeAsync(StateHasChanged);
        PrefsService.OnChanged += async () => { _prefs = PrefsService.Current; await InvokeAsync(StateHasChanged); };

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _currentUserEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
        if (int.TryParse(idStr, out var uid))
        {
            _currentUserId = uid;
            await PrefsService.LoadAsync(uid);
            _prefs = PrefsService.Current;
            await LoadInvitationsAsync();
            GroupNotifSvc.Register(_currentUserId, async () =>
            {
                await LoadInvitationsAsync();
                await InvokeAsync(StateHasChanged);
            });
        }

        await LoadAccountsAsync();

        if (!_defaultSelected && AppState.ShowingAllAccounts)
        {
            var defaultAcc = _accounts.FirstOrDefault(a => a.IsDefault);
            if (defaultAcc != null)
                AppState.SelectAccount(defaultAcc.Id);
            _defaultSelected = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<string>("btTheme.get");
            var dark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
            if (dark != _isDark)
            {
                _isDark = dark;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("btTheme.set", _isDark ? "dark" : "light");
    }

    private bool IsActive(string href)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        if (href == "/") return current == "" || current == "/";
        return current.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnAccountSelected(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? accountId = int.TryParse(raw, out var id) ? id : null;
        AppState.SelectAccount(accountId);
        await LoadAccountsAsync();
        _mobileOpen = false;
    }

    private void ToggleNotifications()
    {
        _showNotifPanel = !_showNotifPanel;
        if (_showNotifPanel) _ = LoadInvitationsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts.Where(a => a.IsActive).OrderBy(a => a.Name).ToListAsync();
    }

    private async void OnTransactionChangedHandler()
    {
        await LoadAccountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void LogoutAsync() => Nav.NavigateTo("/logout", forceLoad: true);

    private async Task LoadInvitationsAsync()
    {
        if (_currentUserId == 0 && string.IsNullOrEmpty(_currentUserEmail)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        _pendingInvitations = await db.GroupInvitations
            .Include(i => i.Group)
            .Include(i => i.InvitedByUser)
            .Where(i => (i.InviteeUserId == _currentUserId || i.InviteeEmail == _currentUserEmail)
                        && i.Status == InvitationStatus.Pending)
            .OrderByDescending(i => i.CreatedAt)
            .ToListAsync();
        _pendingCount = _pendingInvitations.Count;
    }

    private async Task AcceptInvitationAsync(int invId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var inv = await db.GroupInvitations.FindAsync(invId);
        if (inv == null || inv.Status != InvitationStatus.Pending) return;

        inv.Status = InvitationStatus.Accepted;
        inv.InviteeUserId = _currentUserId;
        inv.RespondedAt = DateTime.UtcNow;

        var alreadyMember = await db.GroupMembers
            .AnyAsync(m => m.GroupId == inv.GroupId && m.UserId == _currentUserId);
        if (!alreadyMember)
        {
            db.GroupMembers.Add(new GroupMember
            {
                GroupId = inv.GroupId,
                UserId = _currentUserId,
                JoinedAt = DateTime.UtcNow
            });
        }
        await db.SaveChangesAsync();
        await LoadInvitationsAsync();
        _showNotifPanel = _pendingInvitations.Any();
        AppState.NotifyGroupsChanged();
    }

    private async Task DeclineInvitationAsync(int invId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var inv = await db.GroupInvitations.FindAsync(invId);
        if (inv == null) return;
        inv.Status = InvitationStatus.Declined;
        inv.RespondedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        await LoadInvitationsAsync();
        _showNotifPanel = _pendingInvitations.Any();
    }

    public void Dispose()
    {
        AppState.OnTransactionChanged -= OnTransactionChangedHandler;
        GroupNotifSvc.Unregister(_currentUserId);
    }
}
