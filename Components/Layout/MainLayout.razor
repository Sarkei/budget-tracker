@inherits LayoutComponentBase
@implements IDisposable
@inject AppStateService AppState
@inject GroupNotificationService GroupNotifSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject UserPreferencesService PrefsService

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
    <!-- ── Top AppBar ── -->
    <MudAppBar Elevation="0" Class="bt-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       Class="bt-menu-btn-mobile-hide"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <span class="bt-page-title bt-appbar-brand">
            Budget<span class="bt-appbar-brand-accent">Tracker</span>
        </span>
        <MudSpacer />
        @if (!AppState.ShowingAllAccounts)
        {
            <MudChip T="string" Color="Color.Secondary" Size="Size.Small"
                     Class="bt-hidden-mobile"
                     Style="font-size:12px; height:28px;"
                     OnClick="() => AppState.SelectAccount(null)">
                @(_accounts.FirstOrDefault(a => a.Id == AppState.SelectedAccountId)?.Name ?? "")
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Style="margin-left:4px;" />
            </MudChip>
        }
        <AuthorizeView>
            <Authorized>
                <div class="bt-flex-gap-sm">
                    <span class="bt-appbar-username bt-appbar-user">
                        @(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name ?? "")
                    </span>
                    <MudBadge Content="@_pendingCount" Color="Color.Error" Overlap="true" Visible="@(_pendingCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => _showNotifPanel = !_showNotifPanel)"
                                       Class="bt-text-muted" Title="Einladungen" />
                    </MudBadge>
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Default" Size="Size.Small"
                                   OnClick="LogoutAsync" Title="Abmelden" Class="bt-text-muted" />
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <!-- ── Sidebar ── -->
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Persistent"
               Class="bt-desktop-drawer"
               Style="background:var(--card-bg); border-right:1px solid var(--border-muted); width:256px;">
        <div class="bt-drawer-inner">

            <div class="bt-drawer-brand">
                <a href="/" class="bt-drawer-logo">Budget<span class="bt-drawer-logo-accent">.</span>Tracker</a>
            </div>

            <div class="bt-section-label">Navigation</div>
            <nav style="flex-shrink:0;">
                <a class="bt-nav-link @(IsActive("/") ? "active" : "")" href="/">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="bt-nav-icon" />
                    Dashboard
                </a>
                <a class="bt-nav-link @(IsActive("/transactions") ? "active" : "")" href="/transactions">
                    <MudIcon Icon="@Icons.Material.Filled.SwapVert" Class="bt-nav-icon" />
                    Transaktionen
                </a>
                @if (_prefs.ShowRecurring)
                {
                <a class="bt-nav-link @(IsActive("/recurring") ? "active" : "")" href="/recurring">
                    <MudIcon Icon="@Icons.Material.Filled.Repeat" Class="bt-nav-icon" />
                    Wiederkehrend
                </a>
                }
                @if (_prefs.ShowScheduledPayments)
                {
                <a class="bt-nav-link @(IsActive("/scheduled") ? "active" : "")" href="/scheduled">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="bt-nav-icon" />
                    Geplante Zahlungen
                </a>
                }
                @if (_prefs.ShowSavingsPots)
                {
                <a class="bt-nav-link @(IsActive("/savings") ? "active" : "")" href="/savings">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Class="bt-nav-icon" />
                    Spartöpfe
                </a>
                }
                @if (_prefs.ShowGroups)
                {
                <a class="bt-nav-link @(IsActive("/groups") ? "active" : "")" href="/groups">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Class="bt-nav-icon" />
                    Gemeinsame Ausgaben
                </a>
                }
                <a class="bt-nav-link @(IsActive("/statistics") ? "active" : "")" href="/statistics">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Class="bt-nav-icon" />
                    Statistik
                </a>
                <a class="bt-nav-link @(IsActive("/finance-overview") ? "active" : "")" href="/finance-overview">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="bt-nav-icon" />
                    Finanzübersicht
                </a>
                <a class="bt-nav-link @(IsActive("/bank-analysis") ? "active" : "")" href="/bank-analysis">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="bt-nav-icon" />
                    Kontoauszug
                </a>
                <a class="bt-nav-link @(IsActive("/reports") ? "active" : "")" href="/reports">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="bt-nav-icon" />
                    Berichte
                </a>
            </nav>

            <!-- Spacer pushes accounts + settings to bottom -->
            <div style="flex:1;"></div>

            <!-- Accounts section at bottom -->
            <div class="bt-drawer-divider">
                <div class="bt-section-label">Konten</div>

                <button class="bt-account-item @(AppState.ShowingAllAccounts ? "active" : "")"
                        @onclick="() => AppState.SelectAccount(null)">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                             Style="@($"color:{(AppState.ShowingAllAccounts ? "#14B8A6" : "#A3A3A3")}; font-size:18px;")" />
                    <span class="bt-account-label @(AppState.ShowingAllAccounts ? "is-active" : "is-inactive")">
                        Alle Konten
                    </span>
                    <span class="bt-account-balance bt-text-muted">
                        @_totalBalance.ToString("C2", _de)
                    </span>
                </button>

                @foreach (var account in _accounts)
                {
                    var isSelected = AppState.SelectedAccountId == account.Id;
                    var accBal = _accountBalances.TryGetValue(account.Id, out var b) ? b : 0m;
                    var accBalClass = UiClasses.BalanceText(accBal);
                    <button class="bt-account-item @(isSelected ? "active" : "") @(account.IsDefault ? "bt-account-default" : "")"
                            @onclick="() => SelectAccount(account.Id)">
                        <div style="width:18px; height:18px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            @if (account.IsDefault)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color:#FFB300;" />
                            }
                            else
                            {
                                <div class="bt-account-dot" style="@($"background:{account.ColorHex}; width:10px; height:10px;")"></div>
                            }
                        </div>
                        <span class="bt-account-label @(isSelected ? "is-active" : "is-inactive")">
                            @account.Name
                        </span>
                        <span class="bt-account-balance @accBalClass">
                            @accBal.ToString("C2", _de)
                        </span>
                    </button>
                }
            </div>

            <!-- Settings at very bottom -->
            <div style="border-top:1px solid #1f1f1f; flex-shrink:0; padding-bottom:8px;">
                <a class="bt-nav-link @(IsActive("/settings") ? "active" : "")" href="/settings">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="bt-nav-icon" />
                    Einstellungen
                </a>
            </div>

        </div>
    </MudDrawer>

    <!-- ── Main content — full height background ── -->
    <MudMainContent Class="bt-main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="bt-main-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<!-- ── Mobile account bar ── -->
<div class="mobile-account-bar">
    <button class="mobile-acc-btn @(AppState.ShowingAllAccounts ? "active" : "")"
            @onclick="() => AppState.SelectAccount(null)">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Style="font-size:13px;" />
        Alle
    </button>
    @foreach (var acc in _accounts)
    {
        var mSel = AppState.SelectedAccountId == acc.Id;
        <button class="mobile-acc-btn @(mSel ? "active" : "") @(acc.IsDefault ? "is-default" : "")"
                @onclick="() => SelectAccount(acc.Id)">
            @if (acc.IsDefault)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Style="font-size:12px; color:#FFB300;" />
            }
            else
            {
                <span style="width:8px; height:8px; border-radius:50%; background:@acc.ColorHex; display:inline-block; flex-shrink:0;"></span>
            }
            @acc.Name
        </button>
    }
</div>

<!-- ── Notification panel ── -->
@if (_showNotifPanel)
{
    <div class="bt-notif-panel">
        <div class="bt-notif-head">
            <MudText Typo="Typo.subtitle2" Class="bt-text-brand-muted" Style="font-weight:700; text-transform:uppercase; letter-spacing:.08em;">Gruppen-Einladungen</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                           OnClick="@(() => _showNotifPanel = false)" />
        </div>
        @if (!_pendingInvitations.Any())
        {
            <div class="bt-empty">Keine ausstehenden Einladungen</div>
        }
        else
        {
            @foreach (var inv in _pendingInvitations)
            {
                var invId = inv.Id;
                <div class="bt-notif-item">
                    <MudText Typo="Typo.body2" Class="bt-text-foreground" Style="font-weight:700;">@(inv.Group?.Name ?? "Gruppe")</MudText>
                    <MudText Typo="Typo.caption" Class="bt-text-muted" Style="display:block; margin:4px 0;">von @(inv.InvitedByUser?.DisplayName ?? inv.InvitedByUser?.Username ?? "?")</MudText>
                    <div style="display:flex; gap:8px; margin-top:6px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   OnClick="@(() => AcceptInvitationAsync(invId))">Annehmen</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                   OnClick="@(() => DeclineInvitationAsync(invId))">Ablehnen</MudButton>
                    </div>
                </div>
            }
        }
    </div>
    <div style="position:fixed; inset:0; z-index:1999;" @onclick="@(() => _showNotifPanel = false)"></div>
}

<!-- ── Mobile bottom navigation (4 fixed + center FAB) ── -->
@if (_fabOpen)
{
    <div class="bottom-fab-overlay" @onclick="@(() => _fabOpen = false)"></div>
    <div class="bottom-fab-menu">
        <div class="bottom-fab-separator">Schnellaktionen</div>
        <a class="bottom-fab-menu-item" href="/transactions?add=income" @onclick="@(() => _fabOpen = false)">
            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Class="bt-text-success" />
            <span>Einnahme erfassen</span>
        </a>
        <a class="bottom-fab-menu-item" href="/transactions?add=expense" @onclick="@(() => _fabOpen = false)">
            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Class="bt-text-error" />
            <span>Ausgabe erfassen</span>
        </a>
        @if (_prefs.ShowRecurring)
        {
            <a class="bottom-fab-menu-item @(IsActive("/recurring") ? "active" : "")" href="/recurring"
               @onclick="@(() => _fabOpen = false)">
                <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Class="bt-text-brand" />
                <span>Wiederkehrend</span>
            </a>
        }
        @if (_prefs.ShowScheduledPayments)
        {
            <a class="bottom-fab-menu-item @(IsActive("/scheduled") ? "active" : "")" href="/scheduled"
               @onclick="@(() => _fabOpen = false)">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="bt-text-brand" />
                <span>Geplante Zahlungen</span>
            </a>
        }
        @if (_prefs.ShowSavingsPots)
        {
            <a class="bottom-fab-menu-item @(IsActive("/savings") ? "active" : "")" href="/savings"
               @onclick="@(() => _fabOpen = false)">
                <MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Small" Class="bt-text-brand" />
                <span>Spartöpfe</span>
            </a>
        }
        @if (_prefs.ShowGroups)
        {
            <a class="bottom-fab-menu-item @(IsActive("/groups") ? "active" : "")" href="/groups"
               @onclick="@(() => _fabOpen = false)">
                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Class="bt-text-brand" />
                <span>Gemeinsame Ausgaben</span>
            </a>
        }
        <div class="bottom-fab-separator">Konten</div>
        <button class="bottom-fab-menu-item @(AppState.ShowingAllAccounts ? "active" : "")"
                @onclick="@(() => { AppState.SelectAccount(null); _fabOpen = false; })">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="bt-text-muted" />
            <span>Alle Konten</span>
        </button>
        @foreach (var acc in _accounts)
        {
            var fabAccId = acc.Id;
            var fabSel = AppState.SelectedAccountId == acc.Id;
            <button class="bottom-fab-menu-item @(fabSel ? "active" : "")"
                    @onclick="@(() => { SelectAccount(fabAccId); _fabOpen = false; })">
                <div style="width:10px; height:10px; border-radius:50%; background:@acc.ColorHex; flex-shrink:0;"></div>
                <span>@acc.Name</span>
            </button>
        }
    </div>
}

<nav class="bottom-nav">
    <a class="bottom-nav-item @(IsActive("/") ? "active" : "")" href="/">
        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />
        <span>Dashboard</span>
    </a>
    <a class="bottom-nav-item @(IsActive("/transactions") ? "active" : "")" href="/transactions">
        <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
        <span>Umsätze</span>
    </a>
    <div class="bottom-fab-center">
        <button class="bottom-fab-btn @(_fabOpen ? "open" : "")" @onclick="@(() => _fabOpen = !_fabOpen)">
            <MudIcon Icon="@(_fabOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" Style="color:white;" />
        </button>
    </div>
    <a class="bottom-nav-item @(IsActive("/statistics") ? "active" : "")" href="/statistics">
        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" />
        <span>Statistik</span>
    </a>
    <a class="bottom-nav-item @(IsActive("/reports") ? "active" : "")" href="/reports">
        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" />
        <span>Berichte</span>
    </a>
    <a class="bottom-nav-item @(IsActive("/settings") ? "active" : "")" href="/settings">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
        <span>Einstellungen</span>
    </a>
</nav>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private bool _drawerOpen = true;
    private List<Account> _accounts = new();
    private decimal _totalBalance;
    private Dictionary<int, decimal> _accountBalances = new();
    private bool _defaultSelected;
    private UserPreferences _prefs = new();

    // Notification bell
    private bool _showNotifPanel;
    private int _pendingCount;
    private List<GroupInvitation> _pendingInvitations = new();
    private int _currentUserId;
    private string _currentUserEmail = "";

    // Mobile FAB
    private bool _fabOpen;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#14B8A6",
            Secondary = "#0F766E",
            Background = "#171717",
            Surface = "#262626",
            DrawerBackground = "#262626",
            AppbarBackground = "#262626",
            TextPrimary = "#F5F5F5",
            TextSecondary = "#A3A3A3",
            ActionDefault = "#99F6E4",
            Divider = "#404040",
            TableLines = "#404040",
            TableHover = "#303030",
            TableStriped = "#222222",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += async () => await InvokeAsync(StateHasChanged);
        AppState.OnTransactionChanged += OnTransactionChangedHandler;
        Nav.LocationChanged += (_, _) => InvokeAsync(StateHasChanged);
        PrefsService.OnChanged += async () => { _prefs = PrefsService.Current; await InvokeAsync(StateHasChanged); };

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _currentUserEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
        if (int.TryParse(idStr, out var uid))
        {
            _currentUserId = uid;
            await PrefsService.LoadAsync(uid);
            _prefs = PrefsService.Current;
            await LoadInvitationsAsync();
            GroupNotifSvc.Register(_currentUserId, async () =>
            {
                await LoadInvitationsAsync();
                await InvokeAsync(StateHasChanged);
            });
        }

        await LoadAccountsAsync();

        // Auto-select the default account on first page load
        if (!_defaultSelected && AppState.ShowingAllAccounts)
        {
            var defaultAcc = _accounts.FirstOrDefault(a => a.IsDefault);
            if (defaultAcc != null)
                AppState.SelectAccount(defaultAcc.Id);
            _defaultSelected = true;
        }
    }

    private bool IsActive(string href)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        if (href == "/") return current == "" || current == "/";
        return current.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadAccountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts.Where(a => a.IsActive).OrderBy(a => a.Name).ToListAsync();

        decimal total = 0;
        _accountBalances.Clear();
        foreach (var acc in _accounts)
        {
            var transactions = await db.Transactions
                .Where(t => t.AccountId == acc.Id)
                .Select(t => new { t.Type, t.Amount })
                .ToListAsync();

            var income = transactions.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
            var expense = transactions.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);
            var balance = acc.InitialBalance + income - expense;
            _accountBalances[acc.Id] = balance;
            total += balance;
        }
        _totalBalance = total;
    }

    private async void OnTransactionChangedHandler()
    {
        await LoadAccountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectAccount(int accountId)
    {
        AppState.SelectAccount(accountId);
        await LoadAccountsAsync();
    }

    private void LogoutAsync() => Nav.NavigateTo("/logout", forceLoad: true);

    private async Task LoadInvitationsAsync()
    {
        if (_currentUserId == 0 && string.IsNullOrEmpty(_currentUserEmail)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        _pendingInvitations = await db.GroupInvitations
            .Include(i => i.Group)
            .Include(i => i.InvitedByUser)
            .Where(i => (i.InviteeUserId == _currentUserId || i.InviteeEmail == _currentUserEmail)
                        && i.Status == InvitationStatus.Pending)
            .OrderByDescending(i => i.CreatedAt)
            .ToListAsync();
        _pendingCount = _pendingInvitations.Count;
    }

    private async Task AcceptInvitationAsync(int invId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var inv = await db.GroupInvitations.FindAsync(invId);
        if (inv == null || inv.Status != InvitationStatus.Pending) return;

        inv.Status = InvitationStatus.Accepted;
        inv.InviteeUserId = _currentUserId;
        inv.RespondedAt = DateTime.UtcNow;

        // Check not already member
        var alreadyMember = await db.GroupMembers
            .AnyAsync(m => m.GroupId == inv.GroupId && m.UserId == _currentUserId);
        if (!alreadyMember)
        {
            db.GroupMembers.Add(new GroupMember
            {
                GroupId = inv.GroupId,
                UserId = _currentUserId,
                JoinedAt = DateTime.UtcNow
            });
        }
        await db.SaveChangesAsync();
        await LoadInvitationsAsync();
        _showNotifPanel = _pendingInvitations.Any();
        AppState.NotifyGroupsChanged();
    }

    private async Task DeclineInvitationAsync(int invId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var inv = await db.GroupInvitations.FindAsync(invId);
        if (inv == null) return;
        inv.Status = InvitationStatus.Declined;
        inv.RespondedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        await LoadInvitationsAsync();
        _showNotifPanel = _pendingInvitations.Any();
    }

    public void Dispose()
    {
        AppState.OnTransactionChanged -= OnTransactionChangedHandler;
        GroupNotifSvc.Unregister(_currentUserId);
    }
}
