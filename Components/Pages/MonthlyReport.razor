@page "/reports"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IJSRuntime JS

<PageTitle>Berichte – Budget Tracker</PageTitle>


<!-- Print-only header -->
<div class="print-header" style="margin-bottom:16px; border-bottom:2px solid #14B8A6; padding-bottom:8px;">
    <h2 style="margin:0; color:#1f1f1f;">Budget Tracker – @_reportTitle</h2>
    <p style="margin:4px 0 0; color:#555; font-size:13px;">Erstellt am @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
</div>

<!-- Page header -->
<div class="no-print" style="display:flex; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:24px;">
    <MudText Typo="Typo.h5" Class="bt-section-heading bt-section-heading--brand">Berichte</MudText>
    <MudSpacer />
    <!-- Pill mode toggle -->
    <div class="report-mode-toggle">
        <button class="report-mode-btn @(!_customRange ? "active" : "")"
                @onclick='() => { _customRange = false; _ = ApplyMonthRangeAndLoadAsync(); }'>
            Monatsansicht
        </button>
        <button class="report-mode-btn @(_customRange ? "active" : "")"
                @onclick="() => { _customRange = true; StateHasChanged(); }">
            Zeitraum
        </button>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
               OnClick="PrintReportAsync">PDF exportieren</MudButton>
</div>

<!-- Controls -->
@if (!_customRange)
{
    <!-- Month navigation -->
    <div class="no-print" style="display:flex; align-items:center; gap:8px; margin-bottom:20px;">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PrevMonth" />
        <MudText Typo="Typo.h6" Style="color:#F5F5F5; min-width:180px; text-align:center;">
            @_reportFrom.ToString("MMMM yyyy", _de)
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth"
                       Disabled="@(_reportFrom.Year == DateTime.Today.Year && _reportFrom.Month >= DateTime.Today.Month)" />
        @if (_reportFrom.Year != DateTime.Today.Year || _reportFrom.Month != DateTime.Today.Month)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                       OnClick="GoToTodayAsync" Style="height:34px; padding:0 14px; font-size:12px; margin-left:4px;">
                Heute
            </MudButton>
        }
    </div>
}
else
{
    <!-- Custom date range -->
    <div class="no-print" style="margin-bottom:20px;">
        <!-- Quick select presets -->
        <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px;">
            <button class="date-preset-btn @(_activePreset == "thismonth" ? "active" : "")" @onclick='() => ApplyPresetAsync("thismonth")'>Dieser Monat</button>
            <button class="date-preset-btn @(_activePreset == "lastmonth" ? "active" : "")" @onclick='() => ApplyPresetAsync("lastmonth")'>Letzter Monat</button>
            <button class="date-preset-btn @(_activePreset == "last30" ? "active" : "")" @onclick='() => ApplyPresetAsync("last30")'>Letzte 30 Tage</button>
            <button class="date-preset-btn @(_activePreset == "last90" ? "active" : "")" @onclick='() => ApplyPresetAsync("last90")'>Letzte 90 Tage</button>
            <button class="date-preset-btn @(_activePreset == "thisquarter" ? "active" : "")" @onclick='() => ApplyPresetAsync("thisquarter")'>Dieses Quartal</button>
            <button class="date-preset-btn @(_activePreset == "lastquarter" ? "active" : "")" @onclick='() => ApplyPresetAsync("lastquarter")'>Letztes Quartal</button>
            <button class="date-preset-btn @(_activePreset == "thisyear" ? "active" : "")" @onclick='() => ApplyPresetAsync("thisyear")'>Dieses Jahr</button>
            <button class="date-preset-btn @(_activePreset == "lastyear" ? "active" : "")" @onclick='() => ApplyPresetAsync("lastyear")'>Vorjahr</button>
        </div>
        <!-- Manual date pickers -->
        <div style="display:flex; align-items:center; gap:12px;">
            <MudDatePicker Label="Von" Date="_customFrom" DateChanged="OnCustomFromChanged" Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy" Style="width:160px;" />
            <MudDatePicker Label="Bis" Date="_customTo" DateChanged="OnCustomToChanged" Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy" Style="width:160px;" />
        </div>
    </div>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
}
else
{
    <!-- Report title line (visible on screen and in print) -->
    <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; margin-bottom:16px;">@_reportTitle</MudText>

    <!-- KPI summary cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-border-income" Style="background:#242424; border:1px solid #404040; border-left:3px solid #66BB6A; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Class="bt-text-muted">Einnahmen</MudText>
                <MudText Typo="Typo.h6" Class="bt-text-success" Style="font-weight:700;">@_income.ToString("C2", _de)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-border-expense" Style="background:#242424; border:1px solid #404040; border-left:3px solid #EF5350; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Class="bt-text-muted">Ausgaben</MudText>
                <MudText Typo="Typo.h6" Class="bt-text-error" Style="font-weight:700;">@_expenses.ToString("C2", _de)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-border-net" Style="background:#242424; border:1px solid #404040; border-left:3px solid #14B8A6; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Class="bt-text-muted">Netto</MudText>
                <MudText Typo="Typo.h6" Style="@($"color:{(_net >= 0 ? "#66BB6A" : "#EF5350")}; font-weight:700;")">
                    @(_net >= 0 ? "+" : "")@_net.ToString("C2", _de)
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Style="background:#242424; border:1px solid #404040; border-left:3px solid #A3A3A3; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Class="bt-text-muted">Transaktionen</MudText>
                <MudText Typo="Typo.h6" Style="color:#F5F5F5; font-weight:700;">@_transactions.Count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <!-- Category breakdown table — equal height with Top-Ausgaben -->
        <MudItem xs="12" md="6" Style="display:flex;">
            <MudPaper Style="flex:1; background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; display:flex; flex-direction:column;">
                <div style="padding:16px; flex-shrink:0;">
                    <MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Ausgaben nach Kategorie</MudText>
                </div>
                <MudDivider Style="border-color:#404040;" />
                @if (!_categoryStats.Any())
                {
                    <div style="padding:16px; flex:1;">
                        <MudText Class="bt-pad-muted-italic">Keine Daten</MudText>
                    </div>
                }
                else
                {
                    <div style="flex:1; overflow:auto;">
                    <div class="mr-table-scroll">
                    <MudTable Items="_categoryStats" Dense="true" Hover="true" Striped="true" Elevation="0"
                              Style="background:transparent;">
                        <HeaderContent>
                            <MudTh Class="bt-text-muted" Style="font-weight:600;">Kategorie</MudTh>
                            <MudTh Style="color:#A3A3A3; font-weight:600; text-align:right;">Transakt.</MudTh>
                            <MudTh Style="color:#A3A3A3; font-weight:600; text-align:right;">Gesamt</MudTh>
                            <MudTh Style="color:#A3A3A3; font-weight:600; text-align:right;">Anteil</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <div class="category-dot" style="width:10px; height:10px; border-radius:50%; background:@context.ColorHex; flex-shrink:0; -webkit-print-color-adjust:exact;"></div>
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                </div>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <MudText Typo="Typo.body2" Class="bt-text-muted">@context.Count</MudText>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <MudText Typo="Typo.body2" Class="bt-text-error" Style="font-weight:600;">@context.Total.ToString("C2", _de)</MudText>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <MudText Typo="Typo.body2" Class="bt-text-muted">@context.Share.ToString("P0")</MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    </div>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- Top-Ausgaben visual bars — equal height with category table -->
        <MudItem xs="12" md="6" Style="display:flex;">
            <MudPaper Style="flex:1; background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; display:flex; flex-direction:column;">
                <div style="padding:16px; flex-shrink:0;">
                    <MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Top-Ausgaben</MudText>
                </div>
                <MudDivider Style="border-color:#404040;" />
                <div style="padding:16px; flex:1;">
                    @if (!_categoryStats.Any())
                    {
                        <MudText Class="bt-pad-muted-italic">Keine Ausgaben im Zeitraum</MudText>
                    }
                    @foreach (var cs in _categoryStats.Take(8))
                    {
                        var barWidth = _expenses > 0 ? (double)(cs.Total / _expenses) * 100 : 0;
                        <div style="margin-bottom:14px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                                <div style="display:flex; align-items:center; gap:8px; overflow:hidden; flex:1; min-width:0;">
                                    <div style="width:10px; height:10px; border-radius:50%; background:@cs.ColorHex; flex-shrink:0;"></div>
                                    <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cs.Name</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="color:#EF5350; font-weight:600; white-space:nowrap; margin-left:8px;">@cs.Total.ToString("C2", _de)</MudText>
                            </div>
                            <div style="height:5px; background:#404040; border-radius:3px; overflow:hidden;">
                                <div class="category-dot" style="height:100%; width:@(barWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background:@cs.ColorHex; border-radius:3px; -webkit-print-color-adjust:exact;"></div>
                            </div>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- Biggest income transactions -->
        @if (_topIncomeTransactions.Any())
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="bt-panel">
                    <div style="padding:16px;">
                        <MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Größte Einnahmen</MudText>
                    </div>
                    <MudDivider Style="border-color:#404040;" />
                    <div class="mr-table-scroll">
                    <MudTable Items="_topIncomeTransactions" Dense="true" Hover="true" Elevation="0" Style="background:transparent;">
                        <HeaderContent>
                            <MudTh Class="bt-text-muted">Datum</MudTh>
                            <MudTh Class="bt-text-muted">Notiz</MudTh>
                            <MudTh Style="color:#A3A3A3; text-align:right;">Betrag</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudText Typo="Typo.body2" Class="bt-text-muted">@context.Date.ToString("dd.MM.", _de)</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Note ?? context.Category?.Name ?? "–")</MudText></MudTd>
                            <MudTd Style="text-align:right;"><MudText Typo="Typo.body2" Class="bt-text-success" Style="font-weight:600;">+@context.Amount.ToString("C2", _de)</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                    </div>
                </MudPaper>
            </MudItem>
        }

        <!-- Biggest expense transactions -->
        @if (_topExpenseTransactions.Any())
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="bt-panel">
                    <div style="padding:16px;">
                        <MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Größte Ausgaben</MudText>
                    </div>
                    <MudDivider Style="border-color:#404040;" />
                    <div class="mr-table-scroll">
                    <MudTable Items="_topExpenseTransactions" Dense="true" Hover="true" Elevation="0" Style="background:transparent;">
                        <HeaderContent>
                            <MudTh Class="bt-text-muted">Datum</MudTh>
                            <MudTh Class="bt-text-muted">Notiz</MudTh>
                            <MudTh Style="color:#A3A3A3; text-align:right;">Betrag</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudText Typo="Typo.body2" Class="bt-text-muted">@context.Date.ToString("dd.MM.", _de)</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Note ?? context.Category?.Name ?? "–")</MudText></MudTd>
                            <MudTd Style="text-align:right;"><MudText Typo="Typo.body2" Class="bt-text-error" Style="font-weight:600;">-@context.Amount.ToString("C2", _de)</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                    </div>
                </MudPaper>
            </MudItem>
        }

        <!-- Full transaction list -->
        <MudItem xs="12">
            @if (AppState.ShowingAllAccounts && _allAccounts.Count > 1)
            {
                @* Group by account with page-break per account *@
                var accountsWithTx = _allAccounts.Where(a => _transactions.Any(t => t.AccountId == a.Id)).ToList();
                @for (int ai = 0; ai < accountsWithTx.Count; ai++)
                {
                    var acc = accountsWithTx[ai];
                    var accTx = _transactions.Where(t => t.AccountId == acc.Id).OrderByDescending(t => t.Date).ThenByDescending(t => t.Id).ToList();
                    var accIncome = accTx.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
                    var accExpense = accTx.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);
                    var isFirst = ai == 0;
                    <div class="@(!isFirst ? "account-page-break" : "")" style="@(!isFirst ? "margin-top:32px;" : "")">
                        <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                            <div style="width:14px; height:14px; border-radius:50%; background:@acc.ColorHex; flex-shrink:0; -webkit-print-color-adjust:exact; print-color-adjust:exact;"></div>
                            <MudText Typo="Typo.subtitle1" Style="@($"color:{acc.ColorHex}; font-weight:700;")">@acc.Name</MudText>
                            <MudText Typo="Typo.caption" Style="color:#A3A3A3; margin-left:4px;">
                                Einnahmen: <span style="color:#66BB6A; font-weight:600;">+@accIncome.ToString("C2", _de)</span>
                                &nbsp;·&nbsp;
                                Ausgaben: <span style="color:#EF5350; font-weight:600;">-@accExpense.ToString("C2", _de)</span>
                            </MudText>
                        </div>
                        <MudPaper Class="bt-panel mb-2">
                            @if (!accTx.Any())
                            {
                                <div style="padding:16px;"><MudText Class="bt-pad-muted-italic">Keine Transaktionen</MudText></div>
                            }
                            else
                            {
                                <div class="mr-tx-desktop mr-table-scroll">
                                <MudTable Items="accTx" Dense="true" Hover="true" Striped="true" Elevation="0" Style="background:transparent;">
                                    <HeaderContent>
                                        <MudTh Class="bt-text-muted">Datum</MudTh>
                                        <MudTh Class="bt-text-muted">Kategorie</MudTh>
                                        <MudTh Class="bt-text-muted">Notiz</MudTh>
                                        <MudTh Style="color:#A3A3A3; text-align:right;">Betrag</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd><MudText Typo="Typo.body2" Class="bt-text-muted">@context.Date.ToString("dd.MM.yyyy", _de)</MudText></MudTd>
                                        <MudTd>
                                            @if (context.Category != null)
                                            {
                                                <div style="display:flex; align-items:center; gap:6px;">
                                                    <div class="category-dot" style="width:8px; height:8px; border-radius:50%; background:@context.Category.ColorHex; flex-shrink:0; -webkit-print-color-adjust:exact;"></div>
                                                    <MudText Typo="Typo.body2">@context.Category.Name</MudText>
                                                </div>
                                            }
                                            else { <MudText Typo="Typo.body2" Class="bt-text-muted">–</MudText> }
                                        </MudTd>
                                        <MudTd><MudText Typo="Typo.body2">@(context.Note ?? "–")</MudText></MudTd>
                                        <MudTd Style="text-align:right;">
                                            <MudText Typo="Typo.body2"
                                                     Style="@($"color:{(context.Type == TransactionType.Income ? "#66BB6A" : "#EF5350")}; font-weight:600;")">
                                                @(context.Type == TransactionType.Income ? "+" : "-")@context.Amount.ToString("C2", _de)
                                            </MudText>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                                </div>
                                <div class="mr-tx-mobile">
                                    @foreach (var tx in accTx)
                                    {
                                        var txIncome = tx.Type == TransactionType.Income;
                                        <div class="mr-tx-card">
                                            <div class="mr-tx-bar" style="background:@(txIncome ? "#66BB6A" : "#EF5350");"></div>
                                            <div class="mr-tx-info">
                                                <div class="mr-tx-desc">@(tx.Note ?? tx.Category?.Name ?? "–")</div>
                                                <div class="mr-tx-meta">@tx.Date.ToString("dd.MM.yyyy", _de)@(tx.Category != null ? $" · {tx.Category.Name}" : "")</div>
                                            </div>
                                            <div class="mr-tx-amount" style="color:@(txIncome ? "#66BB6A" : "#EF5350");">
                                                @(txIncome ? "+" : "-")@tx.Amount.ToString("C2", _de)
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </MudPaper>
                    </div>
                }
            }
            else
            {
                <MudPaper Class="bt-panel">
                    <div style="padding:16px;">
                        <MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Alle Transaktionen</MudText>
                    </div>
                    <MudDivider Style="border-color:#404040;" />
                    @if (!_transactions.Any())
                    {
                        <div style="padding:16px;">
                            <MudText Class="bt-pad-muted-italic">Keine Transaktionen im ausgewählten Zeitraum</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="mr-tx-desktop mr-table-scroll">
                        <MudTable Items="_transactions.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id)"
                                  Dense="true" Hover="true" Striped="true" Elevation="0" Style="background:transparent;">
                            <HeaderContent>
                                <MudTh Class="bt-text-muted">Datum</MudTh>
                                <MudTh Class="bt-text-muted">Kategorie</MudTh>
                                <MudTh Class="bt-text-muted">Notiz</MudTh>
                                <MudTh Style="color:#A3A3A3; text-align:right;">Betrag</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><MudText Typo="Typo.body2" Class="bt-text-muted">@context.Date.ToString("dd.MM.yyyy", _de)</MudText></MudTd>
                                <MudTd>
                                    @if (context.Category != null)
                                    {
                                        <div style="display:flex; align-items:center; gap:6px;">
                                            <div class="category-dot" style="width:8px; height:8px; border-radius:50%; background:@context.Category.ColorHex; flex-shrink:0; -webkit-print-color-adjust:exact;"></div>
                                            <MudText Typo="Typo.body2">@context.Category.Name</MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Class="bt-text-muted">–</MudText>
                                    }
                                </MudTd>
                                <MudTd><MudText Typo="Typo.body2">@(context.Note ?? "–")</MudText></MudTd>
                                <MudTd Style="text-align:right;">
                                    <MudText Typo="Typo.body2"
                                             Style="@($"color:{(context.Type == TransactionType.Income ? "#66BB6A" : "#EF5350")}; font-weight:600;")">
                                        @(context.Type == TransactionType.Income ? "+" : "-")@context.Amount.ToString("C2", _de)
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        </div>
                        <div class="mr-tx-mobile">
                            @foreach (var t in _transactions.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id))
                            {
                                var isIncome = t.Type == TransactionType.Income;
                                <div class="mr-tx-card">
                                    <div class="mr-tx-bar" style="background:@(isIncome ? "#66BB6A" : "#EF5350");"></div>
                                    <div class="mr-tx-info">
                                        <div class="mr-tx-desc">@(t.Note ?? t.Category?.Name ?? "–")</div>
                                        <div class="mr-tx-meta">@t.Date.ToString("dd.MM.yyyy", _de)@(t.Category != null ? $" · {t.Category.Name}" : "")</div>
                                    </div>
                                    <div class="mr-tx-amount" style="color:@(isIncome ? "#66BB6A" : "#EF5350");">
                                        @(isIncome ? "+" : "-")@t.Amount.ToString("C2", _de)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading;
    private bool _customRange;

    // Month view state
    private DateTime _reportFrom;
    private DateTime _reportTo;

    // Custom range pickers
    private DateTime? _customFrom;
    private DateTime? _customTo;
    private string? _activePreset;

    // Report data
    private List<Transaction> _transactions = new();
    private List<Account> _allAccounts = new();
    private decimal _income;
    private decimal _expenses;
    private decimal _net;
    private List<CategoryStat> _categoryStats = new();
    private List<Transaction> _topExpenseTransactions = new();
    private List<Transaction> _topIncomeTransactions = new();

    private string _reportTitle = "";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += OnAccountChangedHandler;
        // Default: current month
        _reportFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        ApplyMonthRange();
        await LoadAsync();
    }

    private async void OnAccountChangedHandler()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyMonthRange()
    {
        _reportTo = _reportFrom.AddMonths(1).AddDays(-1);
        _reportTitle = $"Monatsbericht {_reportFrom.ToString("MMMM yyyy", _de)}";
    }

    private async Task PrevMonth()
    {
        _reportFrom = _reportFrom.AddMonths(-1);
        ApplyMonthRange();
        await LoadAsync();
    }

    private async Task NextMonth()
    {
        _reportFrom = _reportFrom.AddMonths(1);
        ApplyMonthRange();
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        _reportFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        ApplyMonthRange();
        await LoadAsync();
    }

    // Called from pill toggle onClick to also reload after switching back to month view
    private async Task ApplyMonthRangeAndLoadAsync()
    {
        ApplyMonthRange();
        await LoadAsync();
    }

    private async Task ApplyPresetAsync(string key)
    {
        var today = DateTime.Today;
        var (from, to) = key switch
        {
            "thismonth"   => (new DateTime(today.Year, today.Month, 1),
                              new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month))),
            "lastmonth"   => (new DateTime(today.Year, today.Month, 1).AddMonths(-1),
                              new DateTime(today.Year, today.Month, 1).AddDays(-1)),
            "last30"      => (today.AddDays(-29), today),
            "last90"      => (today.AddDays(-89), today),
            "thisquarter" => GetCurrentQuarterRange(today),
            "lastquarter" => GetLastQuarterRange(today),
            "thisyear"    => (new DateTime(today.Year, 1, 1), new DateTime(today.Year, 12, 31)),
            "lastyear"    => (new DateTime(today.Year - 1, 1, 1), new DateTime(today.Year - 1, 12, 31)),
            _             => (today, today)
        };
        _activePreset = key;
        _customFrom = from;
        _customTo = to;
        await ApplyCustomRangeAsync();
    }

    private static (DateTime, DateTime) GetCurrentQuarterRange(DateTime d)
    {
        var start = new DateTime(d.Year, (d.Month - 1) / 3 * 3 + 1, 1);
        return (start, start.AddMonths(3).AddDays(-1));
    }

    private static (DateTime, DateTime) GetLastQuarterRange(DateTime d)
    {
        var start = new DateTime(d.Year, (d.Month - 1) / 3 * 3 + 1, 1).AddMonths(-3);
        return (start, start.AddMonths(3).AddDays(-1));
    }

    private async Task OnCustomFromChanged(DateTime? d)
    {
        _customFrom = d;
        _activePreset = null;
        await ApplyCustomRangeAsync();
    }

    private async Task OnCustomToChanged(DateTime? d)
    {
        _customTo = d;
        _activePreset = null;
        await ApplyCustomRangeAsync();
    }

    private async Task ApplyCustomRangeAsync()
    {
        if (_customFrom == null || _customTo == null) return;
        _reportFrom = _customFrom.Value.Date;
        _reportTo = _customTo.Value.Date;
        _reportTitle = $"Bericht {_reportFrom:dd.MM.yyyy} – {_reportTo:dd.MM.yyyy}";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await using var db = await DbFactory.CreateDbContextAsync();

        var from = _reportFrom;
        var to = _reportTo.AddDays(1); // exclusive upper bound

        var query = db.Transactions
            .Include(t => t.Category)
            .Include(t => t.Account)
            .Where(t => t.Date >= from && t.Date < to);

        // Filter by selected account if applicable
        if (!AppState.ShowingAllAccounts && AppState.SelectedAccountId.HasValue)
            query = query.Where(t => t.AccountId == AppState.SelectedAccountId.Value);

        _transactions = await query.ToListAsync();

        // Load all active accounts for grouping header in all-accounts view
        _allAccounts = await db.Accounts.Where(a => a.IsActive).OrderBy(a => a.Name).ToListAsync();

        _income = _transactions.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
        _expenses = _transactions.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);
        _net = _income - _expenses;

        // Category stats (expenses only, sorted by total desc)
        _categoryStats = _transactions
            .Where(t => t.Type == TransactionType.Expense)
            .GroupBy(t => new { Name = t.Category?.Name ?? "Ohne Kategorie", ColorHex = t.Category?.ColorHex ?? "#78909C" })
            .Select(g => new CategoryStat
            {
                Name = g.Key.Name,
                ColorHex = g.Key.ColorHex,
                Count = g.Count(),
                Total = g.Sum(t => t.Amount),
                Share = _expenses > 0 ? g.Sum(t => t.Amount) / _expenses : 0
            })
            .OrderByDescending(cs => cs.Total)
            .ToList();

        // Top 5 transactions by type
        _topExpenseTransactions = _transactions
            .Where(t => t.Type == TransactionType.Expense)
            .OrderByDescending(t => t.Amount)
            .Take(5)
            .ToList();

        _topIncomeTransactions = _transactions
            .Where(t => t.Type == TransactionType.Income)
            .OrderByDescending(t => t.Amount)
            .Take(5)
            .ToList();

        _loading = false;
        StateHasChanged();
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private record CategoryStat
    {
        public string Name { get; init; } = "";
        public string ColorHex { get; init; } = "#9E9E9E";
        public int Count { get; init; }
        public decimal Total { get; init; }
        public decimal Share { get; init; }
    }

    public void Dispose() => AppState.OnAccountChanged -= OnAccountChangedHandler;
}
