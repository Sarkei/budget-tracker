@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService
@inject UserPreferencesService PrefsService
<PageTitle>Übersicht – Budget Tracker</PageTitle>

<AuthorizeView>
    <Authorized>
        @{
            var displayName = context.User.FindFirst("DisplayName")?.Value
                ?? context.User.Identity?.Name?.Split('@')[0]
                ?? "du";
            var firstName = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? displayName;
        }

        <section class="app-hero">
            <div class="app-container">
                <span class="app-badge">Übersicht · @DateTime.Today.ToString("MMMM yyyy", _de)</span>
                <h1 class="app-title">Guten Tag, @firstName.</h1>
                <p class="app-lede">
                    Saldo, Buchungen und die nächsten Zahlungen auf einen Blick – alles, was dein
                    Budget gerade bewegt.
                </p>
                <div class="app-hero__actions">
                    <button type="button" class="ui-btn ui-btn-primary" style="border-radius:999px;" @onclick="AddIncomeAsync">
                        Einnahme erfassen
                    </button>
                    <button type="button" class="ui-btn" style="border-radius:999px;" @onclick="AddExpenseAsync">
                        Ausgabe erfassen
                    </button>
                    @if (_prefs.ShowScheduledPayments)
                    {
                        <button type="button" class="ui-btn" style="border-radius:999px;" @onclick="AddScheduledPaymentAsync">
                            Zahlung planen
                        </button>
                    }
                </div>
            </div>
        </section>

        <div class="app-container">
            @if (_loading)
            {
                <div class="stat-row">
                    <div class="stat"><div class="stat__value">–</div><div class="stat__label">wird geladen</div></div>
                    <div class="stat"><div class="stat__value">–</div><div class="stat__label">wird geladen</div></div>
                    <div class="stat"><div class="stat__value">–</div><div class="stat__label">wird geladen</div></div>
                    <div class="stat"><div class="stat__value">–</div><div class="stat__label">wird geladen</div></div>
                </div>
            }
            else
            {
                <dl class="stat-row">
                    <div class="stat">
                        <dt class="stat__value @(_currentBalance < 0 ? "stat__value--negative" : "")">
                            @_currentBalance.ToString("C2", _de)
                        </dt>
                        <dd class="stat__label">Saldo</dd>
                    </div>
                    <div class="stat">
                        <dt class="stat__value">@_transactionCount</dt>
                        <dd class="stat__label">Buchungen</dd>
                    </div>
                    <div class="stat">
                        <dt class="stat__value">@_accountCount</dt>
                        <dd class="stat__label">Konten</dd>
                    </div>
                    <div class="stat">
                        <dt class="stat__value">@_categoryCount</dt>
                        <dd class="stat__label">Kategorien</dd>
                    </div>
                </dl>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <section class="app-hero">
            <div class="app-container">
                <span class="app-badge">Übersicht</span>
                <h1 class="app-title">Budget Tracker</h1>
                <p class="app-lede">Bitte melde dich an, um deine Finanzen zu sehen.</p>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

<section class="app-section">
    <div class="app-container">
        <div class="app-section__head">
            <h2 class="app-section__title">Bereiche</h2>
            <span class="app-section__note">Alles, was du regelmäßig brauchst.</span>
        </div>
        <div class="app-grid app-grid--three">
            @foreach (var area in Areas())
            {
                <a class="app-card app-card--link" href="@area.Href">
                    <div class="app-card__top">
                        <span class="app-card__icon material-icons" aria-hidden="true">@area.Icon</span>
                        <span class="app-card__arrow" aria-hidden="true">→</span>
                    </div>
                    <h3 class="app-card__title">@area.Title</h3>
                    <p class="app-card__text">@area.Text</p>
                </a>
            }
        </div>
    </div>
</section>

<section class="app-band app-section">
    <div class="app-container">
        <div class="app-section__head">
            <h2 class="app-section__title">Zuletzt passiert</h2>
            <span class="app-section__note">
                @if (!_loading)
                {
                    <text>@_monthName: @_monthlyIncome.ToString("C2", _de) ein · @_monthlyExpenses.ToString("C2", _de) aus</text>
                }
            </span>
        </div>
        <div class="app-grid">
            <div class="app-card">
                <div class="app-card__top">
                    <span class="app-card__icon material-icons" aria-hidden="true">receipt_long</span>
                    <a class="app-nav-item" href="/transactions">Alle ansehen →</a>
                </div>
                <h3 class="app-card__title">Letzte Buchungen</h3>
                @if (_loading)
                {
                    <p class="app-empty">Buchungen werden geladen …</p>
                }
                else if (_recentTransactions.Count == 0)
                {
                    <p class="app-empty">Noch keine Buchungen erfasst.</p>
                    <button type="button" class="ui-btn ui-btn-primary" style="border-radius:999px; margin-top:8px;"
                            @onclick="AddExpenseAsync">Erste Ausgabe erfassen</button>
                }
                else
                {
                    <div class="app-list">
                        @foreach (var t in _recentTransactions)
                        {
                            var isIncome = t.Type == TransactionType.Income;
                            <div class="app-row">
                                <span class="app-row__dot @(isIncome ? "" : "app-row__dot--out")"></span>
                                <div class="app-row__main">
                                    <div class="app-row__title">@(t.Note ?? t.Category?.Name ?? "Buchung")</div>
                                    <div class="app-row__meta">
                                        @t.Date.ToString("dd.MM.yyyy") · @(t.Account?.Name ?? "Konto")
                                    </div>
                                </div>
                                <span class="app-row__amount @(isIncome ? "app-row__amount--in" : "app-row__amount--out")">
                                    @(isIncome ? "+" : "−")@t.Amount.ToString("C2", _de)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="app-card">
                <div class="app-card__top">
                    <span class="app-card__icon material-icons" aria-hidden="true">event</span>
                    <a class="app-nav-item" href="/scheduled">Alle ansehen →</a>
                </div>
                <h3 class="app-card__title">Nächste Zahlungen</h3>
                @if (_loading)
                {
                    <p class="app-empty">Zahlungen werden geladen …</p>
                }
                else if (_upcomingPayments.Count == 0)
                {
                    <p class="app-empty">In den nächsten 30 Tagen ist nichts fällig.</p>
                }
                else
                {
                    <div class="app-list">
                        @foreach (var p in _upcomingPayments)
                        {
                            var daysLeft = (p.DueDate - DateTime.Today).Days;
                            <div class="app-row">
                                <span class="app-row__dot"></span>
                                <div class="app-row__main">
                                    <div class="app-row__title">@p.Name</div>
                                    <div class="app-row__meta">
                                        @p.DueDate.ToString("dd.MM.yyyy") ·
                                        @(daysLeft <= 0 ? "heute fällig" : daysLeft == 1 ? "morgen" : $"in {daysLeft} Tagen")
                                    </div>
                                </div>
                                <span class="app-row__amount">@p.Amount.ToString("C2", _de)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading = true;
    private decimal _currentBalance;
    private decimal _monthlyIncome;
    private decimal _monthlyExpenses;
    private int _transactionCount;
    private int _accountCount;
    private int _categoryCount;
    private string _monthName = DateTime.Today.ToString("MMMM", _de);
    private List<Transaction> _recentTransactions = new();
    private List<ScheduledPayment> _upcomingPayments = new();
    private UserPreferences _prefs = new();

    private record AreaItem(string Title, string Href, string Icon, string Text);

    private List<AreaItem> Areas()
    {
        var items = new List<AreaItem>
        {
            new("Buchungen", "/transactions", "receipt_long",
                "Einnahmen und Ausgaben erfassen, filtern und bearbeiten."),
        };
        if (_prefs.ShowRecurring)
            items.Add(new("Wiederkehrend", "/recurring", "repeat",
                "Feste Beträge, die Monat für Monat wiederkehren."));
        if (_prefs.ShowScheduledPayments)
            items.Add(new("Geplante Zahlungen", "/scheduled", "event",
                "Was in den nächsten Wochen fällig wird."));
        if (_prefs.ShowSavingsPots)
            items.Add(new("Spartöpfe", "/savings", "savings",
                "Ziele anlegen und den Fortschritt verfolgen."));
        if (_prefs.ShowGroups)
            items.Add(new("Gemeinsame Ausgaben", "/groups", "group",
                "Ausgaben teilen und offene Beträge ausgleichen."));
        items.Add(new("Auswertung", "/statistics", "insights",
            "Monatsvergleich und Kategorien im Detail."));
        items.Add(new("Finanzübersicht", "/finance-overview", "pie_chart",
            "Vermögen, Verbindlichkeiten und Netto auf einen Blick."));
        items.Add(new("Kontoauszug", "/bank-analysis", "account_balance",
            "Importierte Bankumsätze prüfen und zuordnen."));
        items.Add(new("Berichte", "/reports", "bar_chart",
            "Monatsberichte lesen und auswerten."));
        items.Add(new("Einstellungen", "/settings", "settings",
            "Konten, Kategorien und Darstellung verwalten."));
        return items;
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += OnAccountChanged;
        PrefsService.OnChanged += OnPreferencesChanged;
        _prefs = PrefsService.Current;
        await LoadAsync();
    }

    private async void OnPreferencesChanged()
    {
        _prefs = PrefsService.Current;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAccountChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        int? accountId = AppState.SelectedAccountId;

        var accounts = await db.Accounts.Where(a => a.IsActive).ToListAsync();
        _accountCount = accounts.Count;

        var txQuery = db.Transactions.AsQueryable();
        if (accountId.HasValue) txQuery = txQuery.Where(t => t.AccountId == accountId.Value);

        var txSums = await txQuery
            .Select(t => new { t.Type, t.Amount })
            .ToListAsync();

        var income = txSums.Where(s => s.Type == TransactionType.Income).Sum(s => s.Amount);
        var expense = txSums.Where(s => s.Type == TransactionType.Expense).Sum(s => s.Amount);
        _transactionCount = txSums.Count;

        var initialBalance = accountId.HasValue
            ? accounts.Where(a => a.Id == accountId.Value).Sum(a => a.InitialBalance)
            : accounts.Sum(a => a.InitialBalance);
        _currentBalance = initialBalance + income - expense;

        var now = DateTime.Today;
        var monthStart = new DateTime(now.Year, now.Month, 1);
        _monthName = now.ToString("MMMM", _de);

        var monthTx = await txQuery
            .Where(t => t.Date >= monthStart && t.Date < monthStart.AddMonths(1))
            .Select(t => new { t.Type, t.Amount })
            .ToListAsync();
        _monthlyIncome = monthTx.Where(s => s.Type == TransactionType.Income).Sum(s => s.Amount);
        _monthlyExpenses = monthTx.Where(s => s.Type == TransactionType.Expense).Sum(s => s.Amount);

        _categoryCount = await db.Categories.CountAsync();

        _recentTransactions = await txQuery
            .Include(t => t.Category)
            .Include(t => t.Account)
            .OrderByDescending(t => t.Date)
            .ThenByDescending(t => t.CreatedAt)
            .Take(6)
            .ToListAsync();

        var cutoff = now.AddDays(30);
        var scheduledQuery = db.ScheduledPayments
            .Where(s => !s.IsPaid && s.DueDate <= cutoff)
            .OrderBy(s => s.DueDate)
            .AsQueryable();
        if (accountId.HasValue) scheduledQuery = scheduledQuery.Where(s => s.AccountId == accountId.Value);
        _upcomingPayments = await scheduledQuery.Take(5).ToListAsync();

        _loading = false;
    }

    private async Task AddIncomeAsync()
    {
        var parameters = new DialogParameters { ["IsExpense"] = false, ["HasTypePreset"] = true, ["AccountId"] = AppState.SelectedAccountId };
        var dialog = await DialogService.ShowAsync<TransactionDialog>("Einnahme hinzufügen", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private async Task AddExpenseAsync()
    {
        var parameters = new DialogParameters { ["IsExpense"] = true, ["HasTypePreset"] = true, ["AccountId"] = AppState.SelectedAccountId };
        var dialog = await DialogService.ShowAsync<TransactionDialog>("Ausgabe hinzufügen", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    private async Task AddScheduledPaymentAsync()
    {
        var parameters = new DialogParameters { ["AccountId"] = AppState.SelectedAccountId };
        var dialog = await DialogService.ShowAsync<ScheduledPaymentDialog>("Geplante Zahlung hinzufügen", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadAsync();
    }

    public void Dispose()
    {
        AppState.OnAccountChanged -= OnAccountChanged;
        PrefsService.OnChanged -= OnPreferencesChanged;
    }
}
