@page "/groups/{Slug}"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject GroupNotificationService GroupNotifSvc

<PageTitle>Gruppe - Budget Tracker</PageTitle>

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
}
else if (_group == null)
{
    <MudText Class="bt-text-muted">Gruppe nicht gefunden.</MudText>
}
else
{
    <!-- Header -->
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="GoBack" />
        <div style="flex:1; min-width:0;">
            <MudText Typo="Typo.h5" Class="bt-section-heading bt-section-heading--brand">@_group.Name</MudText>
            @if (!string.IsNullOrEmpty(_group.Description))
            {
                <MudText Typo="Typo.caption" Class="bt-text-muted">@_group.Description</MudText>
            }
        </div>
        <div class="gd-header-actions">
            @if (_isAdmin)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="EditGroupAsync">Bearbeiten</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       OnClick="@(() => Nav.NavigateTo($"/groups/{Slug}/report"))">
                Bericht
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Group"
                       OnClick="ShowMembersDialogAsync">Mitglieder</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportHistoryAsync">Import</MudButton>
            <MudMenu Label="Hinzufügen" StartIcon="@Icons.Material.Filled.Add"
                     Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.TrendingUp" IconColor="Color.Success"
                             OnClick="AddIncomeAsync">+ Einnahme</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.TrendingDown" IconColor="Color.Error"
                             OnClick="AddExpenseAsync">- Ausgabe</MudMenuItem>
            </MudMenu>
        </div>
    </div>

    <!-- My balance summary (highlighted) -->
    <MudPaper Style="@($"background:#242424; border:1px solid #404040; border-left:4px solid {MyBalanceColor}; border-radius:12px; padding:16px;")"
              Class="mb-3">
        <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <div style="flex:1;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em;">Dein Saldo</MudText>
                <MudText Typo="Typo.h5" Style="@($"color:{MyBalanceColor}; font-weight:700;")">
                    @(MyBalance > 0.005m ? "+" : "")@(MyBalance < -0.005m ? "-" : "")@Math.Abs(MyBalance).ToString("C2", _de)
                </MudText>
                <MudText Typo="Typo.caption" Style="@($"color:{MyBalanceColor}")">@MyBalanceLabel</MudText>
            </div>
        </div>
    </MudPaper>

    @if (GetSimplifiedDebts().Any(d => d.PayerId == _currentUserId))
    {
        var myDebts = GetSimplifiedDebts().Where(d => d.PayerId == _currentUserId).ToList();
        <!-- Schulden begleichen – mobile-friendly card list -->
        <MudPaper Style="background:#242424; border:1px solid #404040; border-left:4px solid #EF5350; border-radius:12px; padding:0; margin-bottom:20px; overflow:hidden;">
            <div style="padding:12px 16px 10px; display:flex; align-items:center; gap:8px;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:#EF5350; font-size:16px;" />
                <MudText Typo="Typo.caption" Style="color:#EF5350; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">
                    Schulden begleichen
                </MudText>
            </div>
            @foreach (var debt in myDebts)
            {
                <div class="gd-debt-item">
                    <div class="gd-debt-name">
                        <div style="font-weight:600; color:#F5F5F5; font-size:0.95rem;">@GetNameById(debt.PayeeId)</div>
                        <div style="font-size:0.75rem; color:#A3A3A3; margin-top:2px;">Schulden</div>
                    </div>
                    <span class="gd-debt-amount">@debt.Amount.ToString("C2", _de)</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Payment"
                               OnClick="() => OpenSettleDialogAsync(debt.PayeeId, GetNameById(debt.PayeeId), debt.Amount)">
                        Begleichen
                    </MudButton>
                </div>
            }
        </MudPaper>
    }
    else
    {
        <div style="margin-bottom:20px;"></div>
    }

    <!-- Alle Salden -->
    <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">Alle Salden</MudText>
    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var (userId, balance) in _balances)
        {
            var bColor = balance > 0.005m ? "#66BB6A" : balance < -0.005m ? "#EF5350" : "#A3A3A3";
            var bLabel = balance > 0.005m ? "bekommt zurück" : balance < -0.005m ? "schuldet" : "ausgeglichen";
            var bName = userId == _currentUserId ? "Du" : GetNameById(userId);
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Style="@($"background:#242424; border:1px solid #404040; border-left:3px solid {bColor}; border-radius:10px; padding:12px 16px;")">
                    <MudText Typo="Typo.body2" Style="@($"font-weight:600; color:{(userId == _currentUserId ? "#99F6E4" : "#F5F5F5")}")">@bName</MudText>
                    <MudText Typo="Typo.h6" Style="@($"color:{bColor}; font-weight:700;")">@Math.Abs(balance).ToString("C2", _de)</MudText>
                    <MudText Typo="Typo.caption" Style="@($"color:{bColor}")">@bLabel</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <!-- Settlement history (if any) -->
    @if (_settlements.Any())
    {
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
            <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em;">
                Zahlungen (@_settlements.Count)
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                       OnClick="@(() => _showSettlements = !_showSettlements)">
                @(_showSettlements ? "Ausblenden" : "Anzeigen")
            </MudButton>
        </div>
        @if (_showSettlements)
        {
            <MudPaper Style="background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; margin-bottom:20px;">
                @foreach (var s in _settlements.OrderByDescending(x => x.Date))
                {
                    var payerName = s.PayerUserId == _currentUserId ? "Du" : GetNameById(s.PayerUserId);
                    var payeeName = s.PayeeUserId == _currentUserId ? "dir" : GetNameById(s.PayeeUserId);
                    <div style="display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid #303030;">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" Class="bt-text-success" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.body2"><strong>@payerName</strong> ? @payeeName</MudText>
                            @if (!string.IsNullOrEmpty(s.Note))
                            {
                                <MudText Typo="Typo.caption" Class="bt-text-muted">@s.Note</MudText>
                            }
                        </div>
                        <MudText Typo="Typo.body2" Class="bt-text-success" Style="font-weight:600;">@s.Amount.ToString("C2", _de)</MudText>
                        <MudText Typo="Typo.caption" Class="bt-text-muted">@s.Date.ToString("dd.MM.")</MudText>
                    </div>
                }
            </MudPaper>
        }
    }

    <!-- Pending invitations -->
    @if (_pendingInvitations.Any())
    {
        <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
            Ausstehende Einladungen
        </MudText>
        <MudPaper Style="background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; margin-bottom:20px;">
            @foreach (var inv in _pendingInvitations)
            {
                <div style="display:flex; align-items:center; padding:10px 16px; border-bottom:1px solid #303030; gap:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Style="color:#FFA726;" />
                    <MudText Typo="Typo.body2" Style="flex:1; color:#B0BEC5;">@inv.InviteeEmail</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Ausstehend</MudChip>
                </div>
            }
        </MudPaper>
    }

    <!-- Expenses -->
    <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
        Ausgaben & Einnahmen (@_group.Expenses.Count)
    </MudText>
    <MudPaper Class="bt-panel">
        @if (!_group.Expenses.Any())
        {
            <div style="padding:24px; text-align:center;">
                <MudText Style="color:#A3A3A3; font-style:italic; font-size:0.9rem;">Noch keine Einträge</MudText>
            </div>
        }
        else
        {
            @foreach (var e in _group.Expenses.OrderByDescending(x => x.Date))
            {
                var paidByName = e.PaidByUserId == _currentUserId ? "Du" : GetNameById(e.PaidByUserId);
                var isExpanded = _expandedExpenses.Contains(e.Id);
                var amtColor = e.IsIncome ? "#66BB6A" : "#EF5350";
                var actionLabel = e.IsIncome ? "hat erhalten" : "hat bezahlt";
                <div style="border-bottom:1px solid #303030;">
                    <div style="display:flex; align-items:center; padding:12px 16px; gap:8px;">
                        <div style="display:flex; align-items:center; flex:1; gap:8px; cursor:pointer; min-width:0;"
                             @onclick="() => ToggleExpense(e.Id)">
                            @if (e.IsRecurring)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Style="color:#FFA726; flex-shrink:0;" Title="Wiederkehrend" />
                            }
                            else if (e.IsIncome)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="color:#66BB6A; flex-shrink:0;" />
                            }
                            <div style="flex:1; min-width:0;">
                                <MudText Typo="Typo.body2" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:600;">
                                    @e.Description
                                </MudText>
                                <MudText Typo="Typo.caption" Class="bt-text-muted">
                                    @e.Date.ToString("dd.MM.yyyy") – @paidByName @actionLabel
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body2" Style="@($"color:{amtColor}; font-weight:700; white-space:nowrap;")" Class="mr-1">
                                @(e.IsIncome ? "+" : "")@e.TotalAmount.ToString("C2", _de)
                            </MudText>
                            <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                     Size="Size.Small" Style="color:#A3A3A3; flex-shrink:0;" />
                        </div>
                        @if (_isAdmin)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary"
                                           OnClick="() => EditExpenseAsync(e)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteExpenseAsync(e)" />
                        }
                    </div>
                    @if (isExpanded)
                    {
                        <div style="background:#1f1f1f; padding:8px 16px 12px 48px; border-top:1px solid #232323;">
                            @if (e.Category != null)
                            {
                                <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Class="bt-text-muted" />
                                    <MudText Typo="Typo.caption" Class="bt-text-muted">@e.Category.Name</MudText>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(e.Note))
                            {
                                <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="bt-text-muted" />
                                    <MudText Typo="Typo.caption" Class="bt-pad-muted-italic">@e.Note</MudText>
                                </div>
                            }
                            @if (e.Splits.Any())
                            {
                                <div style="border-top:1px solid #303030; margin-top:4px; padding-top:6px;">
                                    @foreach (var s in e.Splits)
                                    {
                                        var splitName = s.UserId == _currentUserId ? "Du" : GetNameById(s.UserId);
                                        var isMe = s.UserId == _currentUserId;
                                        <div style="display:flex; align-items:center; gap:8px; margin-top:4px;">
                                            <MudText Typo="Typo.caption" Style="@($"color:{(isMe ? "#99F6E4" : "#A3A3A3")}; flex:1;")">
                                                @splitName
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="bt-text-muted">
                                                @s.Amount.ToString("C2", _de)
                                            </MudText>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </MudPaper>
}

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [Parameter] public string Slug { get; set; } = "";

    private bool _loading = true;
    private SharedGroup? _group;
    private int _currentUserId;
    private bool _isAdmin;
    private Dictionary<int, decimal> _balances = new();
    private List<GroupSettlement> _settlements = new();
    private List<GroupInvitation> _pendingInvitations = new();
    private bool _showSettlements;
    private HashSet<int> _expandedExpenses = new();

    private decimal MyBalance => _balances.TryGetValue(_currentUserId, out var mb) ? mb : 0m;
    private string MyBalanceColor => MyBalance > 0.005m ? "#66BB6A" : MyBalance < -0.005m ? "#EF5350" : "#A3A3A3";
    private string MyBalanceLabel => MyBalance > 0.005m ? "du bekommst zur\u00fcck" : MyBalance < -0.005m ? "du schuldest" : "ausgeglichen";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = UserService.GetUserId(authState.User) ?? 0;
        await LoadAsync();
    }

    private async Task SubscribeGroupNotificationsAsync()
    {
        if (_group == null) return;
        GroupNotifSvc.RegisterGroupDetail(_currentUserId, _group.Id, async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                // If we were kicked (no longer a member), navigate away
                if (_group == null || !_group.Members.Any(m => m.UserId == _currentUserId))
                    Nav.NavigateTo("/groups");
                else
                    StateHasChanged();
            });
        });
    }

    public void Dispose()
    {
        if (_group != null)
            GroupNotifSvc.UnregisterGroupDetail(_currentUserId, _group.Id);
    }

    private void GoBack() => Nav.NavigateTo("/groups");

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        _group = await db.SharedGroups
            .Include(g => g.Members).ThenInclude(m => m.User)
            .Include(g => g.Expenses).ThenInclude(e => e.Splits)
            .Include(g => g.Expenses).ThenInclude(e => e.Category)
            .FirstOrDefaultAsync(g => g.Slug == Slug && g.IsActive);

        if (_group != null)
        {
            _settlements = await db.GroupSettlements
                .Where(s => s.GroupId == _group!.Id)
                .OrderByDescending(s => s.Date)
                .ToListAsync();

            _pendingInvitations = await db.GroupInvitations
                .Where(i => i.GroupId == _group!.Id && i.Status == InvitationStatus.Pending)
                .ToListAsync();

            CalculateBalances();
            _isAdmin = _group.Members.Any(m => m.UserId == _currentUserId && m.Role == GroupMemberRole.Admin);
            await SubscribeGroupNotificationsAsync();
        }
        _loading = false;
    }

    private void CalculateBalances()
    {
        _balances = _group!.Members.ToDictionary(m => m.UserId, _ => 0m);

        // Credit/debit from expense splits (only current expenses, exclude imported history)
        foreach (var expense in _group.Expenses.Where(e => !e.IsImported))
        {
            foreach (var split in expense.Splits.Where(s => s.UserId != expense.PaidByUserId))
            {
                if (!expense.IsIncome)
                {
                    // Normal expense: payer gets credited, others get debited
                    _balances[expense.PaidByUserId] = _balances.GetValueOrDefault(expense.PaidByUserId) + split.Amount;
                    _balances[split.UserId] = _balances.GetValueOrDefault(split.UserId) - split.Amount;
                }
                else
                {
                    // Income: receiver owes others their share (reverse signs)
                    _balances[expense.PaidByUserId] = _balances.GetValueOrDefault(expense.PaidByUserId) - split.Amount;
                    _balances[split.UserId] = _balances.GetValueOrDefault(split.UserId) + split.Amount;
                }
            }
        }

        // Apply recorded settlements
        foreach (var s in _settlements)
        {
            if (_balances.ContainsKey(s.PayerUserId)) _balances[s.PayerUserId] += s.Amount;
            if (_balances.ContainsKey(s.PayeeUserId)) _balances[s.PayeeUserId] -= s.Amount;
        }
    }

    // Splitwise-style debt simplification: returns the minimal set of settlements for the whole group.
    private List<(int PayerId, int PayeeId, decimal Amount)> GetSimplifiedDebts()
    {
        var bal = _balances.ToDictionary(kv => kv.Key, kv => kv.Value);
        var results = new List<(int, int, decimal)>();

        for (int i = 0; i < 200; i++) // safety upper bound
        {
            // Find the member with the most debt (most negative balance)
            int debtorId = 0; decimal debtorBal = 0; bool foundDebtor = false;
            // Find the member who is owed the most (most positive balance)
            int creditorId = 0; decimal creditorBal = 0; bool foundCreditor = false;

            foreach (var kv in bal)
            {
                if (kv.Value < -0.005m && (!foundDebtor || kv.Value < debtorBal))
                { debtorId = kv.Key; debtorBal = kv.Value; foundDebtor = true; }
                if (kv.Value > 0.005m && (!foundCreditor || kv.Value > creditorBal))
                { creditorId = kv.Key; creditorBal = kv.Value; foundCreditor = true; }
            }

            if (!foundDebtor || !foundCreditor) break;

            var amount = Math.Round(Math.Min(Math.Abs(debtorBal), creditorBal), 2);
            if (amount < 0.005m) break;

            results.Add((debtorId, creditorId, amount));
            bal[debtorId] += amount;
            bal[creditorId] -= amount;
        }

        return results;
    }

    private string GetNameById(int userId)
    {
        var m = _group?.Members.FirstOrDefault(m => m.UserId == userId);
        return GetMemberName(m);
    }

    private string GetFirstNameById(int userId)
    {
        var m = _group?.Members.FirstOrDefault(m => m.UserId == userId);
        return m?.User?.FirstName ?? "";
    }

    private string GetLastNameById(int userId)
    {
        var m = _group?.Members.FirstOrDefault(m => m.UserId == userId);
        return m?.User?.LastName ?? "";
    }

    private void ToggleExpense(int id)
    {
        if (!_expandedExpenses.Remove(id))
            _expandedExpenses.Add(id);
    }

    private static string GetMemberName(GroupMember? m)
    {
        if (m?.User == null) return $"User";
        if (!string.IsNullOrEmpty(m.User.DisplayName)) return m.User.DisplayName;
        var full = $"{m.User.FirstName} {m.User.LastName}".Trim();
        return string.IsNullOrEmpty(full) ? m.User.Username : full;
    }

    private async Task OpenSettleDialogAsync(int payeeUserId, string payeeName, decimal outstandingAmount)
    {
        var parameters = new DialogParameters
        {
            ["GroupId"] = _group!.Id,
            ["PayerUserId"] = _currentUserId,
            ["PayeeUserId"] = payeeUserId,
            ["PayeeName"] = payeeName,
            ["OutstandingAmount"] = outstandingAmount
        };
        var dlg = await DialogService.ShowAsync<SettleDebtDialog>("Schulden begleichen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
        {
            await LoadAsync();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
        }
    }

    private async Task AddExpenseAsync()
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["GroupId"] = _group!.Id,
            ["CurrentUserId"] = _currentUserId,
            ["Members"] = _group.Members.ToList()
        };
        var dlg = await DialogService.ShowAsync<SplitExpenseDialog>("Ausgabe hinzufgen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
        {
            await LoadAsync();
            StateHasChanged();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
        }
    }
    private async Task AddIncomeAsync()
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["GroupId"] = _group!.Id,
            ["CurrentUserId"] = _currentUserId,
            ["Members"] = _group.Members.ToList(),
            ["IsIncome"] = true
        };
        var dlg = await DialogService.ShowAsync<SplitExpenseDialog>("Einnahme hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
        {
            await LoadAsync();
            StateHasChanged();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
        }
    }

    private async Task ImportHistoryAsync()
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["GroupId"] = _group!.Id
        };
        var dlg = await DialogService.ShowAsync<GroupImportDialog>("Ausgabenverlauf importieren", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
        {
            await LoadAsync();
            StateHasChanged();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
            Snackbar.Add("Ausgabenverlauf erfolgreich importiert", Severity.Success);
        }
    }

    private async Task EditExpenseAsync(GroupExpense expense)
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["Expense"] = expense,
            ["GroupId"] = _group!.Id,
            ["CurrentUserId"] = _currentUserId,
            ["Members"] = _group.Members.ToList(),
            ["IsIncome"] = expense.IsIncome
        };
        var dlg = await DialogService.ShowAsync<SplitExpenseDialog>("Ausgabe bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
        {
            await LoadAsync();
            StateHasChanged();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
        }
    }

    private async Task DeleteExpenseAsync(GroupExpense expense)
    {
        var result = await DialogService.ShowMessageBox("Ausgabe löschen?",
            $"\"{expense.Description}\" wirklich löschen?", yesText: "Löschen", cancelText: "Abbrechen");
        if (result == true)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.GroupExpenses.FindAsync(expense.Id);
            if (entity != null) db.GroupExpenses.Remove(entity);
            await db.SaveChangesAsync();
            await LoadAsync();
            StateHasChanged();
            await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
        }
    }

    private async Task EditGroupAsync()
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["Group"] = _group,
            ["CurrentUserId"] = _currentUserId,
            ["CanDelete"] = _isAdmin
        };
        var dlg = await DialogService.ShowAsync<GroupDialog>("Gruppe bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dlg.Result;
        if (result is { Canceled: false })
        {
            if (result.Data is string s && s == "deleted")
            {
                await GroupNotifSvc.NotifyGroupAsync(_group!.Id);
                Nav.NavigateTo("/groups");
            }
            else
            {
                await LoadAsync();
                await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
            }
        }
    }

    private async Task AddMemberAsync()
    {
        var parameters = new DialogParameters
        {
            ["GroupId"] = _group!.Id,
            ["CurrentUserId"] = _currentUserId
        };
        var dlg = await DialogService.ShowAsync<GroupInviteDialog>("Mitglied einladen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dlg.Result;
        await LoadAsync();
    }

    private async Task ShowMembersDialogAsync()
    {
        if (_group == null) return;
        var parameters = new DialogParameters
        {
            ["Members"] = _group.Members.ToList(),
            ["Balances"] = _balances,
            ["IsAdmin"] = _isAdmin
        };
        var dlg = await DialogService.ShowAsync<MembersDialog>("Mitglieder", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dlg.Result;
        if (result is { Canceled: false } && result.Data is bool shouldInvite && shouldInvite)
            await AddMemberAsync();
    }

    private async Task RemoveMemberAsync(GroupMember member)
    {
        var name = GetMemberName(member);
        var result = await DialogService.ShowMessageBox("Mitglied entfernen?",
            $"{name} wirklich aus der Gruppe entfernen?", yesText: "Entfernen", cancelText: "Abbrechen");
        if (result != true) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.GroupMembers.FindAsync(member.Id);
        if (entity != null) db.GroupMembers.Remove(entity);
        await db.SaveChangesAsync();
        Snackbar.Add($"{name} wurde entfernt.", Severity.Success);
        await LoadAsync();
        await GroupNotifSvc.NotifyGroupAsync(member.GroupId, _currentUserId);
        await GroupNotifSvc.NotifyKickedUserAsync(member.UserId, member.GroupId);
    }

    private async Task SettleSplitAsync(ExpenseSplit split)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ExpenseSplits.FindAsync(split.Id);
        if (entity != null)
        {
            entity.IsSettled = true;
            entity.SettledAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            Snackbar.Add("Als beglichen markiert.", Severity.Success);
        }
        await LoadAsync();
        await GroupNotifSvc.NotifyGroupAsync(_group!.Id, _currentUserId);
    }
}