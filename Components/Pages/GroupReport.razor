@page "/groups/{Slug}/report"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Gruppenbericht – Budget Tracker</PageTitle>


@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" />
}
else if (_group == null)
{
    <MudText Class="bt-text-muted">Gruppe nicht gefunden.</MudText>
}
else
{
    <!-- Print-only header -->
    <div class="grp-print-header" style="margin-bottom:16px; border-bottom:2px solid #14B8A6; padding-bottom:8px;">
        <h2 style="margin:0; color:#1f1f1f;">Budget Tracker – @_group.Name – Bericht</h2>
        <p style="margin:4px 0 0; color:#555; font-size:13px;">Zeitraum: @_from.ToString("dd.MM.yyyy", _de) – @_to.ToString("dd.MM.yyyy", _de) &nbsp;·&nbsp; Erstellt am @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
    </div>

    <!-- Header -->
    <div class="no-print" style="display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo($"/groups/{Slug}"))" />
        <div style="flex:1;">
            <MudText Typo="Typo.h5" Class="bt-section-heading bt-section-heading--brand">@_group.Name – Bericht</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="PrintReportAsync">PDF exportieren</MudButton>
    </div>

    <!-- Mode + period selection -->
    <div class="no-print" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;">
        <div class="grp-report-mode-toggle">
            <button class="grp-report-mode-btn @(!_customRange ? "active" : "")"
                    @onclick="@(() => { _customRange = false; ApplyMonth(); })">Monatsansicht</button>
            <button class="grp-report-mode-btn @(_customRange ? "active" : "")"
                    @onclick="@(() => { _customRange = true; StateHasChanged(); })">Zeitraum</button>
        </div>

        @if (!_customRange)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Color="Color.Default"
                           OnClick="PrevMonth" />
            <MudText Style="color:#F5F5F5; min-width:120px; text-align:center; font-weight:600;">
                @_from.ToString("MMMM yyyy", _de)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Default"
                           OnClick="NextMonth" Disabled="@(_from.Month == DateTime.Today.Month && _from.Year == DateTime.Today.Year)" />
        }
        else
        {
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                    @foreach (var (label, days) in _presets)
                    {
                        <button class="grp-date-preset @(_selectedPreset == label ? "active" : "")"
                                @onclick="() => ApplyPreset(label, days)">@label</button>
                    }
                </div>
                <MudDatePicker Label="Von" @bind-Date="_fromDate" DateFormat="dd.MM.yyyy"
                               Variant="Variant.Outlined" Style="max-width:140px;" />
                <MudDatePicker Label="Bis" @bind-Date="_toDate" DateFormat="dd.MM.yyyy"
                               Variant="Variant.Outlined" Style="max-width:140px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           OnClick="LoadReportAsync">Laden</MudButton>
            </div>
        }
    </div>

    <!-- KPI cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Style="background:#242424; border:1px solid #404040; border-left:4px solid #EF5350; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em;">Gesamtausgaben</MudText>
                <MudText Typo="Typo.h5" Class="bt-text-error" Style="font-weight:700;">@_totalExpenses.ToString("C2", _de)</MudText>
                <MudText Typo="Typo.caption" Class="bt-text-muted">@_expenseCount Ausgaben</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Style="background:#242424; border:1px solid #404040; border-left:4px solid #66BB6A; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em;">Beglichene Schulden</MudText>
                <MudText Typo="Typo.h5" Class="bt-text-success" Style="font-weight:700;">@_totalSettled.ToString("C2", _de)</MudText>
                <MudText Typo="Typo.caption" Class="bt-text-muted">@_settlementCount Zahlungen</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Style="background:#242424; border:1px solid #404040; border-left:4px solid #14B8A6; border-radius:12px; padding:16px;">
                <MudText Typo="Typo.caption" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em;">Ø pro Mitglied</MudText>
                <MudText Typo="Typo.h5" Class="bt-text-brand" Style="font-weight:700;">@_avgPerMember.ToString("C2", _de)</MudText>
                <MudText Typo="Typo.caption" Class="bt-text-muted">@_group.Members.Count Mitglieder</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Per-member breakdown -->
    @if (_memberStats.Any())
    {
        <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
            Ausgaben pro Mitglied
        </MudText>
        <MudPaper Style="background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; margin-bottom:20px;">
            <!-- Desktop table -->
            <div class="gr-desktop-table">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="border-bottom:1px solid #303030; background:#1f1f1f;">
                        <th style="text-align:left; padding:10px 16px; color:#A3A3A3; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">Mitglied</th>
                        <th style="text-align:right; padding:10px 16px; color:#A3A3A3; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">Bezahlt</th>
                        <th style="text-align:right; padding:10px 16px; color:#A3A3A3; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">Schuldet</th>
                        <th style="text-align:right; padding:10px 16px; color:#A3A3A3; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.06em; font-weight:600;">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in _memberStats.OrderByDescending(s => s.Paid))
                    {
                        var saldoColor = stat.Net > 0.005m ? "#66BB6A" : stat.Net < -0.005m ? "#EF5350" : "#A3A3A3";
                        var isMe = stat.UserId == _currentUserId;
                        <tr style="border-bottom:1px solid #252525;">
                            <td style="padding:10px 16px; color:@(isMe ? "#99F6E4" : "#B0BEC5"); font-weight:@(isMe ? "600" : "400");">
                                @(isMe ? "Du" : stat.Name)
                            </td>
                            <td style="text-align:right; padding:10px 16px; color:#66BB6A; font-weight:600;">@stat.Paid.ToString("C2", _de)</td>
                            <td style="text-align:right; padding:10px 16px; color:#EF5350;">@stat.Owes.ToString("C2", _de)</td>
                            <td style="text-align:right; padding:10px 16px; color:@saldoColor; font-weight:700;">
                                @(stat.Net >= 0 ? "+" : "")@stat.Net.ToString("C2", _de)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <!-- Mobile card list -->
            <div class="gr-mobile-list">
                @foreach (var stat in _memberStats.OrderByDescending(s => s.Paid))
                {
                    var saldoColor = stat.Net > 0.005m ? "#66BB6A" : stat.Net < -0.005m ? "#EF5350" : "#A3A3A3";
                    var isMe = stat.UserId == _currentUserId;
                    <div class="gr-stat-card">
                        <span class="gr-stat-name @(isMe ? "me" : "")">@(isMe ? "Du" : stat.Name)</span>
                        <div class="gr-stat-col">
                            <span class="gr-stat-label">Bezahlt</span>
                            <span class="gr-stat-value" style="color:#66BB6A;">@stat.Paid.ToString("C2", _de)</span>
                        </div>
                        <div class="gr-stat-col">
                            <span class="gr-stat-label">Schuldet</span>
                            <span class="gr-stat-value" style="color:#EF5350;">@stat.Owes.ToString("C2", _de)</span>
                        </div>
                        <div class="gr-stat-col">
                            <span class="gr-stat-label">Saldo</span>
                            <span class="gr-stat-value" style="color:@saldoColor;">@(stat.Net >= 0 ? "+" : "")@stat.Net.ToString("C2", _de)</span>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    }

    <!-- Settlement history for period -->
    @if (_periodSettlements.Any())
    {
        <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
            Zahlungen im Zeitraum
        </MudText>
        <MudPaper Style="background:#242424; border:1px solid #404040; border-radius:12px; overflow:hidden; margin-bottom:20px;">
            @foreach (var s in _periodSettlements.OrderByDescending(x => x.Date))
            {
                var payerName = s.PayerUserId == _currentUserId ? "Du" : _memberNameById.GetValueOrDefault(s.PayerUserId, "?");
                var payeeName = s.PayeeUserId == _currentUserId ? "dir" : _memberNameById.GetValueOrDefault(s.PayeeUserId, "?");
                <div style="display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid #303030;">
                    <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" Class="bt-text-success" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body2"><strong>@payerName</strong> → @payeeName</MudText>
                        @if (!string.IsNullOrEmpty(s.Note))
                        {
                            <MudText Typo="Typo.caption" Class="bt-text-muted">@s.Note</MudText>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Class="bt-text-success" Style="font-weight:600;">@s.Amount.ToString("C2", _de)</MudText>
                    <MudText Typo="Typo.caption" Class="bt-text-muted">@s.Date.ToString("dd.MM.yyyy")</MudText>
                </div>
            }
        </MudPaper>
    }

    <!-- Expense list for period -->
    @if (_periodExpenses.Any())
    {
        <MudText Typo="Typo.subtitle2" Style="color:#A3A3A3; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px;">
            Ausgaben im Zeitraum
        </MudText>
        <MudPaper Class="bt-panel">
            @foreach (var e in _periodExpenses.OrderByDescending(x => x.Date))
            {
                var paidName = e.PaidByUserId == _currentUserId ? "Du" : _memberNameById.GetValueOrDefault(e.PaidByUserId, "?");
                <div style="display:flex; align-items:center; padding:10px 16px; border-bottom:1px solid #303030; gap:8px;">
                    <div style="flex:1; min-width:0;">
                        <MudText Typo="Typo.body2" Style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@e.Description</MudText>
                        <MudText Typo="Typo.caption" Class="bt-text-muted">@e.Date.ToString("dd.MM.yyyy") · @paidName hat bezahlt</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="color:#EF5350; font-weight:700; white-space:nowrap;">@e.TotalAmount.ToString("C2", _de)</MudText>
                </div>
            }
        </MudPaper>
    }
    else if (!_loading)
    {
        <MudText Style="color:#A3A3A3; font-style:italic; font-size:0.9rem;">Keine Ausgaben im gewählten Zeitraum.</MudText>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [Parameter] public string Slug { get; set; } = "";

    private bool _loading = true;
    private SharedGroup? _group;
    private int _currentUserId;

    // Period
    private bool _customRange;
    private DateTime _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _to = DateTime.Today;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _selectedPreset = "";

    // Report data
    private decimal _totalExpenses;
    private int _expenseCount;
    private decimal _totalSettled;
    private int _settlementCount;
    private decimal _avgPerMember;
    private List<GroupExpense> _periodExpenses = new();
    private List<GroupSettlement> _periodSettlements = new();
    private List<MemberStat> _memberStats = new();
    private Dictionary<int, string> _memberNameById = new();

    private readonly (string Label, int Days)[] _presets =
    [
        ("7 Tage", 7), ("30 Tage", 30), ("3 Monate", 90), ("6 Monate", 180), ("1 Jahr", 365)
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = UserService.GetUserId(authState.User) ?? 0;
        _fromDate = _from;
        _toDate = _to;
        await LoadGroupAsync();
        await LoadReportAsync();
    }

    private async Task LoadGroupAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _group = await db.SharedGroups
            .Include(g => g.Members).ThenInclude(m => m.User)
            .FirstOrDefaultAsync(g => g.Slug == Slug && g.IsActive);

        if (_group != null)
        {
            _memberNameById = _group.Members.ToDictionary(
                m => m.UserId,
                m => {
                    if (!string.IsNullOrEmpty(m.User?.DisplayName)) return m.User.DisplayName;
                    var full = $"{m.User?.FirstName} {m.User?.LastName}".Trim();
                    return string.IsNullOrEmpty(full) ? (m.User?.Username ?? $"User {m.UserId}") : full;
                });
        }
    }

    private void ApplyMonth()
    {
        _from = new DateTime(_from.Year, _from.Month, 1);
        _to = _from.AddMonths(1).AddDays(-1);
        _ = LoadReportAsync();
    }

    private void PrevMonth() { _from = _from.AddMonths(-1); ApplyMonth(); }

    private void NextMonth()
    {
        var next = _from.AddMonths(1);
        if (next <= DateTime.Today) { _from = next; ApplyMonth(); }
    }

    private void ApplyPreset(string label, int days)
    {
        _selectedPreset = label;
        _toDate = DateTime.Today;
        _fromDate = DateTime.Today.AddDays(-days + 1);
        _ = LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        if (_group == null) { await LoadGroupAsync(); if (_group == null) { _loading = false; return; } }

        DateTime rangeFrom, rangeTo;
        if (_customRange)
        {
            rangeFrom = (_fromDate ?? DateTime.Today.AddMonths(-1)).Date;
            rangeTo = (_toDate ?? DateTime.Today).Date.AddDays(1).AddSeconds(-1);
        }
        else
        {
            rangeFrom = _from.Date;
            rangeTo = _to.Date.AddDays(1).AddSeconds(-1);
        }

        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        _periodExpenses = await db.GroupExpenses
            .Include(e => e.Splits)
            .Where(e => e.GroupId == _group!.Id && e.Date >= rangeFrom && e.Date <= rangeTo)
            .OrderByDescending(e => e.Date)
            .ToListAsync();

        _periodSettlements = await db.GroupSettlements
            .Where(s => s.GroupId == _group!.Id && s.Date >= rangeFrom && s.Date <= rangeTo)
            .OrderByDescending(s => s.Date)
            .ToListAsync();

        _totalExpenses = _periodExpenses.Sum(e => e.TotalAmount);
        _expenseCount = _periodExpenses.Count;
        _totalSettled = _periodSettlements.Sum(s => s.Amount);
        _settlementCount = _periodSettlements.Count;
        _avgPerMember = _group!.Members.Count > 0 ? Math.Round(_totalExpenses / _group.Members.Count, 2) : 0;

        // Per-member stats
        _memberStats = _group.Members.Select(m => {
            var paid = _periodExpenses.Where(e => e.PaidByUserId == m.UserId).Sum(e => e.TotalAmount);
            var owes = _periodExpenses.SelectMany(e => e.Splits)
                .Where(s => s.UserId == m.UserId && !_periodExpenses.First(e => e.Id == s.GroupExpenseId).PaidByUserId.Equals(m.UserId))
                .Sum(s => s.Amount);
            var settled_out = _periodSettlements.Where(s => s.PayerUserId == m.UserId).Sum(s => s.Amount);
            var settled_in = _periodSettlements.Where(s => s.PayeeUserId == m.UserId).Sum(s => s.Amount);
            return new MemberStat
            {
                UserId = m.UserId,
                Name = _memberNameById.GetValueOrDefault(m.UserId, $"User {m.UserId}"),
                Paid = paid,
                Owes = owes,
                Net = paid - owes + settled_in - settled_out
            };
        }).ToList();

        _loading = false;
    }

    private class MemberStat
    {
        public int UserId { get; init; }
        public string Name { get; init; } = "";
        public decimal Paid { get; init; }
        public decimal Owes { get; init; }
        public decimal Net { get; init; }
    }

    private async Task PrintReportAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
