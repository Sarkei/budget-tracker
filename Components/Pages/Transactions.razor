@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService

<PageTitle>Transaktionen – Budget Tracker</PageTitle>

<PageToolbar Title="Transaktionen">
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.UploadFile"
                   OnClick="OpenImportDialogAsync">CSV importieren</MudButton>
        <MudMenu Label="Hinzufügen" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Secondary" AnchorOrigin="Origin.BottomLeft">
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" IconColor="Color.Success" OnClick="AddIncomeAsync">Einnahme</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" IconColor="Color.Error" OnClick="AddExpenseAsync">Ausgabe</MudMenuItem>
        </MudMenu>
    </div>
</PageToolbar>

<!-- Summary cards – DESKTOP (hidden on mobile by .tx-desktop-summary class) -->
<MudGrid Spacing="3" Class="mb-4 tx-desktop-summary">
    <MudItem xs="12" sm="4">
        <MudPaper Style="background:#262626; border:1px solid #404040; border-left:3px solid #66BB6A; border-radius:14px; padding:16px;">
            <MudText Typo="Typo.caption" Class="bt-text-muted">Einnahmen</MudText>
            <MudText Typo="Typo.h6" Class="bt-text-success" Style="font-weight:700;">@_filteredIncome.ToString("C2", _de)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Style="background:#262626; border:1px solid #404040; border-left:3px solid #EF5350; border-radius:14px; padding:16px;">
            <MudText Typo="Typo.caption" Class="bt-text-muted">Ausgaben</MudText>
            <MudText Typo="Typo.h6" Class="bt-text-error" Style="font-weight:700;">@_filteredExpenses.ToString("C2", _de)</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Style="@($"background:#262626; border:1px solid #404040; border-left:3px solid {(_filteredBalance >= 0 ? "#66BB6A" : "#EF5350")}; border-radius:14px; padding:16px;")">
            <MudText Typo="Typo.caption" Class="bt-text-muted">Bilanz</MudText>
            <MudText Typo="Typo.h6" Style="@($"color:{(_filteredBalance >= 0 ? "#66BB6A" : "#EF5350")}; font-weight:700;")">@_filteredBalance.ToString("C2", _de)</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Summary cards – MOBILE horizontal strip -->
<div class="tx-summary-strip">
    <div class="tx-summary-card" style="border-left:3px solid #66BB6A;">
        <div style="font-size:0.7rem; color:#A3A3A3; text-transform:uppercase; letter-spacing:0.09em; font-weight:800;">Einnahmen</div>
        <div style="font-size:1.1rem; color:#66BB6A; font-weight:700; margin-top:2px;">@_filteredIncome.ToString("C2", _de)</div>
    </div>
    <div class="tx-summary-card" style="border-left:3px solid #EF5350;">
        <div style="font-size:0.7rem; color:#A3A3A3; text-transform:uppercase; letter-spacing:0.09em; font-weight:800;">Ausgaben</div>
        <div style="font-size:1.1rem; color:#EF5350; font-weight:700; margin-top:2px;">@_filteredExpenses.ToString("C2", _de)</div>
    </div>
    <div class="tx-summary-card" style="@($"border-left:3px solid {(_filteredBalance >= 0 ? "#66BB6A" : "#EF5350")};")">
        <div style="font-size:0.7rem; color:#A3A3A3; text-transform:uppercase; letter-spacing:0.09em; font-weight:800;">Bilanz</div>
        <div style="@($"font-size:1.1rem; color:{(_filteredBalance >= 0 ? "#66BB6A" : "#EF5350")}; font-weight:700; margin-top:2px;")">@_filteredBalance.ToString("C2", _de)</div>
    </div>
</div>

<!-- Filters -->
<MudPaper Style="background:#262626; border:1px solid #404040; border-radius:14px; padding:16px; margin-bottom:16px;">
    <!-- Mobile: filter toggle header -->
    <div class="tx-filter-toggle-btn" style="display:flex; align-items:center; justify-content:space-between; cursor:pointer; margin-bottom:@(_filterOpen ? "12px" : "0");"
         @onclick="() => _filterOpen = !_filterOpen">
        <div style="display:flex; align-items:center; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.FilterList" Style="color:#99F6E4; font-size:18px;" />
            <span style="color:#99F6E4; font-size:0.78rem; font-weight:900; text-transform:uppercase; letter-spacing:.08em;">Filter</span>
            <span style="color:#A3A3A3; font-size:0.75rem;">
                @(new DateTime(2000, _filterMonth, 1).ToString("MMM", _de)) @_filterYear
                @(_filterType != "Alle" ? $" · {_filterType}" : "")
            </span>
        </div>
        <MudIcon Icon="@(_filterOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                 Class="bt-text-muted" />
    </div>
    <div class="@("tx-filter-expanded" + (_filterOpen ? " open" : ""))">
        <MudGrid Spacing="2" AlignItems="AlignItems.End">
            <MudItem xs="6" sm="2">
                <MudSelect T="int" Label="Monat" @bind-Value="_filterMonth" Dense="true" Variant="Variant.Outlined">
                    @for (int m = 1; m <= 12; m++) { var mn = m; <MudSelectItem Value="mn">@(new DateTime(2000, mn, 1).ToString("MMMM", _de))</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudSelect T="int" Label="Jahr" @bind-Value="_filterYear" Dense="true" Variant="Variant.Outlined">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--) { var yr = y; <MudSelectItem Value="yr">@yr</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudSelect T="string" Label="Typ" @bind-Value="_filterType" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Alle")">Alle</MudSelectItem>
                    <MudSelectItem Value="@("Einnahmen")">Einnahmen</MudSelectItem>
                    <MudSelectItem Value="@("Ausgaben")">Ausgaben</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudSelect T="int?" Label="Kategorie" @bind-Value="_filterCategoryId" Dense="true" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in _categories) { <MudSelectItem Value="@((int?)c.Id)">@c.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_searchText" Label="Suche" Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <div style="display:flex; gap:4px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RefreshAsync"
                               StartIcon="@Icons.Material.Filled.Search" FullWidth="true" Size="Size.Medium">
                        <span class="tx-desktop-view" style="display:inline;">Filtern</span>
                        <span class="tx-mobile-view" style="display:none;">Anwenden</span>
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Default" Variant="Variant.Outlined"
                                   OnClick="ClearFilterAsync" Title="Filter zurücksetzen" />
                </div>
            </MudItem>
        </MudGrid>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-2" />
}

<!-- DESKTOP: Transactions table -->
<div class="tx-desktop-view">
    <MudPaper Class="tx-table-wrap" Style="background:#262626; border:1px solid #404040; border-radius:14px; overflow:hidden;">
        <MudDataGrid T="Transaction" Items="_transactions" Dense="true" Hover="true" Striped="true"
                     Style="background:transparent;" RowStyle="background:transparent;">
            <Columns>
                <PropertyColumn Property="t => t.Date" Title="Datum" Format="dd.MM.yyyy" />
                <TemplateColumn Title="Kategorie">
                    <CellTemplate Context="ctx">
                        <MudText Typo="Typo.body2">@(ctx.Item.Category?.Name ?? "–")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="t => t.Note" Title="Beschreibung">
                    <CellTemplate Context="ctx">
                        <MudText Typo="Typo.body2" Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @(ctx.Item.Note ?? "–")
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Konto">
                    <CellTemplate Context="ctx">
                        <MudText Typo="Typo.body2">@(ctx.Item.Account?.Name ?? "–")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Betrag" SortBy="t => t.Amount">
                    <CellTemplate Context="ctx">
                        <MudText Typo="Typo.body2" Style="@($"color:{(ctx.Item.Type == TransactionType.Income ? "#66BB6A" : "#EF5350")}; font-weight:600;")">
                            @(ctx.Item.Type == TransactionType.Income ? "+" : "-")@ctx.Item.Amount.ToString("C2", _de)
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Aktionen" SortBy="t => t.Id">
                    <CellTemplate Context="ctx">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="() => EditTransactionAsync(ctx.Item)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => DeleteTransactionAsync(ctx.Item)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Style="color:#A3A3A3; padding:24px; text-align:center; font-style:italic;">Keine Transaktionen gefunden</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</div>

<!-- MOBILE: Transaction card list -->
<div class="tx-mobile-view">
    @if (!_transactions.Any())
    {
        <div style="padding:32px 16px; text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Style="color:#404040; font-size:3rem; margin-bottom:12px;" />
            <MudText Class="bt-pad-muted-italic">Keine Transaktionen gefunden</MudText>
        </div>
    }
    else
    {
        @foreach (var group in _transactions
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month))
        {
            <div style="font-size:0.72rem; font-weight:900; text-transform:uppercase; letter-spacing:0.1em; color:#A3A3A3; padding:12px 4px 6px;">
                @(new DateTime(group.Key.Year, group.Key.Month, 1).ToString("MMMM yyyy", _de))
            </div>
            @foreach (var t in group)
            {
                var isIncome = t.Type == TransactionType.Income;
                var amtColor = isIncome ? "#66BB6A" : "#EF5350";
                <div class="tx-card">
                    <div class="tx-card-bar" style="@($"background:{amtColor};")"></div>
                    <div class="tx-card-body">
                        <div class="tx-card-row1">
                            <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                                <MudIcon Icon="@(isIncome ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                         Style="@($"color:{amtColor}; font-size:16px; flex-shrink:0;")" />
                                <span class="tx-card-desc">@(t.Note ?? t.Category?.Name ?? "–")</span>
                            </div>
                            <span class="tx-card-amount" style="@($"color:{amtColor};")">
                                @(isIncome ? "+" : "-")@t.Amount.ToString("C2", _de)
                            </span>
                        </div>
                        <div class="tx-card-row2">
                            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                <span class="tx-card-meta">@t.Date.ToString("dd.MM.yyyy")</span>
                                @if (t.Category != null)
                                {
                                    <span style="font-size:0.7rem; background:#303030; color:#A3A3A3; border-radius:8px; padding:2px 8px;">@t.Category.Name</span>
                                }
                                @if (t.Account != null)
                                {
                                    <span class="tx-card-meta">· @t.Account.Name</span>
                                }
                            </div>
                            <div class="tx-card-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary"
                                               Style="padding:4px;" OnClick="() => EditTransactionAsync(t)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Style="padding:4px;" OnClick="() => DeleteTransactionAsync(t)" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading;
    private bool _filterOpen = false;
    private bool _addHandled;
    private string? _lastAddParam;

    [SupplyParameterFromQuery(Name = "add")]
    public string? AddParam { get; set; }

    private List<Transaction> _transactions = new();
    private List<Category> _categories = new();
    private decimal _filteredIncome, _filteredExpenses, _filteredBalance;

    private int _filterMonth = DateTime.Today.Month;
    private int _filterYear = DateTime.Today.Year;
    private string _filterType = "Alle";
    private int? _filterCategoryId;
    private string _searchText = "";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += OnAccountChanged;
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        await RefreshAsync();
    }

    private async void OnAccountChanged()
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        StateHasChanged();

        await using var db = await DbFactory.CreateDbContextAsync();
        var mStart = new DateTime(_filterYear, _filterMonth, 1);
        var mEnd = mStart.AddMonths(1);

        var q = db.Transactions.Include(t => t.Category).Include(t => t.Account)
            .Where(t => t.Date >= mStart && t.Date < mEnd).AsQueryable();

        if (AppState.SelectedAccountId.HasValue)
            q = q.Where(t => t.AccountId == AppState.SelectedAccountId.Value);
        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(t => t.Note != null && t.Note.Contains(_searchText));
        if (_filterCategoryId.HasValue)
            q = q.Where(t => t.CategoryId == _filterCategoryId.Value);
        if (_filterType == "Einnahmen")
            q = q.Where(t => t.Type == TransactionType.Income);
        else if (_filterType == "Ausgaben")
            q = q.Where(t => t.Type == TransactionType.Expense);

        _transactions = await q.OrderByDescending(t => t.Date).ThenByDescending(t => t.CreatedAt).ToListAsync();
        _filteredIncome = _transactions.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
        _filteredExpenses = _transactions.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);
        _filteredBalance = _filteredIncome - _filteredExpenses;

        _loading = false;
    }

    private async Task ClearFilterAsync()
    {
        _filterMonth = DateTime.Today.Month;
        _filterYear = DateTime.Today.Year;
        _filterType = "Alle";
        _filterCategoryId = null;
        _searchText = "";
        await RefreshAsync();
    }

    private async Task AddIncomeAsync()
    {
        var parameters = new DialogParameters { ["AccountId"] = AppState.SelectedAccountId, ["IsExpense"] = false, ["HasTypePreset"] = true };
        var dlg = await DialogService.ShowAsync<TransactionDialog>("Einnahme hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await RefreshAsync();
    }

    private async Task AddExpenseAsync()
    {
        var parameters = new DialogParameters { ["AccountId"] = AppState.SelectedAccountId, ["IsExpense"] = true, ["HasTypePreset"] = true };
        var dlg = await DialogService.ShowAsync<TransactionDialog>("Ausgabe hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await RefreshAsync();
    }

    private async Task EditTransactionAsync(Transaction t)
    {
        var parameters = new DialogParameters { ["ExistingTransaction"] = t, ["AccountId"] = AppState.SelectedAccountId };
        var dlg = await DialogService.ShowAsync<TransactionDialog>("Transaktion bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await RefreshAsync();
    }

    private async Task DeleteTransactionAsync(Transaction t)
    {
        var dlg = await DialogService.ShowMessageBox("Löschen?",
            $"Transaktion \"{t.Note ?? t.Category?.Name ?? "Eintrag"}\" wirklich löschen?",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (dlg == true)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Transactions.Remove(db.Transactions.Find(t.Id)!);
            await db.SaveChangesAsync();
            await RefreshAsync();
        }
    }

    private async Task OpenImportDialogAsync()
    {
        var dlg = await DialogService.ShowAsync<CamtImportDialog>(
            "Kontoauszug importieren",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
            await RefreshAsync();
    }

    protected override void OnParametersSet()
    {
        // Reset when AddParam changes so repeated FAB clicks always open the dialog
        if (AddParam != _lastAddParam)
        {
            _lastAddParam = AddParam;
            if (!string.IsNullOrEmpty(AddParam))
                _addHandled = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_addHandled && !string.IsNullOrEmpty(AddParam))
        {
            _addHandled = true;
            if (AddParam == "income") await AddIncomeAsync();
            else if (AddParam == "expense") await AddExpenseAsync();
        }
    }

    public void Dispose()
    {
        AppState.OnAccountChanged -= OnAccountChanged;
    }
}
