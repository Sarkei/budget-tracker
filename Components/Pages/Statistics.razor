@page "/statistics"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using ApexCharts
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>Statistik – Budget Tracker</PageTitle>

<PageToolbar Title="Statistik">
    <div class="bt-pill-group">
        @foreach (var r in new[] { ("3M","3 Mon."), ("6M","6 Mon."), ("1J","1 Jahr"), ("ALT","Alles") })
        {
            var rKey = r.Item1;
            <button type="button" class="bt-pill @(_range == rKey ? "active" : "")" @onclick="() => SetRangeAsync(rKey)">
                @r.Item2
            </button>
        }
    </div>
</PageToolbar>

@if (_loading)
{
    <MudProgressLinear Color="MudBlazor.Color.Secondary" Indeterminate="true" Class="mb-4" />
}
else
{
    <!-- ── KPI strip ── -->
    <div >
        <div class="bt-kpi-mini" style="border-left:4px solid #66BB6A;">
            <div class="bt-kpi-label">Einnahmen gesamt</div>
            <div style="font-size:1.25rem; font-weight:700; color:#66BB6A; margin-top:3px;">@_totalIncome.ToString("C2", _de)</div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">@_rangeLabel</div>
        </div>
        <div class="bt-kpi-mini" style="border-left:4px solid #EF5350;">
            <div class="bt-kpi-label">Ausgaben gesamt</div>
            <div style="font-size:1.25rem; font-weight:700; color:#EF5350; margin-top:3px;">@_totalExpenses.ToString("C2", _de)</div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">@_rangeLabel</div>
        </div>
        <div class="bt-kpi-mini" style="@($"border-left:4px solid {(_netBalance >= 0 ? "#66BB6A" : "#EF5350")};")">
            <div class="bt-kpi-label">Ø Monatlich übrig</div>
            <div style="@($"font-size:1.25rem; font-weight:700; color:{(_avgMonthlyBalance >= 0 ? "#66BB6A" : "#EF5350")}; margin-top:3px;")">
                @_avgMonthlyBalance.ToString("C2", _de)
            </div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">Ø @_activeMonths Monate</div>
        </div>
        <div class="bt-kpi-mini" style="border-left:4px solid #FFA726;">
            <div class="bt-kpi-label">Sparquote</div>
            <div style="@($"font-size:1.25rem; font-weight:700; color:{(_savingsRate >= 0 ? "#FFA726" : "#EF5350")}; margin-top:3px;")">
                @_savingsRate.ToString("F1")%
            </div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">Einnahmen – Ausgaben</div>
        </div>
    </div>

    <!-- ── Row 1: Monatsbalken + Bilanzlinie ── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="8">
            <div class="stat-card" style="height:100%;">
                <div class="stat-label">Monatliche Einnahmen &amp; Ausgaben</div>
                @if (_monthlyBars.Any())
                {
                    <ApexChart TItem="MonthlyBar" Options="_barOpts" Height="260">
                        <ApexPointSeries TItem="MonthlyBar" Items="_monthlyBars" Name="Einnahmen"
                                         SeriesType="@ApexCharts.SeriesType.Bar"
                                         XValue="e => e.Label" YValue="e => e.Income" Color="#66BB6A" />
                        <ApexPointSeries TItem="MonthlyBar" Items="_monthlyBars" Name="Ausgaben"
                                         SeriesType="@ApexCharts.SeriesType.Bar"
                                         XValue="e => e.Label" YValue="e => e.Expenses" Color="#EF5350" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:80px 0; color:#A3A3A3; font-style:italic;">Keine Daten im gewählten Zeitraum</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <div class="stat-card" style="height:100%;">
                <div class="stat-label">Monatlicher Überschuss</div>
                @if (_balanceLine.Any())
                {
                    <ApexChart TItem="BalancePt" Options="_areaOpts" Height="260">
                        <ApexPointSeries TItem="BalancePt" Items="_balanceLine" Name="Bilanz"
                                         SeriesType="@ApexCharts.SeriesType.Area"
                                         XValue="e => e.Label" YValue="e => e.Value" Color="#14B8A6" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:80px 0; color:#A3A3A3; font-style:italic;">Keine Daten</div>
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Row 2: Ausgaben-Donut + Kategorien-Ranking ── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="5">
            <div class="stat-card" style="height:100%;">
                <div class="stat-label">Ausgaben nach Kategorie</div>
                @if (_catDonut.Any())
                {
                    <ApexChart TItem="CatSlice" Options="_donutOpts" Height="260">
                        <ApexPointSeries TItem="CatSlice" Items="_catDonut" Name="Ausgaben"
                                         SeriesType="@ApexCharts.SeriesType.Donut"
                                         XValue="e => e.Name" YValue="e => e.Amount"
                                         PointColor="e => e.Color" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:80px 0; color:#A3A3A3; font-style:italic;">Keine kategorisierten Ausgaben</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="7">
            <div class="stat-card" style="height:100%;">
                <div class="stat-label">Ausgaben-Kategorien Ranking</div>
                @if (!_catDonut.Any())
                {
                    <div class="ba-hint-italic">Keine kategorisierten Ausgaben</div>
                }
                else
                {
                    var maxC = _catDonut.Max(c => c.Amount);
                    @foreach (var cat in _catDonut)
                    {
                        var pct   = maxC > 0 ? (double)cat.Amount / (double)maxC * 100.0 : 0;
                        var share = _totalExpenses > 0 ? (double)cat.Amount / (double)_totalExpenses * 100.0 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
                                <div style="display:flex; align-items:center; gap:7px;">
                                    <span style="width:9px; height:9px; border-radius:50%; background:@cat.Color; display:inline-block; flex-shrink:0;"></span>
                                    <span style="font-size:0.85rem; color:#F5F5F5;">@cat.Name</span>
                                    <span style="font-size:0.7rem; color:#A3A3A3;">@share.ToString("F0")%</span>
                                </div>
                                <span style="font-size:0.85rem; font-weight:600; color:#EF5350;">@cat.Amount.ToString("C2", _de)</span>
                            </div>
                            <div class="stat-bar-track">
                                <div class="stat-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:@cat.Color;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Row 3: Monatsübersicht-Tabelle ── -->
    <div class="stat-card">
        <div class="stat-label">Monatsübersicht</div>
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="color:#A3A3A3; font-weight:600;">
                        <th style="padding:8px 12px; text-align:left; border-bottom:1px solid #303030;">Monat</th>
                        <th style="padding:8px 12px; text-align:right; color:#66BB6A; border-bottom:1px solid #303030;">Einnahmen</th>
                        <th style="padding:8px 12px; text-align:right; color:#EF5350; border-bottom:1px solid #303030;">Ausgaben</th>
                        <th style="padding:8px 12px; text-align:right; border-bottom:1px solid #303030;">Bilanz</th>
                        <th style="padding:8px 12px; text-align:right; border-bottom:1px solid #303030;">Sparquote</th>
                        <th style="padding:8px 12px; min-width:100px; text-align:left; border-bottom:1px solid #303030;">Ausgaben-Verlauf</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var maxME = _monthlyBars.Any() ? _monthlyBars.Max(m => m.Expenses) : 1m;
                    }
                    @foreach (var m in _monthlyBars)
                    {
                        var bal    = m.Income - m.Expenses;
                        var balC   = bal >= 0 ? "#66BB6A" : "#EF5350";
                        var spRate = m.Income > 0 ? (double)bal / (double)m.Income * 100.0 : 0.0;
                        var barPct = maxME > 0 ? (double)m.Expenses / (double)maxME * 100.0 : 0.0;
                        <tr style="border-bottom:1px solid #1e1e1e;">
                            <td style="padding:8px 12px; color:#F5F5F5; white-space:nowrap;">@m.Label</td>
                            <td style="padding:8px 12px; text-align:right; color:#66BB6A; font-weight:600;">@m.Income.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; color:#EF5350; font-weight:600;">@m.Expenses.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; font-weight:700; color:@balC; white-space:nowrap;">@bal.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; color:@(spRate >= 0 ? "#66BB6A" : "#EF5350"); white-space:nowrap;">@spRate.ToString("F0")%</td>
                            <td style="padding:8px 12px;">
                                <div class="stat-bar-track" style="height:6px;">
                                    <div class="stat-bar-fill" style="width:@barPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:#EF5350;"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!_monthlyBars.Any())
                    {
                        <tr><td colspan="6" style="padding:20px; text-align:center; color:#A3A3A3; font-style:italic;">Keine Daten im gewählten Zeitraum</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _de =
        System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading = true;
    private string _range = "6M";
    private string _rangeLabel = "letzte 6 Monate";
    private int _activeMonths;

    private decimal _totalIncome, _totalExpenses, _netBalance, _avgMonthlyBalance, _savingsRate;

    private List<MonthlyBar> _monthlyBars = new();
    private List<BalancePt>  _balanceLine = new();
    private List<CatSlice>   _catDonut    = new();

    // Inner data classes
    public class MonthlyBar { public string Label { get; set; } = ""; public decimal Income { get; set; } public decimal Expenses { get; set; } }
    public class BalancePt   { public string Label { get; set; } = ""; public decimal Value  { get; set; } }
    public class CatSlice    { public string Name  { get; set; } = ""; public decimal Amount { get; set; } public string Color { get; set; } = "#9E9E9E"; }

    // ── Chart Options ─────────────────────────────────────────────────────────

    private ApexChartOptions<MonthlyBar> _barOpts = new()
    {
        Chart     = new Chart { Type = ApexCharts.ChartType.Bar, Background = "transparent", ForeColor = "#A3A3A3", Toolbar = new Toolbar { Show = false } },
        Theme     = new Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { ColumnWidth = "65%", BorderRadius = 4 } },
        Xaxis  = new XAxis  { Labels = new XAxisLabels  { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } },
        Yaxis  = [new() { Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } }],
        Grid   = new Grid { BorderColor = "#404040" },
        Legend = new Legend { Position = LegendPosition.Top, Labels = new LegendLabels { Colors = "#A3A3A3" } }
    };

    private ApexChartOptions<BalancePt> _areaOpts = new()
    {
        Chart  = new Chart { Type = ApexCharts.ChartType.Area, Background = "transparent", ForeColor = "#A3A3A3", Toolbar = new Toolbar { Show = false } },
        Theme  = new Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        Fill   = new Fill { Type = FillType.Gradient, Gradient = new FillGradient { ShadeIntensity = 0.5, OpacityFrom = 0.4, OpacityTo = 0.05 } },
        Xaxis  = new XAxis  { Labels = new XAxisLabels  { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } },
        Yaxis  = [new() { Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } }],
        Grid   = new Grid { BorderColor = "#404040" },
        Legend = new Legend { Show = false }
    };

    private ApexChartOptions<CatSlice> _donutOpts = new()
    {
        Chart  = new Chart { Type = ApexCharts.ChartType.Donut, Background = "transparent", ForeColor = "#A3A3A3" },
        Theme  = new Theme { Mode = ApexCharts.Mode.Dark },
        Legend = new Legend { Position = LegendPosition.Bottom, Labels = new LegendLabels { Colors = "#A3A3A3" } },
        PlotOptions = new PlotOptions { Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "60%" } } }
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged     += OnStateChanged;
        AppState.OnTransactionChanged += OnStateChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        AppState.OnAccountChanged     -= OnStateChanged;
        AppState.OnTransactionChanged -= OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetRangeAsync(string range)
    {
        _range = range;
        await LoadAsync();
    }

    private (DateTime? from, DateTime? to) GetDateRange()
    {
        var today = DateTime.Today;
        return _range switch
        {
            "3M"  => (today.AddMonths(-3),  null),
            "6M"  => (today.AddMonths(-6),  null),
            "1J"  => (today.AddMonths(-12), null),
            _     => ((DateTime?)null,      null)
        };
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var (from, to) = GetDateRange();
        _rangeLabel = _range switch
        {
            "3M" => "letzte 3 Monate",
            "6M" => "letzte 6 Monate",
            "1J" => "letztes Jahr",
            _    => "gesamt"
        };

        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.Transactions.Include(t => t.Category).AsQueryable();
        if (from.HasValue) q = q.Where(t => t.Date >= from.Value);
        if (to.HasValue)   q = q.Where(t => t.Date < to.Value);
        if (AppState.SelectedAccountId.HasValue)
            q = q.Where(t => t.AccountId == AppState.SelectedAccountId.Value);

        var txList = await q.OrderBy(t => t.Date).ToListAsync();

        var expList = txList.Where(t => t.Type == TransactionType.Expense).ToList();
        var incList = txList.Where(t => t.Type == TransactionType.Income).ToList();

        _totalIncome   = incList.Sum(t => t.Amount);
        _totalExpenses = expList.Sum(t => t.Amount);
        _netBalance    = _totalIncome - _totalExpenses;
        _activeMonths  = txList
            .Select(t => new { t.Date.Year, t.Date.Month })
            .Distinct().Count();
        _avgMonthlyBalance = _activeMonths > 0 ? _netBalance / _activeMonths : 0;
        _savingsRate       = _totalIncome > 0
            ? (decimal)((double)(_netBalance / _totalIncome) * 100.0)
            : 0;

        // Monthly bars
        _monthlyBars = txList
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
            .Select(g => new MonthlyBar
            {
                Label    = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yy", _de),
                Income   = g.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount),
                Expenses = g.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount)
            })
            .ToList();

        // Balance line
        _balanceLine = _monthlyBars
            .Select(m => new BalancePt { Label = m.Label, Value = m.Income - m.Expenses })
            .ToList();

        // Category donut – top 8 expense categories by amount, rest → "Sonstige"
        var catPalette = new[]
        {
            "#EF5350","#FFA726","#FFCA28","#66BB6A",
            "#26C6DA","#14B8A6","#AB47BC","#EC407A"
        };
        var catGroups = expList
            .Where(t => t.Category != null)
            .GroupBy(t => t.Category!)
            .Select(g => new { g.Key.Name, Color = g.Key.ColorHex ?? "#9E9E9E", Amount = g.Sum(t => t.Amount) })
            .OrderByDescending(c => c.Amount)
            .ToList();

        var top8 = catGroups.Take(8).ToList();
        var rest = catGroups.Skip(8).Sum(c => c.Amount);

        _catDonut = top8
            .Select((c, i) => new CatSlice
            {
                Name   = c.Name,
                Amount = c.Amount,
                Color  = string.IsNullOrWhiteSpace(c.Color) || c.Color == "#9E9E9E"
                    ? catPalette[i % catPalette.Length]
                    : c.Color
            })
            .ToList();

        if (rest > 0)
            _catDonut.Add(new CatSlice { Name = "Sonstige", Amount = rest, Color = "#A3A3A3" });

        _loading = false;
    }
}
