    private async Task SetDefaultAccountAsync(Account a)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        bool newDefault = !a.IsDefault;
        var all = await db.Accounts.Where(acc => acc.IsActive).ToListAsync();
        foreach (var acc in all) acc.IsDefault = (acc.Id == a.Id) && newDefault;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

