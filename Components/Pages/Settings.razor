    public void Dispose()
    {
        if (_currentUserId > 0) GroupNotifSvc.UnregisterProfileUpdate(_currentUserId);
    }

    private async Task OnOwnProfileUpdatedAsync()
    {
        if (_currentUserId <= 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var u = await db.Users.FindAsync(_currentUserId);
        if (u == null) return;
        _currentFirstName = u.FirstName ?? "";
        _currentLastName  = u.LastName  ?? "";
        _currentEmail     = u.Username  ?? "";
        await InvokeAsync(() =>
        {
            Snackbar.Add("Dein Profil wurde vom Administrator aktualisiert.", Severity.Info);
            StateHasChanged();
        });
    }
