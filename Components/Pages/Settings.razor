    private async Task SaveBudgetAsync()
    {
        if (_prefs.EnableBudgetWarnings && !string.IsNullOrWhiteSpace(_budgetLimitStr))
        {
            var cleaned = _budgetLimitStr.Replace(",", ".").Trim();
            if (decimal.TryParse(cleaned,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out var limit))
            {
                _prefs.MonthlyBudgetLimit = limit;
            }
            else
            {
                Snackbar.Add("Bitte einen gültigen Betrag eingeben.", Severity.Warning);
                return;
            }
        }
        _saving = true;
        await PrefsService.SaveAsync();
        _saving = false;
        Snackbar.Add("Budget-Einstellungen gespeichert.", Severity.Success);
    }

