@page "/recurring"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService

<PageTitle>Wiederkehrend – Budget Tracker</PageTitle>

<PageToolbar Title="Wiederkehrende Posten">
    <MudMenu Label="Hinzufügen" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Secondary" AnchorOrigin="Origin.BottomLeft">
        <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" IconColor="Color.Success" OnClick="AddIncomeItemAsync">Einnahme</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" IconColor="Color.Error" OnClick="AddExpenseItemAsync">Ausgabe</MudMenuItem>
    </MudMenu>
</PageToolbar>

@if (_loading) { <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" /> }

<!-- Summary -->
<div class="bt-kpi-grid-4">
        <div class="bt-kpi-mini bt-kpi-mini--success">
            <div class="bt-kpi-label">Fixe Einnahmen/Monat</div>
            <div class="bt-kpi-value bt-kpi-accent-success" style="font-size:1.25rem;">@_totalIncome.ToString("C2", _de)</div>
        </div>
        <div class="bt-kpi-mini bt-kpi-mini--error">
            <div class="bt-kpi-label">Fixe Ausgaben/Monat</div>
            <div class="bt-kpi-value bt-kpi-accent-error" style="font-size:1.25rem;">@_totalExpenses.ToString("C2", _de)</div>
        </div>
        <div class="bt-kpi-mini bt-kpi-mini--warning">
            <div class="bt-kpi-label">Raten/Monat</div>
            <div class="bt-kpi-value" style="font-size:1.25rem; color:#ffa726;">@_totalInstallments.ToString("C2", _de)</div>
        </div>
        <div class="bt-kpi-mini @(_netMonthly >= 0 ? "bt-kpi-mini--success" : "bt-kpi-mini--error")">
            <div class="bt-kpi-label">Netto/Monat</div>
            <div class="bt-kpi-value @(_netMonthly >= 0 ? "bt-kpi-accent-success" : "bt-kpi-accent-error")" style="font-size:1.25rem;">@_netMonthly.ToString("C2", _de)</div>
        </div>
</div>

<!-- Income list -->
<MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--success">
    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Style="vertical-align:middle; margin-right:4px;" />
    Fixe Einnahmen (@_incomeItems.Count)
</MudText>
<div class="bt-panel mb-2">
    @if (!_incomeItems.Any())
    {
        <MudText Class="bt-pad-muted-italic">Keine Einträge</MudText>
    }
    else
    {
        <MudList T="RecurringItem" Dense="true" DisablePadding="true">
            @foreach (var item in _incomeItems)
            {
                <MudListItem T="RecurringItem">
                    <div class="rec-row">
                        <div class="bt-category-dot" style="@($"background:{item.Category?.ColorHex ?? "#9E9E9E"};")"></div>
                        <div class="rec-info">
                            <MudText Typo="Typo.body2">@item.Name</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">
                                @IntervalLabel(item.Interval) · @(item.Account?.Name ?? "")
                                @if (item.IsInstallment) { <text> · @item.PaidInstallments/@item.TotalInstallments Raten</text> }
                            </MudText>
                        </div>
                        <div class="rec-actions">
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-right:8px;">
                                @item.Amount.ToString("C2", _de)/@IntervalLabel(item.Interval).Substring(0, 3).
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => EditItemAsync(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItemAsync(item))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

<!-- Expense list -->
<MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--error">
    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Style="vertical-align:middle; margin-right:4px;" />
    Fixe Ausgaben (@_expenseItems.Count)
</MudText>
<div class="bt-panel mb-2">
    @if (!_expenseItems.Any())
    {
        <MudText Class="bt-pad-muted-italic">Keine Einträge</MudText>
    }
    else
    {
        <MudList T="RecurringItem" Dense="true" DisablePadding="true">
            @foreach (var item in _expenseItems)
            {
                <MudListItem T="RecurringItem">
                    <div class="rec-row">
                        <div class="bt-category-dot" style="@($"background:{item.Category?.ColorHex ?? "#9E9E9E"};")"></div>
                        <div class="rec-info">
                            <MudText Typo="Typo.body2">@item.Name</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">@IntervalLabel(item.Interval) · @(item.Account?.Name ?? "")</MudText>
                        </div>
                        <div class="rec-actions">
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-right:8px;">
                                @item.Amount.ToString("C2", _de)/@IntervalLabel(item.Interval).Substring(0, 3).
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => EditItemAsync(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItemAsync(item))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

<!-- Installments list -->
<MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-text-warning" Style="margin-top:1rem;">
    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="vertical-align:middle; margin-right:4px;" />
    Ratenzahlungen (@_installmentItems.Count)
</MudText>
<div class="bt-panel mb-2">
    @if (!_installmentItems.Any())
    {
        <MudText Class="bt-pad-muted-italic">Keine Einträge</MudText>
    }
    else
    {
        <MudList T="RecurringItem" Dense="true" DisablePadding="true">
            @foreach (var item in _installmentItems)
            {
                <MudListItem T="RecurringItem">
                    <div class="rec-row">
                        <div class="bt-category-dot" style="@($"background:{item.Category?.ColorHex ?? "#9E9E9E"};")"></div>
                        <div class="rec-info">
                            <MudText Typo="Typo.body2">@item.Name</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">
                                @IntervalLabel(item.Interval) · @(item.Account?.Name ?? "") · @item.PaidInstallments/@item.TotalInstallments Raten
                            </MudText>
                        </div>
                        <div class="rec-actions">
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-right:8px;">
                                @item.Amount.ToString("C2", _de)/@IntervalLabel(item.Interval).Substring(0, 3).
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => EditItemAsync(item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItemAsync(item))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading;
    private List<RecurringItem> _incomeItems = new();
    private List<RecurringItem> _expenseItems = new();
    private List<RecurringItem> _installmentItems = new();
    private decimal _totalIncome, _totalExpenses, _totalInstallments, _netMonthly;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += OnAccountChanged;
        await LoadAsync();
    }

    private async void OnAccountChanged() { await LoadAsync(); await InvokeAsync(StateHasChanged); }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.RecurringItems.Include(r => r.Category).Include(r => r.Account).Where(r => r.IsActive).AsQueryable();
        if (AppState.SelectedAccountId.HasValue)
            q = q.Where(r => r.AccountId == AppState.SelectedAccountId.Value);

        var all = await q.OrderBy(r => r.Name).ToListAsync();
        _incomeItems = all.Where(r => r.Type == TransactionType.Income && !r.IsInstallment).ToList();
        _expenseItems = all.Where(r => r.Type == TransactionType.Expense && !r.IsInstallment).ToList();
        _installmentItems = all.Where(r => r.IsInstallment).ToList();

        _totalIncome = _incomeItems.Sum(ToMonthly);
        _totalExpenses = _expenseItems.Sum(ToMonthly);
        _totalInstallments = _installmentItems.Sum(ToMonthly);
        _netMonthly = _totalIncome - _totalExpenses - _totalInstallments;

        _loading = false;
    }

    private static decimal ToMonthly(RecurringItem r) => r.Interval switch
    {
        RecurringInterval.Weekly => r.Amount * 52m / 12m,
        RecurringInterval.Monthly => r.Amount,
        RecurringInterval.Quarterly => r.Amount / 3m,
        RecurringInterval.Yearly => r.Amount / 12m,
        _ => r.Amount
    };

    private static string IntervalLabel(RecurringInterval i) => i switch
    {
        RecurringInterval.Weekly => "wöchentlich",
        RecurringInterval.Monthly => "monatlich",
        RecurringInterval.Quarterly => "quartalsweise",
        RecurringInterval.Yearly => "jährlich",
        _ => "–"
    };

    private async Task AddIncomeItemAsync()
    {
        var parameters = new DialogParameters { ["AccountId"] = AppState.SelectedAccountId, ["IsExpense"] = false, ["HasTypePreset"] = true };
        var dlg = await DialogService.ShowAsync<RecurringDialog>("Wiederkehrenden Posten hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await LoadAsync();
    }

    private async Task AddExpenseItemAsync()
    {
        var parameters = new DialogParameters { ["AccountId"] = AppState.SelectedAccountId, ["IsExpense"] = true, ["HasTypePreset"] = true };
        var dlg = await DialogService.ShowAsync<RecurringDialog>("Wiederkehrenden Posten hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await LoadAsync();
    }

    private async Task EditItemAsync(RecurringItem item)
    {
        var parameters = new DialogParameters { ["ExistingItem"] = item, ["AccountId"] = AppState.SelectedAccountId };
        var dlg = await DialogService.ShowAsync<RecurringDialog>("Posten bearbeiten", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await LoadAsync();
    }

    private async Task DeleteItemAsync(RecurringItem item)
    {
        var dlg = await DialogService.ShowMessageBox("Deaktivieren?",
            $"\"{item.Name}\" wirklich deaktivieren? (Transaktionshistorie bleibt erhalten)",
            yesText: "Deaktivieren", cancelText: "Abbrechen");
        if (dlg == true)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.RecurringItems.FindAsync(item.Id);
            if (entity != null) { entity.IsActive = false; await db.SaveChangesAsync(); }
            await LoadAsync();
        }
    }

    public void Dispose() => AppState.OnAccountChanged -= OnAccountChanged;
}
