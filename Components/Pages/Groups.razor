@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject AppStateService AppState

<PageTitle>Gemeinsame Ausgaben – Budget Tracker</PageTitle>

<PageToolbar Title="Gemeinsame Ausgaben">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.GroupAdd"
               OnClick="CreateGroupAsync">Gruppe erstellen</MudButton>
</PageToolbar>

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
}

@if (!_groups.Any() && !_loading)
{
    <MudPaper Class="bt-empty-state">
        <MudIcon Icon="@Icons.Material.Filled.Group" Class="bt-empty-icon" />
        <MudText Typo="Typo.h6" Class="bt-text-muted" Style="margin-top:16px;">Noch keine Gruppen</MudText>
        <MudText Typo="Typo.body2" Class="bt-text-muted" Style="margin-bottom:24px;">
            Erstelle eine Gruppe, um gemeinsame Ausgaben mit Freunden, Familie oder Mitbewohnern zu teilen.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.GroupAdd"
                   OnClick="CreateGroupAsync">Erste Gruppe erstellen</MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var g in _groups)
        {
            var balances = ComputeBalances(g);
            <MudItem xs="12" sm="6" md="4">
                <div class="bt-group-card" style="@($"border-top:3px solid {g.ColorHex};")"
                     @onclick="() => OpenGroup(g.Slug)">
                    <div class="bt-flex-between" style="margin-bottom:12px;">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="bt-text-foreground" Style="font-weight:700;">@g.Name</MudText>
                            @if (!string.IsNullOrEmpty(g.Description))
                            {
                                <MudText Typo="Typo.caption" Class="bt-text-muted">@g.Description</MudText>
                            }
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="bt-text-muted" Size="Size.Small" />
                    </div>

                    <div class="bt-group-inner">
                        <table class="bt-table-compact">
                            <thead>
                                <tr>
                                    <th>Mitglied</th>
                                    <th class="bt-th-right">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in g.Members)
                                {
                                    var name = GetMemberName(m);
                                    var bal = balances.TryGetValue(m.UserId, out var b) ? b : 0m;
                                    var balClass = UiClasses.BalanceText(bal);
                                    var balSign = bal > 0.005m ? "+" : "";
                                    var isMe = m.UserId == _currentUserId;
                                    <tr>
                                        <td class="@(isMe ? "bt-me bt-member-name" : "bt-member-name")">
                                            @if (isMe) { <span>Du</span> } else { @name }
                                        </td>
                                        <td class="bt-td-right @balClass">
                                            @balSign@bal.ToString("C2", _de)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer stats -->
                    <div style="display:flex; gap:16px; margin-top:10px;">
                        <div>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">Ausgaben</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-muted" Style="font-weight:600;">@g.Expenses.Count</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">Gesamt</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-error" Style="font-weight:600;">
                                @g.Expenses.Sum(e => e.TotalAmount).ToString("C2", _de)
                            </MudText>
                        </div>
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private static readonly System.Globalization.CultureInfo _de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading = true;
    private List<SharedGroup> _groups = new();
    private Dictionary<int, List<GroupSettlement>> _settlementsByGroup = new();
    private int _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = UserService.GetUserId(authState.User) ?? 0;
        AppState.OnGroupsChanged += HandleGroupsChanged;
        await LoadAsync();
    }

    private async void HandleGroupsChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppState.OnGroupsChanged -= HandleGroupsChanged;
    }

    private void OpenGroup(string slug) => Nav.NavigateTo($"/groups/{slug}");

    private static string GetMemberName(GroupMember m)
    {
        if (m.User == null) return $"User {m.UserId}";
        if (!string.IsNullOrEmpty(m.User.DisplayName)) return m.User.DisplayName;
        var full = $"{m.User.FirstName} {m.User.LastName}".Trim();
        return string.IsNullOrEmpty(full) ? m.User.Username : full;
    }

    // Compute net balance per user for a group
    private Dictionary<int, decimal> ComputeBalances(SharedGroup g)
    {
        var balances = g.Members.ToDictionary(m => m.UserId, _ => 0m);
        var settlements = _settlementsByGroup.TryGetValue(g.Id, out var s) ? s : new List<GroupSettlement>();

        // Credit/debit from expenses (only current expenses, exclude imported history)
        foreach (var expense in g.Expenses.Where(e => !e.IsImported))
        {
            foreach (var split in expense.Splits.Where(sp => sp.UserId != expense.PaidByUserId))
            {
                if (!balances.ContainsKey(expense.PaidByUserId)) balances[expense.PaidByUserId] = 0;
                if (!balances.ContainsKey(split.UserId)) balances[split.UserId] = 0;
                balances[expense.PaidByUserId] += split.Amount;
                balances[split.UserId] -= split.Amount;
            }
        }

        // Apply settlements
        foreach (var settlement in settlements)
        {
            if (balances.ContainsKey(settlement.PayerUserId)) balances[settlement.PayerUserId] += settlement.Amount;
            if (balances.ContainsKey(settlement.PayeeUserId)) balances[settlement.PayeeUserId] -= settlement.Amount;
        }

        return balances;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        _groups = await db.SharedGroups
            .Include(g => g.Members).ThenInclude(m => m.User)
            .Include(g => g.Expenses).ThenInclude(e => e.Splits)
            .Where(g => g.IsActive && g.Members.Any(m => m.UserId == _currentUserId))
            .OrderBy(g => g.Name)
            .ToListAsync();

        var groupIds = _groups.Select(g => g.Id).ToList();
        var settlements = await db.GroupSettlements
            .Where(s => groupIds.Contains(s.GroupId))
            .ToListAsync();
        _settlementsByGroup = settlements.GroupBy(s => s.GroupId)
            .ToDictionary(grp => grp.Key, grp => grp.ToList());

        _loading = false;
    }

    private async Task CreateGroupAsync()
    {
        var parameters = new DialogParameters { ["CurrentUserId"] = _currentUserId };
        var dlg = await DialogService.ShowAsync<GroupDialog>("Gruppe erstellen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dlg.Result)!.Canceled) await LoadAsync();
    }
}
