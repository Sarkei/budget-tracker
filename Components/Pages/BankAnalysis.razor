@page "/bank-analysis"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService

<PageTitle>Kontoauszug-Analyse – Budget Tracker</PageTitle>

<PageToolbar Title="Kontoauszug-Analyse">
    <MudSelect T="int" @bind-Value="_filterYear" Variant="Variant.Outlined" Dense="true"
               Style="max-width:110px;" Label="Jahr">
        @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
        {
            var yr = y;
            <MudSelectItem Value="yr">@yr</MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync">Laden</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.UploadFile"
               OnClick="OpenImportDialogAsync">CSV importieren</MudButton>
</PageToolbar>

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
}
else
{
    <!-- ── KPI Cards ── -->
    <div class="ba-kpi-grid" >
        <div class="bt-kpi-mini bt-kpi-mini--success">
            <div class="bt-kpi-label">Einnahmen @_filterYear</div>
            <div class="bt-kpi-value bt-kpi-accent-success" style="font-size:1.35rem;margin-top:4px;">
                @_totalIncome.ToString("C2", _de)
            </div>
        </div>
        <div class="bt-kpi-mini bt-kpi-mini--error">
            <div class="bt-kpi-label">Ausgaben @_filterYear</div>
            <div class="bt-kpi-value bt-kpi-accent-error" style="font-size:1.35rem;margin-top:4px;">
                @_totalExpenses.ToString("C2", _de)
            </div>
        </div>
        <div class="bt-kpi-mini @(_netBalance >= 0 ? "bt-kpi-mini--success" : "bt-kpi-mini--error")">
            <div class="bt-kpi-label">Bilanz</div>
            <div class="bt-kpi-value @(_netBalance >= 0 ? "bt-kpi-accent-success" : "bt-kpi-accent-error")" style="font-size:1.35rem;margin-top:4px;">
                @_netBalance.ToString("C2", _de)
            </div>
        </div>
        <div class="bt-kpi-mini bt-kpi-mini--brand">
            <div class="bt-kpi-label">Ø Monatl. Ausgaben</div>
            <div class="bt-kpi-value bt-kpi-accent-brand" style="font-size:1.35rem;margin-top:4px;">
                @_avgMonthlyExpense.ToString("C2", _de)
            </div>
        </div>
    </div>

    <MudGrid Spacing="3">
        <!-- ── LEFT COLUMN ── -->
        <MudItem xs="12" md="6">

            <!-- Wiederkehrende Buchungen -->
            <div class="ba-section">
                <div class="ba-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Repeat" Style="font-size:16px; vertical-align:middle; margin-right:4px;" />
                    Wiederkehrende Ausgaben
                    <span class="ba-tag ba-recurring-chip" style="margin-left:8px;">
                        @_recurring.Count Buchungen · @_recurringTotal.ToString("C0", _de)/Monat
                    </span>
                </div>
                @if (_recurring.Count == 0)
                {
                    <div class="ba-hint-italic">Keine erkannt (mind. 2 Monate erforderlich)</div>
                }
                else
                {
                    @foreach (var r in _recurring.Take(20))
                    {
                        <div class="ba-row">
                            <div class="ba-row-label">
                                <div class="ba-row-title">
                                    @r.Counterparty
                                </div>
                                <div class="ba-row-meta">
                                    @r.MonthCount× in @_filterYear · Ø @r.AvgAmount.ToString("C2", _de)/Monat
                                </div>
                            </div>
                            <span class="ba-tag ba-recurring-chip">monatlich</span>
                            <span class="ba-row-amount ba-row-amount--expense">
                                -@r.TotalAmount.ToString("C2", _de)
                            </span>
                        </div>
                    }
                }
            </div>

            <!-- Einmalige Ausgaben (Top 15) -->
            <div class="ba-section">
                <div class="ba-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Style="font-size:16px; vertical-align:middle; margin-right:4px;" />
                    Größte Einmal-Ausgaben
                    <span class="ba-tag ba-onetime-chip" style="margin-left:8px;">Top @Math.Min(15, _oneTime.Count)</span>
                </div>
                @if (_oneTime.Count == 0)
                {
                    <div class="ba-hint-italic">Keine einmaligen Ausgaben gefunden</div>
                }
                else
                {
                    @foreach (var t in _oneTime.Take(15))
                    {
                        <div class="ba-row">
                            <div class="ba-row-label">
                                <div class="ba-row-title">
                                    @(t.Note ?? "–")
                                </div>
                                <div style="font-size:0.72rem; color:#A3A3A3;">
                                    @t.Date.ToString("dd.MM.yyyy")
                                    @if (t.Category != null) { <span> · @t.Category.Name</span> }
                                </div>
                            </div>
                            <span class="ba-row-amount ba-row-amount--expense">
                                -@t.Amount.ToString("C2", _de)
                            </span>
                        </div>
                    }
                }
            </div>
        </MudItem>

        <!-- ── RIGHT COLUMN ── -->
        <MudItem xs="12" md="6">

            <!-- Ausgaben nach Kategorie -->
            <div class="ba-section">
                <div class="ba-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Style="font-size:16px; vertical-align:middle; margin-right:4px;" />
                    Ausgaben nach Kategorie
                </div>
                @if (_byCategory.Count == 0)
                {
                    <div class="ba-hint-italic">Keine kategorisierten Ausgaben</div>
                }
                else
                {
                    var maxCat = _byCategory.Max(c => c.Total);
                    @foreach (var cat in _byCategory)
                    {
                        var pct = maxCat > 0 ? (double)cat.Total / (double)maxCat * 100 : 0;
                        var sharePct = _totalExpenses > 0 ? (double)cat.Total / (double)_totalExpenses * 100 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <span style="width:10px; height:10px; border-radius:50%; background:@cat.ColorHex; display:inline-block; flex-shrink:0;"></span>
                                    <span style="font-size:0.85rem; color:#F5F5F5;">@cat.CategoryName</span>
                                    <span style="font-size:0.72rem; color:#A3A3A3;">@sharePct.ToString("F0")%</span>
                                </div>
                                <span style="font-size:0.88rem; font-weight:600; color:#EF5350;">
                                    @cat.Total.ToString("C2", _de)
                                </span>
                            </div>
                            <div class="ba-bar-track">
                                <div class="ba-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:@cat.ColorHex;"></div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Top Händler / Empfänger -->
            <div class="ba-section">
                <div class="ba-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Style="font-size:16px; vertical-align:middle; margin-right:4px;" />
                    Top Händler / Empfänger
                </div>
                @if (_topCounterparties.Count == 0)
                {
                    <div class="ba-hint-italic">Keine Daten</div>
                }
                else
                {
                    var maxCP = _topCounterparties.Max(c => c.Total);
                    @foreach (var cp in _topCounterparties)
                    {
                        var pct = maxCP > 0 ? (double)cp.Total / (double)maxCP * 100 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
                                <div style="min-width:0; flex:1;">
                                    <span style="font-size:0.85rem; color:#F5F5F5; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">
                                        @cp.Name
                                    </span>
                                    <span style="font-size:0.72rem; color:#A3A3A3;">@cp.Count× Buchungen</span>
                                </div>
                                <span style="font-size:0.88rem; font-weight:600; color:#EF5350; margin-left:12px;">
                                    @cp.Total.ToString("C2", _de)
                                </span>
                            </div>
                            <div class="ba-bar-track">
                                <div class="ba-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:#EF5350;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Monthly Overview ── -->
    <div class="ba-section">
        <div class="ba-section-title">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Style="font-size:16px; vertical-align:middle; margin-right:4px;" />
            Monatlicher Verlauf @_filterYear
        </div>
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="color:#A3A3A3;">
                        <th style="padding:8px 12px; text-align:left; font-weight:600;">Monat</th>
                        <th style="padding:8px 12px; text-align:right; font-weight:600; color:#66BB6A;">Einnahmen</th>
                        <th style="padding:8px 12px; text-align:right; font-weight:600; color:#EF5350;">Ausgaben</th>
                        <th style="padding:8px 12px; text-align:right; font-weight:600;">Bilanz</th>
                        <th style="padding:8px 12px; text-align:left; font-weight:600; min-width:120px;">Verlauf</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var maxMonthExp = _monthlyData.Any() ? _monthlyData.Max(m => m.Expenses) : 1;
                    }
                    @foreach (var m in _monthlyData)
                    {
                        var pctBar = maxMonthExp > 0 ? (double)m.Expenses / (double)maxMonthExp * 100 : 0;
                        var balColor = m.Balance >= 0 ? "#66BB6A" : "#EF5350";
                        <tr class="ba-month-row" style="border-bottom:1px solid #1e1e1e;">
                            <td style="padding:8px 12px; color:#F5F5F5; white-space:nowrap;">
                                @(new DateTime(_filterYear, m.Month, 1).ToString("MMMM", _de))
                            </td>
                            <td style="padding:8px 12px; text-align:right; color:#66BB6A; font-weight:600;">
                                @m.Income.ToString("C2", _de)
                            </td>
                            <td style="padding:8px 12px; text-align:right; color:#EF5350; font-weight:600;">
                                @m.Expenses.ToString("C2", _de)
                            </td>
                            <td style="padding:8px 12px; text-align:right; font-weight:700; color:@balColor;">
                                @m.Balance.ToString("C2", _de)
                            </td>
                            <td style="padding:8px 12px;">
                                <div class="ba-bar-track" style="height:6px;">
                                    <div class="ba-bar-fill"
                                         style="width:@pctBar.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:#EF5350;">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _de =
        System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading;
    private int _filterYear = DateTime.Today.Year;

    // KPIs
    private decimal _totalIncome, _totalExpenses, _netBalance, _avgMonthlyExpense;

    // Sections
    private List<RecurringEntry> _recurring = new();
    private decimal _recurringTotal;
    private List<Transaction> _oneTime = new();
    private List<CategoryEntry> _byCategory = new();
    private List<CounterpartyEntry> _topCounterparties = new();
    private List<MonthEntry> _monthlyData = new();

    // ── Data classes ─────────────────────────────────────────────────────────

    private record RecurringEntry(string Counterparty, int MonthCount, decimal TotalAmount, decimal AvgAmount);
    private record CategoryEntry(string CategoryName, string ColorHex, decimal Total);
    private record CounterpartyEntry(string Name, int Count, decimal Total);
    private record MonthEntry(int Month, decimal Income, decimal Expenses, decimal Balance);

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged += OnStateChanged;
        AppState.OnTransactionChanged += OnStateChanged;
        await LoadAsync();
    }

    private async void OnStateChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await using var db = await DbFactory.CreateDbContextAsync();

        var yearStart = new DateTime(_filterYear, 1, 1);
        var yearEnd = yearStart.AddYears(1);

        var query = db.Transactions
            .Include(t => t.Category)
            .Where(t => t.Date >= yearStart && t.Date < yearEnd);

        if (AppState.SelectedAccountId.HasValue)
            query = query.Where(t => t.AccountId == AppState.SelectedAccountId.Value);

        var txList = await query.OrderBy(t => t.Date).ToListAsync();

        var expenses = txList.Where(t => t.Type == TransactionType.Expense).ToList();
        var incomes  = txList.Where(t => t.Type == TransactionType.Income).ToList();

        _totalIncome    = incomes.Sum(t => t.Amount);
        _totalExpenses  = expenses.Sum(t => t.Amount);
        _netBalance     = _totalIncome - _totalExpenses;

        int activeMonths = expenses
            .Select(t => t.Date.Month)
            .Distinct()
            .Count();
        _avgMonthlyExpense = activeMonths > 0 ? _totalExpenses / activeMonths : 0;

        // ── Wiederkehrende vs. Einmalige ──────────────────────────────────────
        // Group expenses by counterparty (from Note field), detect recurring (2+ months)
        var counterpartyGroups = expenses
            .Where(t => !string.IsNullOrWhiteSpace(t.Note))
            .GroupBy(t => NormalizeCounterparty(t.Note!))
            .Where(g => g.Key.Length > 3)
            .ToList();

        var recurringGroups = counterpartyGroups
            .Where(g => g.Select(t => t.Date.Month).Distinct().Count() >= 2)
            .OrderByDescending(g => g.Sum(t => t.Amount))
            .ToList();

        _recurring = recurringGroups
            .Select(g =>
            {
                var total  = g.Sum(t => t.Amount);
                var months = g.Select(t => t.Date.Month).Distinct().Count();
                return new RecurringEntry(
                    Counterparty: g.Key,
                    MonthCount: months,
                    TotalAmount: total,
                    AvgAmount: total / months);
            })
            .ToList();
        _recurringTotal = _recurring.Any() ? _recurring.Average(r => r.AvgAmount) : 0;

        // One-time: expenses whose counterparty key appears in only 1 month, top by amount
        var recurringKeys = recurringGroups.Select(g => g.Key).ToHashSet();
        _oneTime = expenses
            .Where(t => string.IsNullOrWhiteSpace(t.Note)
                        || !recurringKeys.Contains(NormalizeCounterparty(t.Note)))
            .OrderByDescending(t => t.Amount)
            .Take(20)
            .ToList();

        // ── By Category ───────────────────────────────────────────────────────
        _byCategory = expenses
            .GroupBy(t => new
            {
                Name  = t.Category?.Name ?? "Ohne Kategorie",
                Color = t.Category?.ColorHex ?? "#A3A3A3"
            })
            .Select(g => new CategoryEntry(g.Key.Name, g.Key.Color, g.Sum(t => t.Amount)))
            .OrderByDescending(c => c.Total)
            .ToList();

        // ── Top Counterparties ────────────────────────────────────────────────
        _topCounterparties = expenses
            .Where(t => !string.IsNullOrWhiteSpace(t.Note))
            .GroupBy(t => NormalizeCounterparty(t.Note!))
            .Where(g => g.Key.Length > 3)
            .Select(g => new CounterpartyEntry(g.Key, g.Count(), g.Sum(t => t.Amount)))
            .OrderByDescending(c => c.Total)
            .Take(15)
            .ToList();

        // ── Monthly Data ──────────────────────────────────────────────────────
        _monthlyData = Enumerable.Range(1, 12)
            .Select(m => new MonthEntry(
                Month: m,
                Income: incomes.Where(t => t.Date.Month == m).Sum(t => t.Amount),
                Expenses: expenses.Where(t => t.Date.Month == m).Sum(t => t.Amount),
                Balance: incomes.Where(t => t.Date.Month == m).Sum(t => t.Amount)
                       - expenses.Where(t => t.Date.Month == m).Sum(t => t.Amount)))
            .Where(m => m.Income > 0 || m.Expenses > 0)
            .ToList();

        _loading = false;
    }

    private async Task OpenImportDialogAsync()
    {
        var dlg = await DialogService.ShowAsync<CamtImportDialog>(
            "Kontoauszug importieren",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
            await LoadAsync();
    }

    /// <summary>Extract a readable counterparty label from a transaction Note field.</summary>
    private static string NormalizeCounterparty(string note)
    {
        // Notes are stored as "Counterparty | BookingText | Purpose"
        // Take the first segment as the primary identifier
        var first = note.Split('|')[0].Trim();
        if (string.IsNullOrWhiteSpace(first)) return note.Trim().ToUpperInvariant();

        // Truncate to first 30 chars to group similar entries
        var up = first.ToUpperInvariant();
        return up.Length > 30 ? up[..30].TrimEnd() : up;
    }
}
