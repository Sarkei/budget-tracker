@page "/finance-overview"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using ApexCharts
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService

<PageTitle>Finanzübersicht – Budget Tracker</PageTitle>

<PageToolbar Title="Finanzübersicht">
    <div class="bt-pill-group">
        @foreach (var r in new[] { ("3M","3 Monate"), ("6M","6 Monate"), ("1J","1 Jahr"), ("ALT","Alles") })
        {
            var rKey = r.Item1;
            <button type="button" class="bt-pill @(_range == rKey ? "active" : "")" @onclick="() => SetRangeAsync(rKey)">
                @r.Item2
            </button>
        }
    </div>
    <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary"
               StartIcon="@Icons.Material.Filled.UploadFile"
               OnClick="OpenImportDialogAsync">CSV importieren</MudButton>
</PageToolbar>

@if (_loading)
{
    <MudProgressLinear Color="MudBlazor.Color.Secondary" Indeterminate="true" Class="mb-4" />
}
else
{
    <!-- ── KPI strip ── -->
    <div class="fo-kpi-grid" >
        <div class="bt-kpi-mini" style="border-left:4px solid #66BB6A;">
            <div class="bt-kpi-label">Einnahmen</div>
            <div style="font-size:1.3rem; font-weight:700; color:#66BB6A; margin-top:3px;">@_totalIncome.ToString("C2", _de)</div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">@_rangeLabel</div>
        </div>
        <div class="bt-kpi-mini" style="border-left:4px solid #EF5350;">
            <div class="bt-kpi-label">Ausgaben</div>
            <div style="font-size:1.3rem; font-weight:700; color:#EF5350; margin-top:3px;">@_totalExpenses.ToString("C2", _de)</div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">@_rangeLabel</div>
        </div>
        <div class="bt-kpi-mini" style="@($"border-left:4px solid {(_netBalance >= 0 ? "#66BB6A" : "#EF5350")};")">
            <div class="bt-kpi-label">Bilanz</div>
            <div style="@($"font-size:1.3rem; font-weight:700; color:{(_netBalance >= 0 ? "#66BB6A" : "#EF5350")}; margin-top:3px;")">
                @_netBalance.ToString("C2", _de)
            </div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">@_rangeLabel</div>
        </div>
        <div class="bt-kpi-mini" style="border-left:4px solid #14B8A6;">
            <div class="bt-kpi-label">Ø / Monat Ausgaben</div>
            <div style="font-size:1.3rem; font-weight:700; color:#14B8A6; margin-top:3px;">@_avgMonthly.ToString("C2", _de)</div>
            <div style="font-size:0.72rem; color:#A3A3A3; margin-top:2px;">Aktive Monate: @_activeMonths</div>
        </div>
    </div>

    <!-- ── Row 1: Einnahmen vs Ausgaben Bar chart + Cashflow Line ── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="7">
            <div class="fo-card">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:12px;">
                    Einnahmen vs. Ausgaben – Monatsverlauf
                </div>
                @if (_monthlyBars.Any())
                {
                    <ApexChart TItem="MonthlyBar" Options="_barOpts" Height="240">
                        <ApexPointSeries TItem="MonthlyBar" Items="_monthlyBars" Name="Einnahmen"
                                         SeriesType="@ApexCharts.SeriesType.Bar"
                                         XValue="e => e.Label" YValue="e => e.Income" Color="#66BB6A" />
                        <ApexPointSeries TItem="MonthlyBar" Items="_monthlyBars" Name="Ausgaben"
                                         SeriesType="@ApexCharts.SeriesType.Bar"
                                         XValue="e => e.Label" YValue="e => e.Expenses" Color="#EF5350" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:60px 0; color:#A3A3A3; font-style:italic;">Keine Daten im gewählten Zeitraum</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="5">
            <div class="fo-card" style="height:100%;">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:12px;">
                    Ausgaben nach Kategorie
                </div>
                @if (_categoryDonut.Any())
                {
                    <ApexChart TItem="CatSlice" Options="_donutOpts" Height="240">
                        <ApexPointSeries TItem="CatSlice" Items="_categoryDonut" Name="Ausgaben"
                                         SeriesType="@ApexCharts.SeriesType.Donut"
                                         XValue="e => e.Name" YValue="e => e.Amount"
                                         PointColor="e => e.Color" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:60px 0; color:#A3A3A3; font-style:italic;">Keine kategorisierten Ausgaben</div>
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Row 2: Cashflow area chart + Einnahmen Donut ── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="8">
            <div class="fo-card">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:12px;">
                    Kumulierter Cashflow
                </div>
                @if (_cashflowLine.Any())
                {
                    <ApexChart TItem="CashflowPoint" Options="_areaOpts" Height="200">
                        <ApexPointSeries TItem="CashflowPoint" Items="_cashflowLine" Name="Cashflow"
                                         SeriesType="@ApexCharts.SeriesType.Area"
                                         XValue="e => e.Label" YValue="e => e.Value" Color="#14B8A6" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:40px 0; color:#A3A3A3; font-style:italic;">Keine Daten</div>
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="4">
            <div class="fo-card" style="height:100%;">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:12px;">
                    Einnahmen nach Kategorie
                </div>
                @if (_incomeDonut.Any())
                {
                    <ApexChart TItem="CatSlice" Options="_donutOptsGreen" Height="200">
                        <ApexPointSeries TItem="CatSlice" Items="_incomeDonut" Name="Einnahmen"
                                         SeriesType="@ApexCharts.SeriesType.Donut"
                                         XValue="e => e.Name" YValue="e => e.Amount"
                                         PointColor="e => e.Color" />
                    </ApexChart>
                }
                else
                {
                    <div style="text-align:center; padding:40px 0; color:#A3A3A3; font-style:italic;">Keine Einnahmen kategorisiert</div>
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Row 3: Top Ausgaben-Kategorien bars + Top Händler ── -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="6">
            <div class="fo-card">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:14px;">
                    Ausgaben-Kategorien Ranking
                </div>
                @if (!_categoryDonut.Any())
                {
                    <div class="ba-hint-italic">Keine Daten</div>
                }
                else
                {
                    var maxCat = _categoryDonut.Max(c => c.Amount);
                    @foreach (var cat in _categoryDonut)
                    {
                        var pct = maxCat > 0 ? (double)cat.Amount / (double)maxCat * 100.0 : 0;
                        var share = _totalExpenses > 0 ? (double)cat.Amount / (double)_totalExpenses * 100.0 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
                                <div style="display:flex; align-items:center; gap:7px;">
                                    <span style="width:9px; height:9px; border-radius:50%; background:@cat.Color; display:inline-block; flex-shrink:0;"></span>
                                    <span style="font-size:0.85rem; color:#F5F5F5;">@cat.Name</span>
                                    <span style="font-size:0.7rem; color:#A3A3A3;">@share.ToString("F0")%</span>
                                </div>
                                <span style="font-size:0.85rem; font-weight:600; color:#EF5350;">@cat.Amount.ToString("C2", _de)</span>
                            </div>
                            <div class="fo-bar-track">
                                <div class="fo-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:@cat.Color;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <div class="fo-card">
                <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:14px;">
                    Top Zahlungsempfänger
                </div>
                @if (!_topRecipients.Any())
                {
                    <div class="ba-hint-italic">Keine Daten</div>
                }
                else
                {
                    var maxR = _topRecipients.Max(r => r.Total);
                    @foreach (var r in _topRecipients)
                    {
                        var pct = maxR > 0 ? (double)r.Total / (double)maxR * 100.0 : 0;
                        <div style="margin-bottom:10px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2px;">
                                <div style="min-width:0; flex:1;">
                                    <span style="font-size:0.85rem; color:#F5F5F5; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px; display:block;">@r.Name</span>
                                    <span style="font-size:0.7rem; color:#A3A3A3;">@r.Count× Buchungen</span>
                                </div>
                                <span style="font-size:0.85rem; font-weight:600; color:#EF5350; margin-left:12px; white-space:nowrap;">@r.Total.ToString("C2", _de)</span>
                            </div>
                            <div class="fo-bar-track">
                                <div class="fo-bar-fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:#EF5350;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudItem>
    </MudGrid>

    <!-- ── Row 4: Monthly sparkline table ── -->
    <div class="fo-card">
        <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:#A3A3A3; margin-bottom:14px;">
            Monatsübersicht
        </div>
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="color:#A3A3A3; font-weight:600;">
                        <th style="padding:8px 12px; text-align:left;">Monat</th>
                        <th style="padding:8px 12px; text-align:right; color:#66BB6A;">Einnahmen</th>
                        <th style="padding:8px 12px; text-align:right; color:#EF5350;">Ausgaben</th>
                        <th style="padding:8px 12px; text-align:right;">Bilanz</th>
                        <th style="padding:8px 12px; text-align:right;">Sparpotenzial</th>
                        <th style="padding:8px 12px; min-width:100px; text-align:left;">Verlauf</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var maxME = _monthlyBars.Any() ? _monthlyBars.Max(m => m.Expenses) : 1m; }
                    @foreach (var m in _monthlyBars)
                    {
                        var bal   = m.Income - m.Expenses;
                        var balC  = bal >= 0 ? "#66BB6A" : "#EF5350";
                        var savePct = m.Income > 0 ? (double)bal / (double)m.Income * 100.0 : 0.0;
                        var barPct  = maxME > 0 ? (double)m.Expenses / (double)maxME * 100.0 : 0.0;
                        <tr style="border-bottom:1px solid #1e1e1e;">
                            <td style="padding:8px 12px; color:#F5F5F5; white-space:nowrap;">@m.Label</td>
                            <td style="padding:8px 12px; text-align:right; color:#66BB6A; font-weight:600;">@m.Income.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; color:#EF5350; font-weight:600;">@m.Expenses.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; font-weight:700; color:@balC; white-space:nowrap;">@bal.ToString("C2", _de)</td>
                            <td style="padding:8px 12px; text-align:right; color:@(savePct >= 0 ? "#66BB6A" : "#EF5350"); white-space:nowrap;">
                                @savePct.ToString("F0")%
                            </td>
                            <td style="padding:8px 12px;">
                                <div class="fo-bar-track" style="height:6px;">
                                    <div class="fo-bar-fill" style="width:@barPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:#EF5350;"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _de =
        System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private bool _loading = true;
    private string _range = "6M";
    private string _rangeLabel = "letzte 6 Monate";
    private int _activeMonths;

    private decimal _totalIncome, _totalExpenses, _netBalance, _avgMonthly;

    // Chart data
    private List<MonthlyBar>    _monthlyBars    = new();
    private List<CatSlice>      _categoryDonut  = new();
    private List<CatSlice>      _incomeDonut    = new();
    private List<CashflowPoint> _cashflowLine   = new();
    private List<RecipientRow>  _topRecipients  = new();

    // Data classes
    public class MonthlyBar    { public string Label { get; set; } = ""; public decimal Income { get; set; } public decimal Expenses { get; set; } }
    public class CatSlice      { public string Name { get; set; } = ""; public decimal Amount { get; set; } public string Color { get; set; } = "#9E9E9E"; }
    public class CashflowPoint { public string Label { get; set; } = ""; public decimal Value { get; set; } }
    public record RecipientRow(string Name, int Count, decimal Total);

    // ── Chart options ───────────────────────────────────────────────────────

    private ApexChartOptions<MonthlyBar> _barOpts = new()
    {
        Chart = new Chart { Type = ApexCharts.ChartType.Bar, Background = "transparent", ForeColor = "#A3A3A3", Toolbar = new Toolbar { Show = false } },
        Theme = new Theme { Mode = ApexCharts.Mode.Dark },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { ColumnWidth = "60%", BorderRadius = 4 } },
        Xaxis = new XAxis { Labels = new XAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } },
        Yaxis = new List<YAxis> { new() { Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } } },
        Grid  = new Grid { BorderColor = "#404040" },
        Legend = new Legend { Position = LegendPosition.Bottom, Labels = new LegendLabels { Colors = "#A3A3A3" } }
    };

    private ApexChartOptions<CatSlice> _donutOpts = new()
    {
        Chart = new Chart { Type = ApexCharts.ChartType.Donut, Background = "transparent", ForeColor = "#A3A3A3" },
        Theme = new Theme { Mode = ApexCharts.Mode.Dark },
        Legend = new Legend { Position = LegendPosition.Bottom, Labels = new LegendLabels { Colors = "#A3A3A3" } },
        PlotOptions = new PlotOptions { Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "62%" } } }
    };

    private ApexChartOptions<CatSlice> _donutOptsGreen = new()
    {
        Chart = new Chart { Type = ApexCharts.ChartType.Donut, Background = "transparent", ForeColor = "#A3A3A3" },
        Theme = new Theme { Mode = ApexCharts.Mode.Dark },
        Legend = new Legend { Position = LegendPosition.Bottom, Labels = new LegendLabels { Colors = "#A3A3A3" } },
        PlotOptions = new PlotOptions { Pie = new PlotOptionsPie { Donut = new PlotOptionsDonut { Size = "62%" } } }
    };

    private ApexChartOptions<CashflowPoint> _areaOpts = new()
    {
        Chart = new Chart { Type = ApexCharts.ChartType.Area, Background = "transparent", ForeColor = "#A3A3A3", Toolbar = new Toolbar { Show = false } },
        Theme = new Theme { Mode = ApexCharts.Mode.Dark },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        Fill = new Fill { Type = FillType.Gradient, Gradient = new FillGradient { ShadeIntensity = 0.5, OpacityFrom = 0.4, OpacityTo = 0.05 } },
        Xaxis = new XAxis { Labels = new XAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } },
        Yaxis = new List<YAxis> { new() { Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#A3A3A3" } } } },
        Grid  = new Grid { BorderColor = "#404040" },
        Legend = new Legend { Show = false }
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        AppState.OnAccountChanged     += OnStateChanged;
        AppState.OnTransactionChanged += OnStateChanged;
        await LoadAsync();
    }

    private async void OnStateChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetRangeAsync(string range)
    {
        _range = range;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var (from, to) = GetDateRange();
        _rangeLabel = _range switch
        {
            "3M"  => "letzte 3 Monate",
            "6M"  => "letzte 6 Monate",
            "1J"  => "letztes Jahr",
            _     => "gesamt"
        };

        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.Transactions.Include(t => t.Category).AsQueryable();
        if (from.HasValue) q = q.Where(t => t.Date >= from.Value);
        if (to.HasValue)   q = q.Where(t => t.Date < to.Value);
        if (AppState.SelectedAccountId.HasValue)
            q = q.Where(t => t.AccountId == AppState.SelectedAccountId.Value);

        var txList = await q.OrderBy(t => t.Date).ToListAsync();

        var expenses = txList.Where(t => t.Type == TransactionType.Expense).ToList();
        var incomes  = txList.Where(t => t.Type == TransactionType.Income).ToList();

        _totalIncome   = incomes.Sum(t => t.Amount);
        _totalExpenses = expenses.Sum(t => t.Amount);
        _netBalance    = _totalIncome - _totalExpenses;
        _activeMonths  = txList.Select(t => new { t.Date.Year, t.Date.Month }).Distinct().Count();
        _avgMonthly    = _activeMonths > 0 ? _totalExpenses / _activeMonths : 0;

        // ── Monthly bars ──────────────────────────────────────────────────
        _monthlyBars = txList
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
            .Select(g => new MonthlyBar
            {
                Label    = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yy", _de),
                Income   = g.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount),
                Expenses = g.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount)
            })
            .ToList();

        // ── Category donuts ───────────────────────────────────────────────
        _categoryDonut = expenses
            .GroupBy(t => new { Name = t.Category?.Name ?? "Ohne Kategorie", Color = t.Category?.ColorHex ?? "#A3A3A3" })
            .Select(g => new CatSlice { Name = g.Key.Name, Amount = g.Sum(t => t.Amount), Color = g.Key.Color })
            .OrderByDescending(c => c.Amount)
            .ToList();

        // Assign distinct fallback colours for "Ohne Kategorie" rows sharing same colour
        var palette = new[] { "#EF5350","#FF7043","#FFA726","#FFEE58","#66BB6A","#26C6DA","#14B8A6","#7E57C2","#EC407A","#78909C" };
        for (int i = 0; i < _categoryDonut.Count; i++)
            if (_categoryDonut[i].Color == "#A3A3A3") _categoryDonut[i].Color = palette[i % palette.Length];

        _incomeDonut = incomes
            .GroupBy(t => new { Name = t.Category?.Name ?? "Nicht kategorisiert", Color = t.Category?.ColorHex ?? "#A3A3A3" })
            .Select(g => new CatSlice { Name = g.Key.Name, Amount = g.Sum(t => t.Amount), Color = g.Key.Color })
            .OrderByDescending(c => c.Amount)
            .ToList();
        for (int i = 0; i < _incomeDonut.Count; i++)
            if (_incomeDonut[i].Color == "#A3A3A3") _incomeDonut[i].Color = palette[i % palette.Length];

        // ── Cashflow (cumulative monthly net) ─────────────────────────────
        decimal runningNet = 0m;
        _cashflowLine = _monthlyBars
            .Select(m =>
            {
                runningNet += m.Income - m.Expenses;
                return new CashflowPoint { Label = m.Label, Value = runningNet };
            })
            .ToList();

        // ── Top recipients ────────────────────────────────────────────────
        _topRecipients = expenses
            .Where(t => !string.IsNullOrWhiteSpace(t.Note))
            .GroupBy(t => NormCP(t.Note!))
            .Where(g => g.Key.Length > 3)
            .Select(g => new RecipientRow(g.Key, g.Count(), g.Sum(t => t.Amount)))
            .OrderByDescending(r => r.Total)
            .Take(12)
            .ToList();

        _loading = false;
    }

    private (DateTime? From, DateTime? To) GetDateRange()
    {
        var today = DateTime.Today;
        return _range switch
        {
            "3M"  => (today.AddMonths(-3), null),
            "6M"  => (today.AddMonths(-6), null),
            "1J"  => (today.AddYears(-1),  null),
            _     => (null, null)
        };
    }

    private async Task OpenImportDialogAsync()
    {
        var dlg = await DialogService.ShowAsync<CamtImportDialog>(
            "Kontoauszug importieren",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (!(await dlg.Result)!.Canceled)
            await LoadAsync();
    }

    private static string NormCP(string note)
    {
        var first = note.Split('|')[0].Trim().ToUpperInvariant();
        return first.Length > 30 ? first[..30].TrimEnd() : first;
    }
}
