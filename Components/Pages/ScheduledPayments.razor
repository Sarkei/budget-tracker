@page "/scheduled"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AppStateService AppState
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Geplante Zahlungen – Budget Tracker</PageTitle>

<PageToolbar Title="Geplante Zahlungen">
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@AddPaymentAsync">Hinzufügen</MudButton>
</PageToolbar>

@if (_loading)
{
    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
}

<div class="bt-kpi-grid-4" style="grid-template-columns: repeat(2, 1fr);">
    <div class="bt-kpi-mini bt-kpi-mini--error">
        <div class="bt-kpi-label">Gesamt ausstehend</div>
        <div class="bt-kpi-value bt-kpi-accent-error" style="font-size:1.25rem;">@Math.Abs(_totalUpcoming).ToString("C2", _de)</div>
    </div>
    <div class="bt-kpi-mini bt-kpi-mini--warning">
        <div class="bt-kpi-label">Nächste 30 Tage</div>
        <div class="bt-kpi-value bt-text-warning" style="font-size:1.25rem;">@Math.Abs(_totalNext30Days).ToString("C2", _de)</div>
    </div>
</div>

<MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--brand">Ausstehend</MudText>
<div class="bt-panel mb-6">
    @if (!_upcomingPayments.Any())
    {
        <MudText Class="bt-pad-muted-italic">Keine ausstehenden Zahlungen</MudText>
    }
    else
    {
        <MudList T="ScheduledPayment" Dense="true" DisablePadding="true">
            @foreach (var p in _upcomingPayments)
            {
                var daysLeft = (p.DueDate - DateTime.Today).Days;
                var urgentClass = UiClasses.UrgentText(daysLeft);
                <MudListItem T="ScheduledPayment">
                    <div class="sp-row">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small"
                                 Class="@("bt-icon-urgent " + urgentClass)" />
                        <div class="sp-info">
                            <MudText Typo="Typo.body2" Class="bt-truncate">@p.Name</MudText>
                            <MudText Typo="Typo.caption" Class="@urgentClass">
                                @p.DueDate.ToString("dd.MM.yyyy")@UiClasses.DaysLeftSuffix(daysLeft) · @CategoryLabel(p)
                            </MudText>
                        </div>
                        <div class="sp-actions">
                            <MudText Typo="Typo.body2" Class="bt-text-error" Style="font-weight:600; margin-right:6px;">
                                @p.Amount.ToString("C2", _de)
                            </MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                           Title="Als bezahlt markieren" OnClick="@(() => MarkPaidAsync(p))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Secondary"
                                           OnClick="@(() => EditPaymentAsync(p))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeletePaymentAsync(p))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

<MudText Typo="Typo.subtitle1" Class="bt-section-heading bt-section-heading--muted">Bezahlt (letzte 20)</MudText>
<div class="bt-panel bt-panel--dim">
    @if (!_paidPayments.Any())
    {
        <MudText Class="bt-pad-muted-italic">Noch keine bezahlten Zahlungen</MudText>
    }
    else
    {
        <MudList T="ScheduledPayment" Dense="true" DisablePadding="true">
            @foreach (var p in _paidPayments)
            {
                <MudListItem T="ScheduledPayment">
                    <div class="bt-list-row">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                 Class="bt-text-success bt-icon-urgent" />
                        <div class="bt-list-row-main">
                            <MudText Typo="Typo.body2">@p.Name</MudText>
                            <MudText Typo="Typo.caption" Class="bt-text-muted">
                                Fällig: @p.DueDate.ToString("dd.MM.yyyy") · Bezahlt: @(p.PaidAt?.ToString("dd.MM.yyyy") ?? "-")
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="bt-text-success bt-amount-end">
                            @p.Amount.ToString("C2", _de)
                        </MudText>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
