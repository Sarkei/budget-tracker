@page
@model BudgetTracker.Pages.ForgotModel
@{
    Layout = null;
    ViewData["Title"] = "Passwort zurücksetzen – Budget Tracker";
}
<!DOCTYPE html>
<html lang="de" class="bt-auth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/auth.css" />
    <script>
        (function () {
            var theme = 'dark';
            try { theme = localStorage.getItem('bt-theme') || 'dark'; } catch (e) { }
            if (theme === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); document.documentElement.classList.add('dark'); }
            else { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
</head>
<body>
    <div class="bt-auth-card bt-auth-card--narrow">
                <div class="bt-auth-logo">
            <span class="app-brand__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
                    <path d="M3 20h18" />
                    <rect x="5" y="12" width="4" height="6" rx="1" />
                    <rect x="10" y="8" width="4" height="10" rx="1" />
                    <rect x="15" y="4" width="4" height="14" rx="1" />
                </svg>
            </span>
            <span class="bt-auth-logo__text">Budget Tracker<span class="bt-auth-logo__sub">Finanzen</span></span>
        </div>
        <h1 class="bt-auth-title">Passwort zurücksetzen</h1>
        <p class="bt-auth-subtitle">Gib deine E-Mail-Adresse ein – wir schicken dir einen Link.</p>

        @if (Model.Sent)
        {
            <div class="bt-auth-hint">
                Wenn zu dieser Adresse ein Konto existiert, ist die Mail unterwegs. Der Link gilt eine Stunde.
            </div>
            <p class="bt-auth-link" style="margin-top:1.5rem"><a href="/login">Zurück zur Anmeldung</a></p>
        }
        else
        {
            <form method="post" class="bt-auth">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="bt-auth-error">@Model.ErrorMessage</div>
                }
                <label for="email">E-Mail-Adresse</label>
                <input id="email" name="email" type="email" autocomplete="email" autofocus value="@Model.Email" required />
                <button type="submit" class="bt-auth-btn">Link anfordern</button>
            </form>
            <p class="bt-auth-link">Doch wieder eingefallen? <a href="/login">Anmelden</a></p>
        }
    </div>
</body>
</html>
