@page
@model BudgetTracker.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Anmelden – Budget Tracker";
}
<!DOCTYPE html>
<html lang="de" class="bt-auth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/auth.css" />
    <script>
        (function () {
            var theme = 'dark';
            try { theme = localStorage.getItem('bt-theme') || 'dark'; } catch (e) { }
            if (theme === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); document.documentElement.classList.add('dark'); }
            else { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
</head>
<body>
    @*
        Aufbau wie alle eigenen Apps (knowledge/design-system):
        - Kopfzeile mit runder Marke, Name in Serif, Bereich klein darunter
        - Inhalt auf dem zweiten Grauton, Karte darauf
        - Fußleiste einzeilig, flach

        Vorher war die Seite nur eine schwebende Karte ohne Kopfzeile — sie sah
        aus wie ein fremder Teil der App.
    *@
    <div class="auth-shell">
        <header class="auth-header">
            <div class="auth-header__inner">
                <div class="app-brand">
                    <span class="app-brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                            <rect x="4" y="13" width="3.4" height="7" rx="1" />
                            <rect x="10.3" y="9" width="3.4" height="11" rx="1" />
                            <rect x="16.6" y="5" width="3.4" height="15" rx="1" />
                            <rect x="3.2" y="21" width="17.6" height="1.5" rx="0.75" />
                        </svg>
                    </span>
                    <span class="app-brand__text">
                        Budget Tracker
                        <span class="app-brand__sub">Finanzen</span>
                    </span>
                </div>

                <div class="auth-header__actions">
                    <button type="button" class="auth-theme" id="themeUmschalter"
                            title="Helles Design" aria-label="Design umschalten">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" width="18" height="18" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <main class="auth-main">
            <div class="auth-card">
                <p class="auth-card__eyebrow">Anmeldung</p>
                <h1 class="auth-card__title">Willkommen zurück</h1>
                <p class="auth-card__sub">Bitte melde dich an, um fortzufahren.</p>

                <form method="post" class="auth-form">
                    @Html.AntiForgeryToken()

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="auth-error" role="alert">@Model.ErrorMessage</div>
                    }

                    <label for="email">E-Mail-Adresse</label>
                    <input id="email" name="email" type="email" autocomplete="email" autofocus
                           value="@Model.Email" required />

                    <label for="password">Passwort</label>
                    <input id="password" name="password" type="password" autocomplete="current-password" required />

                    <button type="submit" class="auth-btn">Anmelden</button>
                </form>

                <div class="auth-links">
                    <a href="/forgot">Passwort vergessen?</a>
                    <span class="auth-links__trenner" aria-hidden="true">·</span>
                    <a href="/register">Konto erstellen</a>
                </div>
            </div>
        </main>

        <footer class="auth-footer">
            <div class="auth-footer__inner">
                <span>Selbst gehostet — deine Daten bleiben bei dir.</span>
                <span>Budget Tracker</span>
            </div>
        </footer>
    </div>

    <script>
        (function () {
            var btn = document.getElementById('themeUmschalter');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var dunkel = document.documentElement.getAttribute('data-theme') !== 'dark';
                document.documentElement.setAttribute('data-theme', dunkel ? 'dark' : 'light');
                document.documentElement.classList.toggle('dark', dunkel);
                try { localStorage.setItem('bt-theme', dunkel ? 'dark' : 'light'); } catch (e) { }
            });
        })();
    </script>
</body>
</html>
